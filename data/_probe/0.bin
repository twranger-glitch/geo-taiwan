":"林園區","landNo":"龔林段","landSerialNo":"1082","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":56,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1083","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":57,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1084","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":58,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1085","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":59,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1086","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":60,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1087","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":61,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1088","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":62,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1089","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":63,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1090","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":64,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1091","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":65,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1092","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":66,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1093","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":67,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1094","landownership":"公私有","cityLandUseType":"保存區"},{"itemNo":68,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1095","landownership":"公私有","cityLandUseType":"保存區"},{"itemNo":69,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1096","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":70,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1097","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":71,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1098","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":72,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1099","landownership":"公私有","cityLandUseType":"保存區"},{"itemNo":73,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1100","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":74,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1101","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":75,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1102","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":76,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1105","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":77,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1106","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":78,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1107","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":79,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1108","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":80,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1109","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":81,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1110","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":82,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1111","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":83,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1112","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":84,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1113","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":85,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1114","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":86,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1115","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":87,"cityName":"高雄市","distName":"林園區","landNo":"柚子腳段","landSerialNo":"1","landownership":"公有","cityLandUseType":"保存區"}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20060501000005","mediaImageList":[{"mediaName":"3513512354(2)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39436/photo/3513512354(2).JPG"},{"mediaName":"3513512354(3)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39437/photo/3513512354(3).JPG"},{"mediaName":"3513512354(4)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39438/photo/3513512354(4).JPG"}],"documents":["https://data.boch.gov.tw/upload/documents/2021-03-29/18044405-f8b0-478d-a219-669b6c26a907/950501行政院文化建設委員會公告.pdf","https://data.boch.gov.tw/upload/documents/2021-03-29/d1378c8f-1fec-4af5-82fc-8477295b486e/1061117文化部公告-重新公告類別名稱.pdf","https://data.boch.gov.tw/upload/documents/2021-08-31/70a9a83e-bfce-4feb-a9b6-2f9743eba2c2/公告用印後PDF(鳳鼻頭地號調整).pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"中華民國"},{"ownerType":"土地所有人","ownerName":"中華民國"},{"ownerType":"土地所有人","ownerName":"中華民國"},{"ownerType":"土地所有人","ownerName":"李OOOOO"},{"ownerType":"土地所有人","ownerName":"李OOOOO"},{"ownerType":"土地所有人","ownerName":"李OOOOO"},{"ownerType":"土地所有人","ownerName":"中華民國"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"李OO"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"如OOOOOOO"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"林OO"},{"ownerType":"土地所有人","ownerName":"林OO"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"林OO"},{"ownerType":"土地所有人","ownerName":"林OO"},{"ownerType":"土地所有人","ownerName":"李OOOOO"},{"ownerType":"土地所有人","ownerName":"元OOOOOOO"},{"ownerType":"土地所有人","ownerName":"李OOOOO"},{"ownerType":"土地所有人","ownerName":"李OOOOO"},{"ownerType":"土地所有人","ownerName":"林OO"},{"ownerType":"土地所有人","ownerName":"林OOOOOOOOOOOOO"},{"ownerType":"土地所有人","ownerName":"立OOOOOOOOO"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"龔OO"},{"ownerType":"土地所有人","ownerName":"林OO"},{"ownerType":"土地所有人","ownerName":"立OOOOOOOOO"},{"ownerType":"土地所有人","ownerName":"立OOOOOOOOO"},{"ownerType":"土地所有人","ownerName":"林OO"},{"ownerType":"土地所有人","ownerName":"林OO"},{"ownerType":"土地所有人","ownerName":"林OO"},{"ownerType":"土地所有人","ownerName":"黃OOO"},{"ownerType":"土地所有人","ownerName":"徐OOOOOO"},{"ownerType":"土地所有人","ownerName":"黃OO"},{"ownerType":"土地所有人","ownerName":"林OOOOO"},{"ownerType":"土地所有人","ownerName":"黃OO"},{"ownerType":"土地所有人","ownerName":"黃OO"},{"ownerType":"土地所有人","ownerName":"黃OO"},{"ownerType":"土地所有人","ownerName":"龔OOOOO"},{"ownerType":"土地所有人","ownerName":"林OO"},{"ownerType":"土地所有人","ownerName":"龔OOOOO"},{"ownerType":"土地所有人","ownerName":"黃OO"},{"ownerType":"土地所有人","ownerName":"立OOOOOOOOO"},{"ownerType":"土地所有人","ownerName":"立OOOOOOOOO"},{"ownerType":"土地所有人","ownerName":"黃OO"},{"ownerType":"土地所有人","ownerName":"立OOOOOOOOO"},{"ownerType":"土地所有人","ownerName":"黃OOOOO"},{"ownerType":"土地所有人","ownerName":"立OOOOOOOOO"},{"ownerType":"土地所有人","ownerName":"立OOOOOOOOO"},{"ownerType":"土地所有人","ownerName":"立OOOOOOOOO"},{"ownerType":"土地所有人","ownerName":"立OOOOOOOOO"},{"ownerType":"土地所有人","ownerName":"黃OOOOO"},{"ownerType":"土地所有人","ownerName":"黃OOOOO"},{"ownerType":"土地所有人","ownerName":"中華民國等"},{"ownerType":"土地所有人","ownerName":"中華民國等"},{"ownerType":"土地所有人","ownerName":"黃OOOOO"},{"ownerType":"土地所有人","ownerName":"黃OOOOO"},{"ownerType":"土地所有人","ownerName":"黃OOOOO"},{"ownerType":"土地所有人","ownerName":"中華民國等"},{"ownerType":"土地所有人","ownerName":"黃OOOOO"},{"ownerType":"土地所有人","ownerName":"黃OO"},{"ownerType":"土地所有人","ownerName":"林OOOOO"},{"ownerType":"土地所有人","ownerName":"盧OO"},{"ownerType":"土地所有人","ownerName":"林OOOOO"},{"ownerType":"土地所有人","ownerName":"林OOOOO"},{"ownerType":"土地所有人","ownerName":"林OOOOO"},{"ownerType":"土地所有人","ownerName":"林OOOOO"},{"ownerType":"土地所有人","ownerName":"林OOOOO"},{"ownerType":"土地所有人","ownerName":"黃OOOOO"},{"ownerType":"土地所有人","ownerName":"林OOOOO"},{"ownerType":"土地所有人","ownerName":"林OOOOO"},{"ownerType":"土地所有人","ownerName":"林OOOOO"},{"ownerType":"土地所有人","ownerName":"林OOOOO"},{"ownerType":"土地所有人","ownerName":"高雄市"}],"govInstitution":"文化部文化資產局","govDeptName":"古物遺址組遺址科","govDeptAddress":"台中市南區復興路三段362號","govDeptPhone":"(04)22177632","repImgId":4562},{"caseId":"20080822000001","caseName":"萬山岩雕群考古遺址","assetsClassifyCode":"2.1.1","assetsClassifyName":"國定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性","具其他遺址價值者"],"registerReason":"1.遺址在文化發展脈絡中之定位及意義性：萬山岩雕圖案母題具有族群文化發展的高度價值，同時具有高度敘事的意涵。岩雕母題有具體構圖，非為雜亂無章即興之作；族群社會利用圖案母題表現故事，顯示該社會已有高度發展：萬山岩雕群遺址在文化人類學、建築學以及相關臺灣南島語族研究上有重要意涵。\r\n2.遺址在學術研究史上意義性：此一地點為國內唯一之大型雕刻遺址；自1970年代被學術界研究以來，歷經民族學、人類學、藝術學等不同學科之研究，已具有學術研究之初步價值，開創我國岩雕研究之領域。\r\n3.遺址文化堆積內涵之特殊性及豐富性：岩雕就考古學來講，岩雕之技法、母題及其相關之組成，均具有豐富的意涵。\r\n4.同類型遺址數量之稀有性：萬山岩雕群遺址具有數量上的唯一性。\r\n5.遺址保存狀況之完整性：除部份岩雕本體受自然風化及人為損害外，岩雕本體及周圍環境，仍具完整性。\r\n6.遺址供展示教育規劃之適當性：岩雕具有獨特性且深受國人矚目，有其特殊性之展示教育意義和潛力。\r\n7.具其他遺址價值者：為臺灣唯一的岩雕群，但在中國大陸及太平洋地區都有類同之文化體系；未來，萬山岩雕群遺址有其跨國研究之意義，並可能與南島語族之起源研究有關。","lawsReference":"文化資產保存法第40條、遺址指定及廢止審查辦法第3、5條","govInstitutionName":"文化部","addresses":[{"itemNo":1,"cityName":"高雄市","distName":"茂林區","address":"萬頭蘭山區"}],"longitude":120.785719,"latitude":22.956189,"relativePosition":"","neighborPosition":"","representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39439/photo/131578(1)_c.jpg"},"original":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39439/photo/131578(1).jpg","name":"131578(1)"},"representImageSource":"高雄市政府文化局","landScope":"高雄市茂林區達克車段18號、28地號及高雄市茂林區沙古吾段13號、25地號。\n一、遺址及所定著土地之範圍：\n(一)遺址：孤巴察峨(1號岩雕)、祖布里里(2號岩雕)、莎娜奇勒娥(3號岩雕)、大軋拉烏(4號岩雕)等四處遺址。\n(二)範圍涵蓋：四座岩雕群及週邊生活領域(各座岩雕單獨位置，以具體衛星定位位置表示)。\n二、遺址指定範圍：\n1.孤巴察峨(1號岩雕)：面對岩雕本體左邊的崩塌地到右邊的溪谷，往上到崩塌地與溪谷連成的稜線頂點，為一處近乎三角形的塊狀區域。\n2.祖布里里(2號岩雕)：岩雕本體所在之河階地及滑走坡坡面頂端之塊狀區域為指定範圍(垂直峭壁以下至崖邊)。\n3.莎娜奇勒娥(3號)岩雕：第二級河階往上至稜線為指定範圍。\n4.大軋拉烏岩雕群(4號岩雕)：岩雕本體在濁口溪上游南側河階地上，北邊鄰河谷側到崩壁、峭壁、懸崖邊為止；南邊鄰山坡側到河階地邊緣為止：西側及東側以最外圍的岩體位置再向外推出50公尺為止(十處岩雕位置位於直徑250公尺之範圍內)。","nearbyArcheologyCheck":"位於或鄰近普查遺址","nearbyArcheologyBrief":"鄰近無普查遺址","cultralMean":"萬山岩雕為原住民原始藝術遺跡，發現者高業榮依照露天石刻早於原住民石板屋內木雕，參酌刻紋、圖騰風格變遷，推估岩雕約有500年到1600年歷史。","pastHistory":"1.民國六十七年，當時在屏東師專任教的高業榮老師，於今高雄市濁口溪上游北岸，發現台灣第一、二座岩雕遺跡，高老師依照當地原住民賦予的地名，取名為「孤巴察峨」，「祖布里里」;七十三年又發現第三處岩雕，命名為「莎娜奇勒娥」，民國七十八年，內政部將「孤巴察峨」、「祖布里里」、「莎娜奇勒娥」三處岩雕，指定公告為第三級古蹟「萬山岩雕」。\n2.民國九十一年底，高業榮老師在魯凱族原住民的帶領下又發現了第四處岩雕(命名為：大軋拉烏)，高雄縣政府文化局於九十三年三月底前往勘查「大軋拉烏」時，於大軋拉烏西側三十公尺處發現一處疑似岩雕刻痕；同年四月間，三立電視公司前往萬山岩雕拍攝，又於大軋拉烏西側再發現數處疑似岩雕的刻痕。95年2月研究團隊再度於「大軋拉烏」附近發現刻有紋路的石頭，遺址本體現計有4處共10塊岩石上有人為刻痕，萬山岩雕形成一岩雕群。\n3.97年2月17日至24日文建會會同專家學者辦理之遺址現勘，又於「祖布里里」發現一處新岩雕及「大軋拉烏」發現三處新岩雕，共計「萬山岩雕群遺址」共有4處14塊岩石(岩雕本體)。","actualStatus":"因人煙罕至，因此目前無人使用。","usageStatus":"目前無人使用。","landUsage":"遺址定著土地為非都市土地，尚未編定用地類別。","announcementList":[{"classification":"變更/修正","officialDocNo":"文授資局物字第10630129932號","registerDate":"2017-11-17 00:00:00.0","note":"重新公告類別名稱"},{"classification":"指定/登錄","officialDocNo":"文資籌二字第0972109806號","registerDate":"2008-08-22 21:03:18.0"}],"landlotList":[{"itemNo":1,"cityName":"高雄市","distName":"茂林區","landNo":"達克車段","landSerialNo":"18","landownership":"公有","noncityLandUseType":"森林區","noncityLandUseTypeOther":""},{"itemNo":2,"cityName":"高雄市","distName":"茂林區","landNo":"達克車段","landSerialNo":"28","landownership":"公有","noncityLandUseType":"森林區","noncityLandUseTypeOther":""},{"itemNo":3,"cityName":"高雄市","distName":"茂林區","landNo":"沙古吾段","landSerialNo":"13","landownership":"公有","noncityLandUseType":"森林區","noncityLandUseTypeOther":""},{"itemNo":4,"cityName":"高雄市","distName":"茂林區","landNo":"沙古吾段","landSerialNo":"25","landownership":"公有","noncityLandUseType":"森林區","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20080822000001","mediaImageList":[{"mediaName":"131578(2)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39440/photo/131578(2).JPG"},{"mediaName":"131578(3)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39441/photo/131578(3).JPG"},{"mediaName":"131578(4)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39442/photo/131578(4).JPG"},{"mediaName":"131578(5)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39443/photo/131578(5).JPG"}],"documents":["https://data.boch.gov.tw/upload/documents/2021-03-26/1a89f720-98d2-4e70-a6f2-b23314fb30db/1061117文化部公告-重新公告類別名稱.pdf","https://data.boch.gov.tw/upload/documents/2021-03-26/3d517d16-f369-42fb-97bf-3c6953aefbf6/980822公告萬山岩雕為國定遺址.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"中華民國"}],"govInstitution":"文化部文化資產局","govDeptName":"古物遺址組遺址科","govDeptAddress":"台中市南區復興路三段362號","govDeptPhone":"(04)22177632","repImgId":4563},{"caseId":"20060501000006","caseName":"卑南考古遺址","assetsClassifyCode":"2.1.1","assetsClassifyName":"國定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性","具其他遺址價值者"],"registerReason":"一、具文化發展脈絡中之定位及學術研究史上之意義：\n卑南考古遺址保存大坌坑文化、富山文化、卑南文化、三和文化等多層文化層，年代從距今5,300年持續至1,900年前，歷經臺灣新石器時代早中晚期至金屬器時代早期，提供理解史前人群在臺灣東部長期居住生活與文化發展的重要資訊。其中代表性的卑南文化層(新石器時代晚期)，為長期性大型聚落遺址，因出土大量建築結構遺跡、石板棺墓葬群與玉器等，更見證此一人群如何運用周邊資源，發展出豐碩且具特色的文化內涵的過程，是臺灣史前文化整體發展脈絡中的重要環節。\n1980年代因東線鐵路臺東新站工程破壞卑南考古遺址，引發臺灣第一次為考古遺址保護議題而興起的社會輿論，因而促使政府委請臺灣大學考古隊執行大規模的搶救發掘，出土豐富精彩的史前文物，開啟工程開發與考古文化資產保存連結的濫觴，並催生臺灣第一座考古博物館，在我國的考古學術研究史上，具有重要意義。\n\n二、具文化堆積內涵之特殊性及豐富性：\n卑南是臺灣範圍廣大、出土遺留最為豐富的考古遺址之一，計出土石板棺2,000餘具，完整及近完整陶器、石器、玉器等文物數以萬計。其中卑南文化層更保存迄今臺灣大型史前聚落遺跡之一，以及臺灣最大的石板棺墓葬群，而石板棺中出土的陪葬玉器，數量多且類型豐富，也極具特殊性。\n\n三、具同類型考古遺址數量之稀有性或保存狀況之完整性：\n卑南考古遺址的卑南文化層，所呈現的聚落規模，不只在同文化類型考古遺址中屬最大且最為完整者，所出土大量石板棺，以及數量豐富、類型精美的玉器，在所有臺灣考古遺址中亦居於首位。此外，卑南考古遺址的三和文化層，屬於三和文化初期的層位堆積，為新石器時代晚期轉變為金屬器時代的關鍵性層位，相當重要而罕見。\n卑南考古遺址經長期研究，確定地下保存面積約53公頃，以遺跡、遺物密集區域之近11.93公頃指定為國定考古遺址範圍，除受鐵路車站興建工程破壞及考古已發掘區域以外，尚保有面積廣大、保存完整的史前文化堆積層。\n\n四、具全國代表性及價值：\n卑南考古遺址出土玉器量豐質佳，代表臺灣新石器時代持續二千年精湛的玉器工藝技術器型多樣性，亦呈現史前時代環南海東側區域繁盛的玉器交易網絡。\n卑南考古遺址保存的卑南文化層、三和文化層，均為臺灣東部新石器時代晚期向金屬器時代發展的兩個關鍵性層位。其中，卑南文化層出土大量製作精美，形制繁多的玉器，為臺灣史前玉器文化發展的巔峰代表；而眾多的建築結構遺存與大規模的石板棺墓葬群，亦為全臺僅見。同時，卑南文化之典型玉器廣泛見於臺灣全島之考古遺址，甚而遠達東南亞之多處地點，展現當時繁盛之玉器交流網絡，卑南考古遺址顯然是此網絡中的核心，在學術研究上具有全國代表性之價值，同時具有供展示教育規劃之題材。","lawsReference":"文化資產保存法第102條(民國94年版)\n文化資產保存法第46條(民國105年版)、考古遺址指定及廢止審查辦法第4條、行政程序法第111條第1項規定、本部第九屆考古遺址審議會第1次會議決議","govInstitutionName":"文化部","addresses":[{"itemNo":1,"cityName":"臺東縣","distName":"臺東市","address":"石壁段"}],"longitude":121.11978,"latitude":22.79403,"relativePosition":"","neighborPosition":"","representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39446/photo/132456(1)_c.jpg"},"original":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39446/photo/132456(1).jpg","name":"132456(1)"},"representImageSource":"國立臺灣史前文化博物館提供","landScope":"臺東縣市石壁段533 地號、554 地號、639 地號、662 地號、667地號、680地號、1245 地號、660-1地號、661-1地號、668-1地號。","nearbyArcheologyCheck":"位於或鄰近列冊遺址","nearbyArcheologyBrief":"台東鯉魚山遺址","cultralMean":"1.文化層堆積厚，遺物豐富具多層文化層，是卑南文化代表遺址。\r\n2.進行過多次發掘，在考古學史上有相當重要的地位。","pastHistory":"1.68年內政部評定卑南遺址為第三級古蹟。\n2.69年鐵路局新站施工出土大量文物，自69年至77年間的經13次搶救發掘。\n3.77年7月7日內政部內民字第608610號函公告第一級古蹟一卑南遺址範圍僅指月形石柱區(地籍圖20x35.3＝706平方米)。\n4.78年縣政府土地徵收土作完竣(卑南文化公園)。\n5.79年2月 國立臺灣史前文化博物館成立。\n6.79年6月20日內政部台(79)內民宇第810960號函指定遺址區(月型石柱周圍)涵蓋範圍為1,818平方米(含遺址706平方米，合計2,524平方米)。\n7.80年9月6日內政部召開第一級古蹟『卑南遺址』涵蓋範圍審定會議，確定三個圈圈，面積約90公頃。\n8.80年10月11日內政部台(80)內民字第80了2296號函審定:卑南遺址涵蓋範圍約五十公頃。\n9.95年5月1日 文建會文資籌研字第09500017951號函公告指定『卑南遺址』為國定遺址。","actualStatus":"目前正由國立臺灣史前文化博物館依「卑南文化公園整體計畫」之遺址保存計畫逐年辦理卑南遺址第二期範圍土地徵收，第三期範圍亦正由行政院文化建設委員會補助臺東縣政府辦理遺址勘查以確認遺址範圍及內涵，以為後續卑南遺址指定範圍變更之依據。","usageStatus":"現為卑南文化公園。","landUsage":"遺址公有地設有卑南文化公園，私有地為農地。","announcementList":[{"classification":"變更/修正","officialDocNo":"文授資局物字第11230006961號","registerDate":"2023-01-18 10:10:52.745","note":"補充指定理由及其法令依據"},{"classification":"變更/修正","officialDocNo":"文授資局物字第10630129932號","registerDate":"2017-11-17 00:00:00.0"},{"classification":"指定/登錄","officialDocNo":"文資籌研字第 09500017951 號","registerDate":"2006-05-01 09:15:14.0"}],"landlotList":[{"itemNo":1,"cityName":"臺東縣","distName":"臺東市","landNo":"石壁段","landSerialNo":"533","landownership":"公有","noncityLandUseTypeOther":""},{"itemNo":2,"cityName":"臺東縣","distName":"臺東市","landNo":"石壁段","landSerialNo":"554","landownership":"公有","noncityLandUseTypeOther":""},{"itemNo":3,"cityName":"臺東縣","distName":"臺東市","landNo":"石壁段","landSerialNo":"639","landownership":"公有","noncityLandUseTypeOther":""},{"itemNo":4,"cityName":"臺東縣","distName":"臺東市","landNo":"石壁段","landSerialNo":"660-1","landownership":"公有","noncityLandUseTypeOther":""},{"itemNo":5,"cityName":"臺東縣","distName":"臺東市","landNo":"石壁段","landSerialNo":"661-1","landownership":"公有","noncityLandUseTypeOther":""},{"itemNo":6,"cityName":"臺東縣","distName":"臺東市","landNo":"石壁段","landSerialNo":"662","landownership":"公有","noncityLandUseTypeOther":""},{"itemNo":7,"cityName":"臺東縣","distName":"臺東市","landNo":"石壁段","landSerialNo":"667","landownership":"公有","noncityLandUseTypeOther":""},{"itemNo":8,"cityName":"臺東縣","distName":"臺東市","landNo":"石壁段","landSerialNo":"668-1","landownership":"公有","noncityLandUseTypeOther":""},{"itemNo":9,"cityName":"臺東縣","distName":"臺東市","landNo":"石壁段","landSerialNo":"680","landownership":"公有","noncityLandUseTypeOther":""},{"itemNo":10,"cityName":"臺東縣","distName":"臺東市","landNo":"石壁段","landSerialNo":"1245","landownership":"公有","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20060501000006","mediaImageList":[{"mediaName":"132456(2)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39447/photo/132456(2).jpg"},{"mediaName":"132456(3)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39448/photo/132456(3).jpg"},{"mediaName":"132456(4)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39449/photo/132456(4).jpg"}],"documents":["https://data.boch.gov.tw/upload/documents/2023-02-01/5b30f0e0-1660-45d5-a88e-949367436e7c/1120118卑南考古遺址補充指定理由.pdf","https://data.boch.gov.tw/upload/documents/2021-01-25/a41e2335-c190-4e31-87bc-9073a7b738d8/950501行政院文化建設委員會公告.pdf","https://data.boch.gov.tw/upload/documents/2021-01-25/efa7a05c-93b8-455a-873b-917c5d893c25/1061117文化部公告.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"國立臺灣史前文化博物館"}],"govInstitution":"文化部文化資產局","govDeptName":"古物遺址組遺址科","govDeptAddress":"台中市南區復興路三段362號","govDeptPhone":"(04)22177631","repImgId":4565},{"caseId":"20060414000001","caseName":"巴蘭考古遺址","assetsClassifyCode":"2.1.3","assetsClassifyName":"縣(市)定考古遺址","judgeCriteria":["遺址保存狀況之完整性","遺址供展示教育規劃之適當性"],"registerReason":"依據遺址指定及廢止審查辦法第3條符合指定基準第五項：遺址保存狀況之完整性及第六項：遺址供展示教育規劃之適當性。","lawsReference":"1.依據新修訂之文化資產保存法第111條規定。\n2.106年2月20日臺東縣106年度第1次文化資產審議委員會決議辦理。\n","govInstitutionName":"臺東縣政府","addresses":[{"itemNo":1,"cityName":"臺東縣","distName":"卑南鄉","address":"臺東縣卑南鄉初鹿村新斑鳩，海拔約600公尺的淺山地區。"}],"longitude":121.0542,"latitude":22.8494,"representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/upload/representImageFile/2021-07-20/5187e673-4835-40a1-955d-b198b234bc3d/考古遺址03_巴蘭遺址-永保_c.jpg"},"original":"https://data.boch.gov.tw/upload/representImageFile/2021-07-20/5187e673-4835-40a1-955d-b198b234bc3d/考古遺址03_巴蘭遺址-永保.jpg","name":"考古遺址03_巴蘭遺址-永保"},"representImageSource":"109-110年度臺東縣文化資產個案資料同步更新維護計畫-姜柷山提供","landScope":"卑南鄉巴蘭段6-1地號位於林務局台東林區管理處第4林班地內，卑南鄉巴蘭段6-1地號，面積8,344.97平方公尺。","nearbyArcheologyCheck":"位於或鄰近列冊遺址","nearbyArcheologyBrief":"老番社遺址","cultralMean":"為花東縱谷的巨石文化類型，距今600年至1,000之間。","pastHistory":"巴蘭遺址位於臺東縣卑南鄉初鹿村新斑鳩，海拔約600公尺的淺山地區。由出土物的碳14分析顯示，巴蘭遺址的時間大約在距今600年至1,000年之間。巴蘭遺址的考古發現，顯現與近代排灣群之間，有明顯的類緣關係。 \n巴蘭遺址的發現及保護過程中，初鹿村的卑南族人可說功不可沒。在民國88年（1999）左右，族人發現山區遺址的古物，遭宵小持續竊取和盜賣，乃主動通報及要求縣政府重視遺址之保護。當時，經過各方人士聯合會勘後，於民國90年公告巴蘭遺址為第三級古蹟，之後於民國95年依文化資產保存法修定為縣定遺址。\n巴蘭遺址是初鹿村卑南族人重要的水源地，曾經是部落進行祈雨的地方，而稱呼該地為「Palan」，是一般人禁止進入的聖地。在初鹿村卑南族人的口傳故事中，巴蘭也曾經是「矮人」住過的地方。目前現地還遺留了神祕傳說中矮人的石板屋、立石、正方形石板棺等遺跡。\n資料來源：臺東縣巴蘭遺址調查發掘研究計畫期末報告\n","actualStatus":"指定為縣定遺址，現地保護。","usageStatus":"現為林班地，經撥用後為遺址保存用地。","landUsage":"","announcementList":[{"classification":"指定/登錄","officialDocNo":"府文資字第1060092740號","registerDate":"2017-03-02 13:43:28.317","note":"依文化資產保存法第111條規定完成重新指定、登錄及公告程序"},{"classification":"指定/登錄","officialDocNo":"府文資字第 0953008669 號","registerDate":"2006-04-14 09:14:11.0"}],"landlotList":[{"itemNo":1,"cityName":"臺東縣","distName":"卑南鄉","landNo":"巴蘭段","landSerialNo":"6-1","landownership":"公有","noncityLandUseType":"森林區","noncityLandUseTypeOther":"古蹟保存用地"}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20060414000001","documents":["https://data.boch.gov.tw/upload/documents/2021-05-23/6af90f60-4630-42d6-930f-4f53746b9c72/臺東縣考古遺址公告公文-03巴蘭遺址-106年重新指定.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"中華民國"}],"govInstitution":"臺東縣政府文化處","govDeptName":"文化資產科","govDeptAddress":"臺東市南京路25號","govDeptPhone":"089-350129","repImgId":125511},{"caseId":"20060414000002","caseName":"都蘭考古遺址","assetsClassifyCode":"2.1.3","assetsClassifyName":"縣(市)定考古遺址","judgeCriteria":["遺址保存狀況之完整性","遺址供展示教育規劃之適當性"],"registerReason":"依據遺址指定及廢止審查辦法第3條符合指定基準第五項：遺址保存狀況之完整性及第六項：遺址供展示教育規劃之適當性。","lawsReference":"1.依據新修訂之文化資產保存法第111條規定。\n2.106年2月20日臺東縣106年度第1次文化資產審議委員會決議辦理。\n","govInstitutionName":"臺東縣政府","addresses":[{"itemNo":1,"cityName":"臺東縣","distName":"東河鄉","address":"位臺東縣東河鄉都蘭村，臺11線147.7公里北向西側，沿都蘭產業道路往西約1公里處，先抵「岩棺區」；再往西約300公尺則為「石壁區」。"}],"longitude":121.206111,"latitude":22.888333,"relativePosition":"東河鄉都蘭村山腰地區","neighborPosition":"台11線都蘭村落","representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/upload/representImageFile/2021-07-20/2367bb14-e211-4399-8026-b9626eee3a0d/考古遺址_02都蘭遺址 (石棺區)-永保_c.jpg"},"original":"https://data.boch.gov.tw/upload/representImageFile/2021-07-20/2367bb14-e211-4399-8026-b9626eee3a0d/考古遺址_02都蘭遺址 (石棺區)-永保.jpg","name":"考古遺址_02都蘭遺址 (石棺區)-永保"},"representImageSource":"109-110年度臺東縣文化資產個案資料同步更新維護計畫-姜柷山提供","landScope":"岩棺區：阿都蘭段547號11,550.2平方公尺。\n石壁區：藍寶段162號7,948.56平方公尺。\n(依93年土地登記謄本標示面積)\n","nearbyArcheologyBrief":"富山文化/麒麟文化","cultralMean":"都蘭考古遺址的史前文化層包括繩紋陶文化、卑南文化、麒麟文化（巨石文化）、阿美文化等。根據發掘的成果，認為都蘭考古遺址具有多樣的巨石遺留類型，且位於巨石文化圈的南緣，但透過發掘，研究者認為都蘭考古遺址除了顯著的巨石文化特徵外，另有繩紋陶與卑南文化的特徵。","pastHistory":"都蘭遺址位於臺東縣東河鄉都蘭村的淺山地區，是東海岸巨石文化的代表性遺址。在距今約3,500年前，臺東東部海岸山脈中段，出現一個特殊的文化系統，人類學家稱之為「麒麟文化」或「巨石文化」。巨石文化的特色，就是有大量經過人為雕琢過的大型巨石遺物，其中包括巨大的單石、岩棺、石壁、石輪等。巨石文化的淵源，可能與中南半島的巨石文化有關。東海岸代表性的遺址有都蘭遺址、泰源遺址、麒麟遺址、白守蓮遺址、白桑安遺址和忠勇遺址等。\n都蘭遺址的發現，源自於日治時期昭和2年（1927）鹿野忠雄的地表調查。臺灣光復後在民國42年（1953）後，中央研究院等單位也曾進行調查。目前遺址範圍可見的遺跡有岩棺區和石壁區，計有岩棺乙座、石壁三處。根據推測，岩棺和石壁的功能，可能和當地住民的祭祀或儀式有關。\n","actualStatus":"石棺區及石壁區已設置簡易遺址步道，現地保存及展示，並由社區協助整理附近環境。","usageStatus":"現為自然森林，公告遺址內保有岩棺、石壁等石器4件。","landUsage":"自然森林，遺址區已清理。","announcementList":[{"classification":"指定/登錄","officialDocNo":"府文資字第1060041351號","registerDate":"2017-03-02 13:39:49.837","note":"依文化資產保存法第111條規定完成重新指定、登錄及公告程序"},{"classification":"指定/登錄","officialDocNo":"府文資字第 0953008669 號","registerDate":"2006-04-14 09:14:52.0"}],"landlotList":[{"itemNo":1,"cityName":"臺東縣","distName":"東河鄉","landNo":"阿都蘭段","landSerialNo":"547","landownership":"公有","noncityLandUseType":"其他使用區","noncityLandUseTypeOther":"古蹟保存用地"},{"itemNo":2,"cityName":"臺東縣","distName":"東河鄉","landNo":"藍寶段","landSerialNo":"162","landownership":"公有","noncityLandUseType":"其他使用區","noncityLandUseTypeOther":"古蹟保存用地"}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20060414000002","documents":["https://data.boch.gov.tw/upload/documents/2021-05-23/0dde340a-5ee2-47a3-9ce2-967fa950925c/臺東縣考古遺址公告公文-02都蘭遺址-106年重新指定.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"財政部國有財產署"}],"govInstitution":"臺東縣政府文化處","govDeptName":"文化資產科","govDeptAddress":"臺東市南京路25號","govDeptPhone":"089-350129","repImgId":125510},{"caseId":"20060501000007","caseName":"八仙洞考古遺址","assetsClassifyCode":"2.1.1","assetsClassifyName":"國定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性"],"registerReason":"一、具文化發展脈絡中之定位及學術研究史上之意義：\n八仙洞考古遺址是臺灣大學地質系林朝棨教授於1968年發現，由臺灣大學考古人類學系宋文薰教授率領的考古隊，在1968年至1969年在此進行了考古發掘，首次發現了豐富的「長濱文化」遺留。2009年至2017年，臺東縣政府委託中央研究院歷史語言研究所臧振華教授主持八仙洞調查研究計畫，又發掘了多個洞穴、岩蔭和平臺，獲得大量文化遺物，並取得明確的舊石器時代碳-14測年，確認此處至少在3萬年前已有人類活動或居住。\n八仙洞是臺灣目前所發現最具體而完整的舊石器時代遺址，是長濱文化的命名考古遺址，代表臺灣人類到達臺灣的開端。八仙洞一帶，因地殼抬升活動，形成了海蝕洞、海蝕岩蔭，以及階梯狀海階，是獨特海岸地形。因其特殊的地質景觀及豐沛的人類歷史遺存，成為研究更新世晚期以來臺灣地區古環境變遷，以及人類與環境互動關係的重要場域，對於東南亞、東亞古代人類的文化移動與發展的研究，也具有重要的意義。\n\n二、具文化堆積內涵之特殊性及豐富性：\n八仙洞考古遺址從距今三萬年至現代，多次有人類在此生息活動，留下了多層的考古文化遺存，包括距今約30,000年到15,000年前的長濱文化，距今約6,000年到5,000年前的先陶文化，距今約4,500年到3,500年前的東部細繩紋陶文化，距今約3,500年到2,000年前之間的麒麟文化，距今約800年到200年前的鐵器時代文化（靜浦文化），以及晚近的漢人廟宇遺留，涵蓋臺灣東部海岸地區從早到晚的各個主要時代遺留。這些舊石器、先陶、新石器與鐵器時代的遺物都有清楚的地層脈絡，尤其在多處洞穴、岩蔭及平臺發現的舊石器時代的文化層，出土豐富的石器，包括礫石砍器、礫石敲砸器、礫石石片器、石砧、石英質小石器，以及大量的石器廢料，並且發現了舊石器時代的火塘和動物殘骨，對於瞭解當時人類在八仙洞之文化面貌與生活狀況提供了重要的資料。\n\n三、具同類型考古遺址數量之稀有性或保存狀況之完整性：\n八仙洞考古遺址為臺灣少見的洞穴群考古遺址，目前發現至少30處洞穴、6處岩蔭以及5處平臺。經過考古試掘與鑽探，這些洞穴、岩蔭或平臺，大都存在史前文化遺留，多數並保存原始地層堆積，這些洞穴內之人類文化遺留，特別是「舊石器時代」的文化遺留，不僅是目前臺灣極少數經發掘確認的遺址，也是亞洲最重要的保存舊石器時代文化之考古遺址一。八仙洞考古遺址不僅完整留下了三萬年以來的遠古人類生活紀錄，也是舊石器時代東亞及東南亞人類歷史發展脈絡中不可缺的一環，是國家重要的文化資產且極富社會展示教育的意義。\n\n四、具全國代表性及價值：\n舊石器時代的長濱文化，最早可達距今30,000年，是迄今在臺灣所發現最古老的史前文化遺留，代表人類來到島上活動的開端，提供臺灣考古學研究與地質學研究，是論述舊石器時代先民生活最重要的資料，及八仙洞因更新世的冰河消長及地殼運動造成間歇性抬升速率，足可作為臺灣國民教育與鄉土教育不可或缺的歷史教材。對於東南亞、琉球、東北亞及西伯利亞的舊石器時代人類遷徙的考古學研究，亦可提供年代明確，可資比較分析的資料。","lawsReference":"文化資產保存法第102條(民國94年版)\n文化資產保存法第46條、考古遺址指定及廢止審查辦法第4條、行政程序法第114條第1項規定及本部第九屆考古遺址審議會第6次會議決議。","govInstitutionName":"文化部","addresses":[{"itemNo":1,"cityName":"臺東縣","distName":"長濱鄉","address":"位樟原橋南方約500公尺，台11公路西側水母丁山山壁上的海蝕洞穴，即八仙洞風景區所在。"}],"longitude":121.477369,"latitude":23.399369,"relativePosition":"","neighborPosition":"","representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/upload/representImageFile/2019-05-31/9e0fce51-3db4-4012-81db-aad93af94b4d/P_20180329_104953_HDR_c.jpg"},"original":"https://data.boch.gov.tw/upload/representImageFile/2019-05-31/9e0fce51-3db4-4012-81db-aad93af94b4d/P_20180329_104953_HDR.jpg","name":"P_20180329_104953_HDR"},"representImageSource":"臺東縣政府文化處提供","landScope":"長濱鄉八仙洞段319、319-1、319-2、319-3、319-4、319-5及319-6等七筆地號，面積58,477.22平方公尺。\n長濱鄉八仙洞段531地號，面積1,913.55平方公尺。\n長濱鄉八仙洞段532地號，面積3,807平方公尺。","nearbyArcheologyCheck":"位於或鄰近列冊遺址","nearbyArcheologyBrief":"大壩來、樟原第一、樟原第二","cultralMean":"1.台灣舊石器時代長濱文化的代表遺址。\r\n2.台灣少見的洞穴遺址。","pastHistory":"1.內政部於民國77年公告為國家一級古蹟。\n2.文建會民國95年5月1日重新指定為國定遺址。\n3.文化部106年11月17日文授資局物字第10630129932號重新公告其類別名稱為「考古遺址」。\n","actualStatus":"(一)東部風景特定區管理處設有「八仙洞遊客服務中心」，內有「八仙洞遺址」小展覽室，展示遺址環境、考古發掘標本及舊石器文化橂型資料，東管處有派駐警衛及服務人員。\n(二)現地山勢下緣三洞穴(地藏、觀音、靈巖)及山勢上緣南半段四洞穴(乾元、海雷、永安、潮音)前有寺廟存在問題，經查為占用公有地，自107年起已無寺廟存在於洞穴中。","usageStatus":"遺址為八仙洞風景區。","landUsage":"遺址為八仙洞風景區。","announcementList":[{"classification":"變更/修正","officialDocNo":"文授資局物字第11330080491號","registerDate":"2024-08-08 13:53:18.348","note":"補充指定理由及其法令依據。"},{"classification":"變更/修正","officialDocNo":"文授資局物字第10630129932號","registerDate":"2017-11-17 15:10:21.491","note":"重新公告類別名稱"},{"classification":"指定/登錄","officialDocNo":"文資籌研字第 09500017951 號","registerDate":"2006-05-01 09:13:47.0"}],"landlotList":[{"itemNo":1,"cityName":"臺東縣","distName":"長濱鄉","landNo":"八仙洞段","landSerialNo":"319","landownership":"公有","cityLandUseType":"保護區","noncityLandUseTypeOther":""},{"itemNo":2,"cityName":"臺東縣","distName":"長濱鄉","landNo":"八仙洞段","landSerialNo":"319-1","landownership":"公有","cityLandUseType":"保存區","noncityLandUseTypeOther":""},{"itemNo":3,"cityName":"臺東縣","distName":"長濱鄉","landNo":"八仙洞段","landSerialNo":"319-2","landownership":"公有","cityLandUseType":"其他使用區","cityLandUseTypeOther":"綠帶","noncityLandUseTypeOther":""},{"itemNo":4,"cityName":"臺東縣","distName":"長濱鄉","landNo":"八仙洞段","landSerialNo":"319-3","landownership":"公有","cityLandUseType":"保存區","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":5,"cityName":"臺東縣","distName":"長濱鄉","landNo":"八仙洞段","landSerialNo":"319-4","landownership":"公有","cityLandUseType":"其他使用區","cityLandUseTypeOther":"公園用地","noncityLandUseTypeOther":""},{"itemNo":6,"cityName":"臺東縣","distName":"長濱鄉","landNo":"八仙洞段","landSerialNo":"319-5","landownership":"公有","cityLandUseType":"其他使用區","cityLandUseTypeOther":"公園用地","noncityLandUseTypeOther":""},{"itemNo":7,"cityName":"臺東縣","distName":"長濱鄉","landNo":"八仙洞段","landSerialNo":"319-6","landownership":"公有","cityLandUseType":"其他使用區","cityLandUseTypeOther":"公園用地","noncityLandUseTypeOther":""},{"itemNo":8,"cityName":"臺東縣","distName":"長濱鄉","landNo":"八仙洞段","landSerialNo":"531","landownership":"公有","cityLandUseType":"保存區","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":9,"cityName":"臺東縣","distName":"長濱鄉","landNo":"八仙洞段","landSerialNo":"532","landownership":"公有","cityLandUseType":"保存區","cityLandUseTypeOther":"","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20060501000007","mediaImageList":[{"mediaName":"88885(2)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39460/photo/88885(2).jpg"},{"mediaName":"88885(3)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39461/photo/88885(3).jpg"},{"mediaName":"88885(4)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39462/photo/88885(4).jpg"},{"mediaName":"88885(5)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39463/photo/88885(5).jpg"}],"documents":["https://data.boch.gov.tw/upload/documents/2021-03-30/97a6b5bd-d973-472c-aec1-153937a63819/950501行政院文化建設委員會公告.pdf","https://data.boch.gov.tw/upload/documents/2021-03-30/e564bf04-8dd4-4c41-9aea-370e82dbb124/1061117文化部公告-重新公告類別名稱.pdf","https://data.boch.gov.tw/upload/documents/2025-05-12/e54bf68a-40ca-44ec-93b2-89566364c11c/1130808文化部公告-補充指定理由及其法令依據.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"中華民國"}],"govInstitution":"文化部文化資產局","govDeptName":"古物遺址組遺址科","govDeptAddress":"臺中市南區復興路三段362號","govDeptPhone":"(04)22177631","repImgId":59219},{"caseId":"20070614000002","caseName":"舊香蘭考古遺址","assetsClassifyCode":"2.1.3","assetsClassifyName":"縣(市)定考古遺址","judgeCriteria":["遺址保存狀況之完整性","遺址供展示教育規劃之適當性"],"registerReason":"依據遺址指定及廢止審查辦法第3條符合指定基準第五項：遺址保存狀況之完整性及第六項：遺址供展示教育規劃之適當性。","lawsReference":"1.依據新修訂之文化資產保存法第111條規定。\n2.106年2月20日臺東縣106年度第1次文化資產審議委員會決議辦理。\n","govInstitutionName":"臺東縣政府","addresses":[{"itemNo":1,"cityName":"臺東縣","distName":"太麻里鄉","address":"臺東縣太麻里鄉南太麻里溪出海口南岸，舊香蘭社區東南方約300公尺的臺9線公路至海岸線之間。"}],"longitude":120.99908883197523,"latitude":22.580595301498803,"relativePosition":"","neighborPosition":"","representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/upload/representImageFile/2021-07-20/0affdb01-2dc6-4c81-99b5-a1c1e29c50d4/考古遺址01_舊香蘭遺址-永保_c.jpg"},"original":"https://data.boch.gov.tw/upload/representImageFile/2021-07-20/0affdb01-2dc6-4c81-99b5-a1c1e29c50d4/考古遺址01_舊香蘭遺址-永保.jpg","name":"考古遺址01_舊香蘭遺址-永保"},"representImageSource":"109-110年度臺東縣文化資產個案資料同步更新維護計畫-姜柷山提供","landScope":"臺東縣太麻里鄉蘭里段188、888、903、904、905、889、890、891地號。","nearbyArcheologyBrief":"香蘭遺址，位於臺東縣太麻里鄉香蘭村，南太麻里溪右岸，即香蘭車站西北處，太麻里鄉第五公墓上。海拔高度60 至75 公尺。出土打製石杵(劉益昌等1994)、帶穿孔板岩(臧振華、葉美珍2000)等。調查時遺址為釋迦園，地表多枯葉覆蓋，調查時無發現遺物。","cultralMean":"舊香蘭遺址除了能證明這是一處史前聚落遺址之外，更重要的是她出現三項重要的考古證據：1、在遺址上出土的部分陶器、石器及骨角器上出現百步蛇紋飾，這項具體的證據證明這遺址和原住民文化可能有直接的淵源。2、這遺址文化層內出現隨地散落的琉璃珠及鐵渣，也出現鍛造鐵器的現象及熔解玻璃材料的證據，證明這遺址可能曾經是一個金屬器及琉璃珠的製造場所。3、這遺址出現鑄造金屬器的模具，從模具特徵推斷，所鑄造的器物有青銅鈴、青銅刀柄等，證明這遺址可能也是臺灣史前製造青銅器的工廠。\n上述這三項證據，在台灣原住民文化起源的研究上，及台灣史前文化及原住民文化的工藝技術研究上，應有舉足輕重的地位。此外青銅器模具的出現，更成為臺灣史前文化與南島文化間交流的一條重要線索。因此舊香蘭遺址是一處不可忽視的重要遺址，如進行評等，應可被列為重要的國家遺址。\n","pastHistory":"舊香蘭遺址的範圍，大致在臺東縣太麻里鄉舊香蘭社區東南方約300公尺，臺9線公路延伸到海岸線，面積約22公頃。\n舊香蘭遺址是在民國87年（1998）被發現，可能出現在距今1,980年至2,300年之間。民國92年9月，舊香蘭遺址附近的海岸砂丘因受杜鵑颱風的侵蝕，露出埋在砂丘底部的史前文化層，但這露頭隨時會再被侵蝕而消失。於是，臺東縣政府委託史前館緊急進行「舊香蘭遺址搶救計畫」，由李坤修副研究員進行搶救發掘和研究，到民國94年2月結束。\n資料來源：臺東縣舊香蘭遺址搶救發掘計畫\n舊香蘭遺址被視為「卑南文化三和類型」的遺址之一。海岸區的搶救發掘所出土的一些標本，是東部地區的首次發現，也是臺灣考古的唯一的發現，例如刻有百步蛇紋的骨角器、斜紋多彩琉璃珠，半熔解的玻璃材料、砂岩製的模具等，可以說是臺灣史前文化與原住民文化之間的重要環節。\n資料來源：臺東縣舊香蘭遺址搶救發掘計畫","actualStatus":"海岸搶救區：進行考古挖掘，出土物則由史前博物館保管。其餘遺址範圍多數農耕地種植釋迦果，目前以現地保存列冊管理。\r\n非都市計畫區之農牧用地（188、903、904、905地號）非都市計畫區之交通用地（888地號）非都市計畫區之國土保安用地（889、890、891地號）","usageStatus":"遺址所在土地除海岸地帶為沙灘外，則為已開發之農地，以種植釋迦果園為主。另林務局管理之國土保安用地，以做為保安林使用為主，種植木麻黃樹林及自然海岸植生。","landUsage":"遺址所在土地除海岸地帶為沙灘外，則為已開發之農地，以種植釋迦果園為主。另林務局管理之國土保安用地，以做為保安林使用為主，種植木麻黃樹林及自然海岸植生。","announcementList":[{"classification":"指定/登錄","officialDocNo":"府文資字第1060092740號","registerDate":"2017-03-02 00:00:00.0","note":"依文化資產保存法第111條規定完成重新指定、登錄及公告程序"},{"classification":"指定/登錄","officialDocNo":"府文資字第 0963018731 號","registerDate":"2007-06-14 00:00:00.0"}],"landlotList":[{"itemNo":1,"cityName":"臺東縣","distName":"太麻里鄉","landNo":"蘭里段","landSerialNo":"188","landownership":"公有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"農牧用地"},{"itemNo":2,"cityName":"臺東縣","distName":"太麻里鄉","landNo":"蘭里段","landSerialNo":"888","landownership":"公有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"交通用地"},{"itemNo":3,"cityName":"臺東縣","distName":"太麻里鄉","landNo":"蘭里段","landSerialNo":"889","landownership":"公有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"國土保安用地"},{"itemNo":4,"cityName":"臺東縣","distName":"太麻里鄉","landNo":"蘭里段","landSerialNo":"890","landownership":"公有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"國土保安用地"},{"itemNo":5,"cityName":"臺東縣","distName":"太麻里鄉","landNo":"蘭里段","landSerialNo":"891","landownership":"公有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"國土保安用地"},{"itemNo":6,"cityName":"臺東縣","distName":"太麻里鄉","landNo":"蘭里段","landSerialNo":"903","landownership":"公有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"農牧用地"},{"itemNo":7,"cityName":"臺東縣","distName":"太麻里鄉","landNo":"蘭里段","landSerialNo":"904","landownership":"公有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"農牧用地"},{"itemNo":8,"cityName":"臺東縣","distName":"太麻里鄉","landNo":"蘭里段","landSerialNo":"905","landownership":"私有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"農牧用地"}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20070614000002","documents":["https://data.boch.gov.tw/upload/documents/2021-05-23/9b3599f5-108a-49ed-a406-383811f26cc8/臺東縣考古遺址公告公文-01舊香蘭遺址-106年重新指定.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"財政部國有財產署"},{"ownerType":"土地所有人","ownerName":"農業部林業及自然保育署"},{"ownerType":"土地所有人","ownerName":"原住民族委員會"}],"govInstitution":"臺東縣政府文化處","govDeptName":"文化資產科","govDeptAddress":"臺東市南京路25號","govDeptPhone":"089-350129","repImgId":125509},{"caseId":"20121011000001","caseName":"富世考古遺址","assetsClassifyCode":"2.1.3","assetsClassifyName":"縣(市)定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址文化堆積內涵之特殊性及豐富性","遺址保存狀況之完整性"],"registerReason":"富世考古遺址位於立霧溪下游右岸海拔90公尺處河階上，河階地形如一枚彎月，長約300公尺、寬約30-50公尺。階地的南緣為陡峭的岩壁，為新城山的北麓，北處是立霧溪出海口，東北邊面向太平洋，西邊則是太魯閣口。\n\n考古學家陳仲玉先生於1985年進行富世考古遺址的調查發掘工作，確認此處的史前文化內涵。據他的研究指出，富世考古遺址有二層不同的文化層。從出土的陶片、立於地表的單石以及發掘出來呈寬短形式的石板棺可知，上層文化層為方格印紋陶文化，下層文化層特性則具有台灣東海岸巨石文化(麒麟文化)與卑南文化的石板棺特質相結合的現象。遺址年代距今約2千多年。\n\n從富世考古遺址的文化內涵推斷，2千多年前有一群受麒麟文化與卑南文化雙重影響下的族群分布於立霧溪口一帶，會進入立霧溪與陶賽溪流域進行狩獵。富世考古遺址說明了，即使在山高水激、地勢險峻的自然環境中，太魯閣地區的人文活動於史前時代就已經開始了。","lawsReference":"「文化資產保存法」第111條、「行政程序法」第122條、107年12月17日召開之「花蓮縣文化資產審議委員會有形文化資產組107年度第3次會議」決議。","govInstitutionName":"花蓮縣政府","addresses":[{"itemNo":1,"cityName":"花蓮縣","distName":"秀林鄉","address":"太魯閣段63、123、125、127、137、138、139、140、143、144、145、152、153、157、195地號"}],"longitude":121.62140909779636,"latitude":24.151937871646748,"relativePosition":"...","representImage":{"ext":"JPG","transform":{"c":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/38152/photo/65d7a581-8073-409f-bd54-76c11f2187c3_c.JPG"},"original":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/38152/photo/65d7a581-8073-409f-bd54-76c11f2187c3.JPG","name":"65d7a581-8073-409f-bd54-76c11f2187c3"},"representImageSource":"花蓮縣文化局","landScope":"花蓮縣秀林鄉太魯閣段63(太魯閣段123地號西側界線以西、海拔高度約200公尺以下範圍)、123、125、127(海拔高度約200公尺以下範圍)、137(海拔高度約200公尺以下範圍)、138、139、140、143、144、145、152、153、156、157、195(海拔高度約200公尺以下、方格座標N2672000m(TWD97)以北範圍)。位於立霧溪口右岸，錦文橋頭中橫公路太魯閣門牌坊南側，富世村富世長老教會上方的河階地上。為一西北往東南向狹長的弧狀階地，階地南緣為陡峭之岩壁，南倚新城山，東向太平洋，北臨立霧溪口。","nearbyArcheologyCheck":"位於或鄰近普查遺址","nearbyArcheologyBrief":"階地平台內可見因開墾所堆砌之石壘牆，而遺址現址南側為部分林地與旱作，種植玉米或花生等作物，遺址北側則有當地居民闢為菜圃。顯示該遺址受到某種程度之人為活動干擾。","cultralMean":"巨石文化北遷以及十三行文化南移等南北文化匯流之文化相。","pastHistory":"民國77年公告為國家三級古蹟，95年11月2日公告為縣定遺址，101年10月11日重新公告遺址範圍。","actualStatus":"階地平台內可見因開墾所堆砌之石壘牆，而遺址現址南側為部份林地與旱作，種植玉米或花生等作物，遺址保存狀況尚佳。","usageStatus":"階地平台內可見因開墾所堆砌之石壘牆，而遺址現址南側為部份林地與旱作，種植玉米或花生等作物，遺址北側則有當地居民闢為菜圃。顯示該遺址受到某種程度之人為活動干擾。","landUsage":"地表栽植竹林、果樹與旱作植物等","announcementList":[{"classification":"指定/登錄","officialDocNo":"府文資字第1080037184A號","registerDate":"2019-02-25 14:26:31.286"},{"classification":"變更/修正","officialDocNo":"府文資字第1010189747A號","registerDate":"2012-10-11 10:13:18.0"},{"classification":"指定/登錄","officialDocNo":"府文資字第09505801410號","registerDate":"2006-11-02 14:25:00.122"}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20121011000001","mediaImageList":[{"mediaName":"富世考古遺址(趙守彥攝影提供)","author":"趙守彥","url":"https://data.boch.gov.tw/upload/media/2022-01-25/c86b4ecb-0c87-47c1-a9ec-d0b5a2cd3dcd/RE01 花蓮縣 富世遺址01.jpg"},{"mediaName":"富世考古遺址","url":"https://data.boch.gov.tw/upload/media/2022-01-25/858fa362-0392-4d1a-9bb0-d8e0e29a8213/s_intro_img3569132050031.jpg"},{"mediaName":"富世考古遺址","url":"https://data.boch.gov.tw/upload/media/2022-01-25/35cd27f7-605d-43c2-993d-eb530d28df13/3497941987151.jpg"}],"documents":["https://data.boch.gov.tw/upload/documents/2022-02-21/d0c5afb5-3063-4e7b-801f-10fabf08c204/富世考古遺址變更原公告類別名稱公告1080225.pdf","https://data.boch.gov.tw/upload/documents/2022-02-21/38c077b9-c6b8-47c2-a032-d10eb4f5abc7/富世考古遺址指定為遺址公告951102.pdf","https://data.boch.gov.tw/upload/documents/2022-02-21/4b86a600-89bc-4111-bde9-c2741fdfb72a/富世考古遺址重新指定範圍公告1011011.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"余OO"},{"ownerType":"土地所有人","ownerName":"行政院原住民族委員會"},{"ownerType":"土地所有人","ownerName":"鄭OOOOOO"},{"ownerType":"土地所有人","ownerName":"陳OO"},{"ownerType":"土地所有人","ownerName":"王OO"},{"ownerType":"土地所有人","ownerName":"余OOOOOOOOOOOOOO"},{"ownerType":"土地所有人","ownerName":"陳OO"},{"ownerType":"土地所有人","ownerName":"行政院原住民族委員會"},{"ownerType":"土地所有人","ownerName":"白OOOOOO"},{"ownerType":"土地所有人","ownerName":"吳OOOOOO"},{"ownerType":"土地所有人","ownerName":"潘OO"},{"ownerType":"土地所有人","ownerName":"陳OO"},{"ownerType":"土地所有人","ownerName":"余OO"},{"ownerType":"土地所有人","ownerName":"吳OOOOOO"},{"ownerType":"土地所有人","ownerName":"簡OO"},{"ownerType":"土地所有人","ownerName":"羅OO"},{"ownerType":"土地所有人","ownerName":"行政院原住民族委員會"}],"govInstitution":"花蓮縣政府","govDeptName":"花蓮縣文化局","govDeptAddress":"花蓮市文復路6號","govDeptPhone":"03-8227121分機314","repImgId":4570},{"caseId":"20061102000003","caseName":"公埔考古遺址","assetsClassifyCode":"2.1.3","assetsClassifyName":"縣(市)定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性"],"registerReason":"1.考古遺址在文化發展脈絡中之定位及意義性：公埔考古遺址於1929年為日籍學者鹿野忠雄所發現，文化內涵歸屬於新石器時代晚期「卑南文化」，意謂著住在公埔遺址的人群與臺東「卑南遺址」之族群有著密切的往來關係，或是卑南文化人的後代由花東縱谷往北遷徙定居的落腳處。\n2.考古遺址在學術研究史上之意義性：根據中央研究院郭素秋女士於2012 – 2013年進行的調查與研究，遺址年代大約在距今3000 – 2500年前，文化內涵含括台東平原與花東縱谷南段常見的「卑南文化」，與花東海岸常見的「麒麟文化」；其同時呈現出這兩個史前文化特色，顯示出本考古遺址位於文化邊緣、文化交界區的文化特性。\n3.考古遺址文化堆積內涵之特殊性及豐富性：文化年代為新石器時代晚期，出土石鋤、石錛、石鐮、穿孔板岩器，並有多量閃玉製作的玉錛、玉鑿、玉環等。\n4.同類型考古遺址數量之稀有性：考古遺址上可見二面相對而立的大石壁，石壁的高度在180cm – 245cm之間，為花東縱谷地區少見的史前大石壁考古遺址。\n5.考古遺址保存狀況之完整性：考古遺跡保存狀況尚屬良好。\n6.考古遺址供展示教育規劃之適當性：目前設有考古遺址公園，設施解說牌、涼亭與導覽步道。\n","lawsReference":"「文化資產保存法」第46條第1項及「考古遺址指定及廢止審查辦法」第5條。","govInstitutionName":"花蓮縣政府","addresses":[{"itemNo":1,"cityName":"花蓮縣","distName":"富里鄉","address":"花蓮縣富里鄉石牌村"}],"longitude":121.26214504851602,"latitude":23.18654765442083,"representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/38161/photo/99138b7d-16f8-4bcf-a2c2-2bee5b76fc2f_c.jpg"},"original":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/38161/photo/99138b7d-16f8-4bcf-a2c2-2bee5b76fc2f.jpg","name":"99138b7d-16f8-4bcf-a2c2-2bee5b76fc2f"},"representImageSource":"花蓮縣文化局","landScope":"富里鄉後湖段1276、1193、1192、1190、1194地號，面積約為9,497平方公尺。","nearbyArcheologyCheck":"位於或鄰近普查遺址","nearbyArcheologyBrief":"遺址範圍丘頂平台三個石壁，發現立石4個，石壁2座，在附近並採集少許石器，往後對於本遺址之紀錄均著重於板岩石壁之探討。石壁東側旁不斷地有廢棄堆土，並有幾座私人墳墓，遺址南側福德祠周遭墳墓區亦有擴建之虞。","cultralMean":"為花蓮縱谷南段卑南文化代表性遺址，並立有板岩石壁結構遺跡，為重要性遺址。","pastHistory":"鹿野忠雄於1929年5月13日首次調查本遺址，發現立石4個、石壁2座，在附近並採集少許石器（鹿野忠雄 1930：366-367；劉益昌 1992：63），往後對於本遺址之紀錄均著重於板岩石壁之探討。1992年劉益昌前往調查本遺址之保存現況時，「在遺址南側小土地公廟興建所切出的地層斷面中發現文化層」（劉益昌 1992：63）。","actualStatus":"遺址範圍丘頂平台三個石壁，發現立石4個，石壁2座，在附近並採集少許石器，往後對於本遺址之紀錄均著重於板岩石壁之探討。","usageStatus":"石壁東側旁不斷地有廢棄堆土，並有幾座私人墳墓，遺址南側福德祠週遭墳墓區亦有擴建之虞。","landUsage":"目前設有解說牌與導覽步道，石壁則圍有鐵柵欄保護。","announcementList":[{"classification":"變更/修正","officialDocNo":"府文資字第1070011501B號","registerDate":"2018-01-15 00:00:00.0"},{"classification":"指定/登錄","officialDocNo":"府文資字第09505801410號","registerDate":"2006-11-02 14:58:04.0"}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20061102000003","mediaImageList":[{"mediaName":"公埔考古遺址(趙守彥攝影提供)","author":"趙守彥","url":"https://data.boch.gov.tw/upload/media/2022-01-25/820f93e7-b0a2-41dd-b9c3-b7955d759df3/RE03 花蓮縣 公埔遺址 (三級)02.jpg"},{"mediaName":"公埔考古遺址(趙守彥攝影提供)","author":"趙守彥","url":"https://data.boch.gov.tw/upload/media/2022-01-25/158c7dc0-a7b9-4dec-9ee1-8540af017f7a/RE03 花蓮縣 公埔遺址 (三級)01.jpg"},{"mediaName":"公埔考古遺址","url":"https://data.boch.gov.tw/upload/media/2022-01-25/467667ca-c64e-442b-b8d5-d025a67e4722/3580135417426.jpg"}],"documents":["https://data.boch.gov.tw/upload/documents/2022-02-21/cf753ee8-678a-40c9-8fa6-b315e74058d4/公埔考古遺址指定為遺址公告951102.pdf","https://data.boch.gov.tw/upload/documents/2022-02-21/5c445370-d079-44e6-8db5-8aa2c6a5c5bd/公埔考古遺址變更名稱及定著土地範圍及地號公告1070115.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"陳OO"},{"ownerType":"土地所有人","ownerName":"中華民國財政部國有財產局"},{"ownerType":"土地所有人","ownerName":"鍾OO"},{"ownerType":"土地所有人","ownerName":"楊OO"}],"govInstitution":"花蓮縣政府","govDeptName":"花蓮縣政府文化局","govDeptAddress":"花蓮市文復路6號","govDeptPhone":"03-8227121-316","repImgId":4574},{"caseId":"20100608000001","caseName":"支亞干(萬榮．平林)考古遺址","assetsClassifyCode":"2.1.3","assetsClassifyName":"縣(市)定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性","具其他遺址價值者"],"registerReason":"1.遺址在文化發展脈絡中之定位及意義性：日治中晚期以來研究玉器製造具特殊研究意涵。\r\n2.遺址在學術研究史上意義性：玉器製作過程研究之起點與最重要的遺址。\r\n3.遺址文化堆積內涵之特殊性及豐富性：具多層文化層，均為豐富之堆積。\r\n4.同類型遺址數量之稀有性：全台唯一大型玉器製造場而且罕見。\r\n5.遺址保存狀況之完整性：相當完整僅受農耕損害部分。\r\n6.遺址供展示教育規劃之適當性：交通方便，且鄰近縱谷中的遊憩區。\r\n7.具其他遺址價值者：大型玉器製造遺址，極具研究意義，並具備國定遺址的價值。","lawsReference":"「文化資產保存法」第111條、「行政程序法」第122條、107年12月17日召開之「花蓮縣文化資產審議委員會有形文化資產組107年度第3次會議」決議。","govInstitutionName":"花蓮縣政府","addresses":[{"itemNo":1,"cityName":"花蓮縣","distName":"萬榮鄉","address":"花蓮縣萬榮鄉西林村西林段1715、1716、1717、1718、1719、1720、1721、1722、1723、1724、1725、1726、1727、1728、1729地號。"}],"longitude":121.43641679706181,"latitude":23.801996686307838,"relativePosition":"","neighborPosition":"","representImage":{"ext":"JPG","transform":{"c":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/38159/photo/cecfc340-35c4-4b83-ba31-54bad23286be_c.JPG"},"original":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/38159/photo/cecfc340-35c4-4b83-ba31-54bad23286be.JPG","name":"cecfc340-35c4-4b83-ba31-54bad23286be"},"representImageSource":"花蓮縣文化局","landScope":"花蓮縣萬榮鄉支亞干段2208、2209、2210、2213、2214、2215、2216、2217、2218、2219、2221、2222、2225、2226、2227地號共15筆土地，面積46,510.81平方公尺。花蓮縣萬榮鄉支亞干段2208、2209、2210、2213、2214、2215、2216、2217、2218、2219、2221、2222、2225、2226、2227地號共15筆土地，面積46,510.81平方公尺。","nearbyArcheologyBrief":"位於西林村落西南方，為中央山脈之支脈林田山山麓下向花東縱谷傾斜的高低兩層低位河階台階，西南臨清水溪，東北側為西林聚落與壽豐溪（知亞干溪）。","cultralMean":"平林遺址早於日治時期就已經考古學者調查發現，當時採集有關玉器製作相關的重要遺物，玉器的研究遂逐漸地成為學者們調查的觀察重點，歷年來考古學者們也指出平林遺址為目前已知台灣最重要的玉器產地，也是最大型的玉器製造遺址，同一類型的遺址罕見於台灣、東亞與東南亞地區。近年的研究更指出可能是玉器製造體系的中心，整體台灣玉器製造與交換體系不但擴及本島及周邊島嶼，更向南方遠達菲律賓、越南與泰國等環南海國家，顯示出以平林遺址為中心的玉器交通與交換體系，具有重要的海域交流意義。透過已有的研究體系，可以理解此一遺址所構成的玉器製作體系在距今4500-1500年之間，長達3000年左右。以玉器製作和交換體系做為研究命題，擴及的乃是新石器中晚期台灣史前社會的核心焦點，玉器不但是裝飾品，也被當作重要的社會象徵，因此被廣泛性地配飾以及當作重要的陪葬品，而這樣的文化現象廣佈於當時的台灣史前社會。","pastHistory":"平林遺址於1929 年6 月間由鹿野忠雄調查發現並進行試掘，並於1930 年發表於遺址表，當時採集所得見的遺物有磨製石斧、打製石斧、陶器、石棒、石槍、石製品等。\n戰後本遺址則少有調查，不過於1950 年時劉茂源曾進行本遺址之調查及試掘，在1953 年6 月石璋如、宋文薰、唐美君、李亦園等由於田野考古實習課程，因此前往花蓮進行平林遺址的地表調查，採集到管狀旋截器（圓形玉核）、磨製石斧、穿孔石槍頭、石箭頭、石杵、石槌、圓形石板、石料等遺物，其中石料多有旋截痕或磨鋸痕，而圓形石板則類似大馬璘遺址之部分打製石板之形制。之後雖歷年均有學者調查，但未見於文獻記錄，至1980 年由台灣大學黃士強教授主持之「全省重要史蹟勘察與整修建議—考古遺址與舊社部分」進行全台遺址調查工作，由劉益昌前往本遺址進行調查記錄，將本遺址列為重要遺址，其中說明本遺址屬卑南文化遺址，出土遺物相當豐富；1990 年進行「台灣地區史前遺址資料檔」計畫，也針對本遺址進行調查，記錄遺址屬卑南文化；在1991 年由內政部及行政院文化建設委員會委託中國民族學會執行之「臺灣地區重要考古遺址初步評估第一階段研究計畫」，也進行了遺址之調查記錄，在遺址表中之重要性中說明「本遺址所包含史前遺留，顯示其重要遺址特色，可能是新石器時代玉器加工場或台灣玉材料分散地」，並且「建議指定為古蹟」。\n1992 年地方文史工作者王天送先生發表花蓮地區的考古遺址資料，也曾記錄平林遺址，1993 年再度登錄於內政部委託中國民族學會執行的「台閩遺址普查計畫第一期」之中，準備進行台閩地區全面普查，唯普查工作遲至2003 年才由內政部委託中央研究院歷史語言研究所進行宜蘭縣、花蓮縣的遺址普查工作，也曾前往本遺址進行調查記錄。至1998 年劉益昌由於為理解玉器製造工藝問題，因此進行本遺址之試掘，初步選定5 處試掘探坑，其中第四號探坑由於遺物出土的狀態似具有玉器製造之遺跡，因此予以擴坑為4×4 公尺，以便取得可資進一步理解玉器工藝製造的資訊，初步撰述報告以及玉器工藝製造工序之相關論文。2004 年李坤修亦前往遺址進行6 處考古試掘探坑，除了出土玉廢料、玉質工具、玉質裝飾品等外，亦發現玻璃珠與鐵器。2012年劉益昌主持「花蓮縣縣定遺址-萬榮‧平林遺址內涵及範圍調查研究計畫」所進行的調查、鑽探與試掘工作中，進一步理解本遺址的分布範圍與文化內涵，亦得以做為本遺址在範圍分布與內涵描述之基本材料。","actualStatus":"遺址所在的山坡階地多開闢為旱田，種植椰子、玉米、檳榔、菜圃等旱作。","usageStatus":"遺址所在的山坡階地多開闢為旱田，種植椰子、玉米、檳榔、菜圃等旱作。","landUsage":"遺址所在的山坡階地多開闢為旱田，種植椰子、玉米、檳榔、菜圃等旱作。","announcementList":[{"classification":"指定/登錄","officialDocNo":"府文資字第1080037196A號","registerDate":"2019-02-25 16:05:50.487"},{"classification":"指定/登錄","officialDocNo":"府文資字第0990094851A號","registerDate":"2010-06-08 19:56:49.0"}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20100608000001","mediaImageList":[{"mediaName":"支亞干（萬榮．平林）考古遺址(趙守彥攝影提供)","author":"趙守彥","url":"https://data.boch.gov.tw/upload/media/2022-01-25/bfa11a7b-f21d-4043-81d2-23aa67504054/RE04 花蓮縣 萬榮鄉平林遺址01.jpg"},{"mediaName":"支亞干（萬榮．平林）考古遺址","url":"https://data.boch.gov.tw/upload/media/2022-01-25/86e7385b-0305-4c4a-a25e-881c20c0aa1c/支亞干.jpg"},{"mediaName":"支亞干（萬榮．平林）考古遺址","url":"https://data.boch.gov.tw/upload/media/2022-01-25/792f7a49-21be-4fd0-befd-c5202c8d82b5/支亞干 (2).jpg"}],"documents":["https://data.boch.gov.tw/upload/documents/2022-02-21/1c0af407-4834-4e5f-944f-29d85807f217/支亞干(萬榮．平林)考古遺址變更文資類別名稱公告1080225.pdf","https://data.boch.gov.tw/upload/documents/2022-02-21/76027fa8-2c5e-425d-9060-c937d56d7f07/支亞干(萬榮．平林)考古遺址指定為遺址考古遺址公告990608.pdf"],"caseOwnership":[{"ownerType":"建築所有人","ownerName":"必填"},{"ownerType":"建築所有人","ownerName":"姓名/名稱"},{"ownerType":"土地所有人","ownerName":"潘OO"},{"ownerType":"土地所有人","ownerName":"高OO"},{"ownerType":"土地所有人","ownerName":"張OO"},{"ownerType":"土地所有人","ownerName":"方OO"},{"ownerType":"土地所有人","ownerName":"鄧OO"},{"ownerType":"土地所有人","ownerName":"袁OO"},{"ownerType":"土地所有人","ownerName":"袁OO"},{"ownerType":"土地所有人","ownerName":"袁OO"},{"ownerType":"土地所有人","ownerName":"袁OO"},{"ownerType":"土地所有人","ownerName":"楊OO"},{"ownerType":"土地所有人","ownerName":"袁OO"},{"ownerType":"土地所有人","ownerName":"袁OO"},{"ownerType":"土地所有人","ownerName":"袁O"},{"ownerType":"土地所有人","ownerName":"袁OO"},{"ownerType":"土地所有人","ownerName":"薛OO"},{"ownerType":"土地所有人","ownerName":"張OO"},{"ownerType":"土地所有人","ownerName":"張OO"},{"ownerType":"土地所有人","ownerName":"張OO"},{"ownerType":"土地所有人","ownerName":"潘OO"},{"ownerType":"土地所有人","ownerName":"潘OO"},{"ownerType":"土地所有人","ownerName":"潘OO"},{"ownerType":"土地所有人","ownerName":"潘OO"},{"ownerType":"土地所有人","ownerName":"何OO"},{"ownerType":"土地所有人","ownerName":"薛OO"},{"ownerType":"土地所有人","ownerName":"江OO"},{"ownerType":"土地所有人","ownerName":"宋OO"},{"ownerType":"土地所有人","ownerName":"温OO"},{"ownerType":"土地所有人","ownerName":"王OO"},{"ownerType":"土地所有人","ownerName":"胡OO"},{"ownerType":"土地所有人","ownerName":"謝OO"},{"ownerType":"土地所有人","ownerName":"蔡OO"},{"ownerType":"土地所有人","ownerName":"曾OO"}],"govInstitution":"花蓮縣政府","govDeptName":"花蓮縣文化局","govDeptAddress":"花蓮市文復路6號","govDeptPhone":"03-8227121","repImgId":4577},{"caseId":"20160815000001","caseName":"Blihun漢本考古遺址","assetsClassifyCode":"2.1.1","assetsClassifyName":"國定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性","具其他遺址價值者"],"registerReason":"(一)遺址在文化發展脈絡中之定位及意義性：\n已發現三大史前文化層，其文化內涵及重要性足以比擬國定十三行遺址。\n(二)遺址在學術研究史上意義性：\n可解釋臺灣新石器時代晚期發展至金屬器時代之變遷。輸入外來之金屬器、高溫技術、瑪瑙，取代原產之玉器，成為臺灣史前人類重要裝飾與儀式用品，逐漸延續至當代原住民物質文化最重要組成的部分，其發現無疑在學術史上佔有重要意義。\n(三)遺址文化堆積內涵之特殊性及豐富性：\n文化層堆積連續1,000年以上，除一般常見之陶石器外，更發現豐富之金屬器、玻璃、瑪瑙等外來物質，最重要的發現是完整度極高的聚落型態，依目前發掘結果已足以與國定卑南遺址比擬。\n(四)同類型遺址數量之稀有性：\n文化內涵可充分詮釋新石器時代晚期發展至金屬器時代之過程，其稀有性如配合淇武蘭、利澤簡、海岸等遺址之所見，可完整顯示新石器時代晚期至文字時期前後之噶瑪蘭族之發展歷程。\n(五)遺址保存狀況之完整性：\n文化層原埋封於1,000年左右之土石流地層下，保存狀況良好。與工程重疊部分採搶救發掘後，保留遺址總面積約94%，相較於因八里污水廠破壞後，僅保存總面積約5%之國定十三行遺址，及文化層最豐富部分受鐵路工程破壞之國定卑南遺址， 漢本遺址保存狀況可謂較佳。\n(六)遺址供展示教育規劃之適當性：\n位於鐵公路之樞紐地帶，未來自和平交流道進入遺址之路線亦相當便捷；所在地可充分詮釋人類與自然環境共處關係之省思，深具展示教育意義。\n(七)具其他遺址價值者：\n自出土之文化、生態遺物及聚落相對位置，可說明遺址當以海域為重要交通動線，充分顯示早期人群之海洋文化特色，對於當今以海洋立國的臺灣而言，具特殊啟示意義。出土遺物顯見與當代原住民族–阿美族、撒奇萊雅族、蘭陽平原噶瑪蘭族、北海岸巴賽族、凱達格蘭族均有豐富關聯性，該遺址為這些人群傳說中祖先來源的重要方向，具非常重要的歷史意義。","lawsReference":"符合《文化資產保存法》第46條暨《遺址指定及廢止審查辦法》第3條規定之指定基準。 ","govInstitutionName":"文化部","addresses":[{"itemNo":1,"cityName":"宜蘭縣","distName":"南澳鄉","address":"澳花村"}],"longitude":121.766944,"latitude":24.326944,"relativePosition":"漢本遺址位於宜蘭縣南澳鄉澳花村漢本聚落附近","neighborPosition":"蘇花改公路谷風隧道南口。","representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/132517/photo/test_c.jpg"},"original":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/132517/photo/test.jpg","name":"test"},"representImageSource":"宜蘭縣政府文化局提供","landScope":"宜蘭縣南澳鄉澳花段93-1地號等149筆土地，面積約88,900㎡，如清冊及範圍圖。宜蘭縣南澳鄉澳花村漢本聚落附近，大致在漢本車站南側與和平溪北岸之間的海岸平原緩坡，東側緊鄰太平洋，西側坐落於濁水山的山腳下，南臨和平溪。","nearbyArcheologyCheck":"位於或鄰近普查遺址","cultralMean":"1.漢本遺址出土豐富多元的標本，以及大規模保存完整之駁坎、火塘、煉鐵爐、石棺群等史前遺跡，漢本遺址之外來遺物、高溫技術與交通體系等文化內涵，將必能更完整解釋臺灣史前史缺失之處。\r\n2.漢本遺址的文化內涵：\r\n(1)多文化層遺址，各文化層內涵豐富。\r\n(2)金屬器時代高溫技術出現的遺址。\r\n(3)新石器時代轉變為金屬器時代之代表型遺址。\r\n(4)解釋今日南島民族祖先遷徙與往返的重要遺址。\r\n(5)說明今日北東海岸地帶貿易與交換人群的代表性遺址。","pastHistory":"1.民國93年劉益昌進行「國道東部公路蘇澳花蓮段環境影響評估及差異分析史蹟調查」。\r\n2.民國99年顏廷伃、鍾國風進行「台9線蘇花公路山區路段改善計畫文化史蹟調查」。\r\n3.民國101年3月在蘇花改計畫道路約15K+400處土地公廟旁，於施工監看過程中發現史前遺物；101年2月起即由顏廷伃博士進行武塔遺址、漢本新生地遺物出土地點考古試掘，完成試掘後在7月提送試掘報告書，漢本更名為遺址，建議漢本及武塔2處遺址進行搶救發掘。\r\n4.漢本遺址搶救發掘計畫於101年9月開始執行，由中央研究院歷史語言研究所（計畫主持人劉益昌研究員），針對工程中的土層開挖部位，進行遺址搶救發掘。\r\n5.民國104年12月中央研究院歷史語言研究所提報漢本遺址指定。\r\n6.民國105年1月8日經現場勘查決為定列冊遺址。\r\n7.民國105年3月28日審議指定為縣定遺址。\r\n8.民國105年7月1日審議指定為國定遺址。","usageStatus":"目前除小部分耕作外，為交通要道蘇花公路、北迴鐵路經過，蘇花公路旁有1排民宅建築，施工中的蘇花改公路谷風隧道南口也是穿過本遺址。","landUsage":"遺址範圍內土地屬一般農業區、山坡地保育區及未登錄地。","announcementList":[{"classification":"變更/修正","officialDocNo":"文授資局物字第10630129932號","registerDate":"2017-11-17 00:00:00.0","note":"重新公告類別名稱"},{"classification":"指定/登錄","officialDocNo":"文授資局物字第10530079341號","registerDate":"2016-08-15 00:00:00.0"}],"landlotList":[{"itemNo":1,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"93","landownership":"公有","noncityLandUseType":"一般農業區"},{"itemNo":2,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"93-1","landownership":"公有","noncityLandUseType":"一般農業區"},{"itemNo":3,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"94","landownership":"公有","noncityLandUseType":"一般農業區"},{"itemNo":4,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"94-1","landownership":"公有","noncityLandUseType":"一般農業區"},{"itemNo":5,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"94-2","landownership":"公有","noncityLandUseType":"一般農業區"},{"itemNo":6,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"101","landownership":"私有","noncityLandUseType":"一般農業區"},{"itemNo":7,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"101-1","landownership":"公有","noncityLandUseType":"一般農業區"},{"itemNo":8,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"102","landownership":"私有","noncityLandUseType":"一般農業區"},{"itemNo":9,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"103","landownership":"私有","noncityLandUseType":"一般農業區"},{"itemNo":10,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"104","landownership":"私有","noncityLandUseType":"一般農業區"},{"itemNo":11,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"203","landownership":"公有","noncityLandUseType":"一般農業區"},{"itemNo":12,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"202","landownership":"私有","noncityLandUseType":"一般農業區"},{"itemNo":13,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"208","landownership":"私有","noncityLandUseType":"一般農業區"},{"itemNo":14,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"209","landownership":"公有","noncityLandUseType":"一般農業區"},{"itemNo":15,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"212","landownership":"私有","noncityLandUseType":"一般農業區"},{"itemNo":16,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"213","landownership":"私有","noncityLandUseType":"一般農業區"},{"itemNo":17,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"218","landownership":"公有","noncityLandUseType":"一般農業區"},{"itemNo":18,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"213-2","landownership":"公有","noncityLandUseType":"一般農業區"},{"itemNo":19,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"216","landownership":"公有","noncityLandUseType":"一般農業區"},{"itemNo":20,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"216-2","landownership":"公有","noncityLandUseType":"一般農業區"},{"itemNo":21,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"217","landownership":"公有","noncityLandUseType":"一般農業區"},{"itemNo":22,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"225","landownership":"公私有","noncityLandUseType":"一般農業區"},{"itemNo":23,"cityName":"宜蘭縣","distName":"南澳鄉","landNo":"澳花段","landSerialNo":"226","landownership":"私有","noncityLandUseType":"一般農業區"},{"itemNo":24,"cityName":"宜蘭縣","distName":"南澳鄉"