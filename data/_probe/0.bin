peOther":""},{"itemNo":29,"cityName":"雲林縣","distName":"北港鎮","landNo":"北港段","landSerialNo":"1281-0006","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":30,"cityName":"雲林縣","distName":"北港鎮","landNo":"北港段","landSerialNo":"1281-0007","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":31,"cityName":"雲林縣","distName":"北港鎮","landNo":"北港段","landSerialNo":"1281-0008","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":32,"cityName":"雲林縣","distName":"北港鎮","landNo":"北港段","landSerialNo":"1281-0009","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":33,"cityName":"雲林縣","distName":"北港鎮","landNo":"北港段","landSerialNo":"1281-0010","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":34,"cityName":"雲林縣","distName":"北港鎮","landNo":"北港段","landSerialNo":"1281-0011","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":35,"cityName":"雲林縣","distName":"北港鎮","landNo":"北港段","landSerialNo":"1281-0012","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":36,"cityName":"雲林縣","distName":"北港鎮","landNo":"北港段","landSerialNo":"1281-0013","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":37,"cityName":"雲林縣","distName":"北港鎮","landNo":"北港段","landSerialNo":"1281-0014","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":38,"cityName":"雲林縣","distName":"北港鎮","landNo":"北港段","landSerialNo":"1284-0563","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20061222000006","mediaImageList":[{"mediaName":"古笨港遺址(2)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39476/photo/古笨港遺址(2).jpg"},{"mediaName":"古笨港遺址(3)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39477/photo/古笨港遺址(3).jpg"},{"mediaName":"古笨港遺址(4)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39478/photo/古笨港遺址(4).jpg"},{"mediaName":"古笨港遺址(5)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39479/photo/古笨港遺址(5).jpg"},{"mediaName":"古笨港遺址(6)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39480/photo/古笨港遺址(6).jpg"},{"mediaName":"古笨港遺址(7)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39481/photo/古笨港遺址(7).jpg"}],"documents":["https://data.boch.gov.tw/upload/documents/2021-08-31/856c2f82-27c3-43d3-b352-bd775e9393b6/中華民國95年12月22日 府文資字第0952401210號 古笨港遺址.pdf","https://data.boch.gov.tw/upload/documents/2026-05-20/97fe7101-abac-4cb9-b9bc-891dbd171e6b/1150226(函+公告)原指定古笨港遺址重新公告為古笨港考古遺址並修正指定理由及法令依據.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"中華民國"},{"ownerType":"土地所有人","ownerName":"李OO"},{"ownerType":"土地所有人","ownerName":"中華民國"},{"ownerType":"土地所有人","ownerName":"陳OO"},{"ownerType":"土地所有人","ownerName":"蔡O"},{"ownerType":"土地所有人","ownerName":"李OO"},{"ownerType":"土地所有人","ownerName":"李OO"},{"ownerType":"土地所有人","ownerName":"雲林縣"}],"govInstitution":"雲林縣政府","govDeptName":"文化觀光處","govDeptAddress":"雲林縣斗六市大學路三段310號","govDeptPhone":"05-5523157","repImgId":140257},{"caseId":"20090603000003","caseName":"魚寮考古遺址","assetsClassifyCode":"2.1.3","assetsClassifyName":"縣(市)定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","同類型遺址數量之稀有性"],"registerReason":"本遺址發現源起約在1940年前後，首見於鹿野忠雄「東南亞細亞民族學先史學研究」中，並由其命名為魚寮型遺址。該地有兩層不同時代的史前文化堆積，下層為繩紋紅陶文化牛稠子類型，上層的史前文化為大湖文化魚寮類型。魚寮遺址是嘉義平原地區最早發現的史前遺址之一，遺物內容非常豐富，文化特徵亦相當獨特，在考古學研究史上具有重要的意義；魚寮遺址具有文化期相的代表性，能夠代表嘉義平原地區新石器時代晚期的史前文化面貌，因此指定為縣定遺址。","lawsReference":"一、《文化資產保存法》第40條\n二、《遺址指定及廢止審查辦法》\n三、《文化資產保存法》105年7月27日公告修正第3條及第111條\n四、行政程序法第122條","govInstitutionName":"嘉義縣政府","addresses":[{"itemNo":1,"cityName":"嘉義縣","distName":"太保市","address":"白鴿厝段白鴿厝小段160"},{"itemNo":2,"cityName":"嘉義縣","distName":"太保市","address":"白鴿厝段白鴿厝小段161"},{"itemNo":3,"cityName":"嘉義縣","distName":"太保市","address":"白鴿厝段白鴿厝小段162"},{"itemNo":4,"cityName":"嘉義縣","distName":"太保市","address":"白鴿厝段白鴿厝小段163"},{"itemNo":5,"cityName":"嘉義縣","distName":"太保市","address":"白鴿厝段白鴿厝小段165"},{"itemNo":6,"cityName":"嘉義縣","distName":"太保市","address":"白鴿厝段白鴿厝小段166"},{"itemNo":7,"cityName":"嘉義縣","distName":"太保市","address":"白鴿厝段白鴿厝小段167"},{"itemNo":8,"cityName":"嘉義縣","distName":"太保市","address":"白鴿厝段白鴿厝小段170"},{"itemNo":9,"cityName":"嘉義縣","distName":"太保市","address":"白鴿厝段白鴿厝小段171"},{"itemNo":10,"cityName":"嘉義縣","distName":"太保市","address":"白鴿厝段白鴿厝小段172"},{"itemNo":11,"cityName":"嘉義縣","distName":"太保市","address":"白鴿厝段白鴿厝小段179"},{"itemNo":12,"cityName":"嘉義縣","distName":"太保市","address":"白鴿厝段白鴿厝小段182"},{"itemNo":13,"cityName":"嘉義縣","distName":"太保市","address":"白鴿厝段白鴿厝小段183"},{"itemNo":14,"cityName":"嘉義縣","distName":"太保市","address":"白鴿厝段白鴿厝小段184"}],"longitude":120.353611,"latitude":23.481388,"relativePosition":"魚寮聚落旁200公尺。","neighborPosition":"新埤大排旁","representImage":{"ext":"JPG","transform":{"c":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/37786/photo/90f1ac61-9e23-43ec-99a6-14454810bddd_c.JPG"},"original":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/37786/photo/90f1ac61-9e23-43ec-99a6-14454810bddd.JPG","name":"90f1ac61-9e23-43ec-99a6-14454810bddd"},"representImageSource":"嘉義縣政府","landScope":"太保市白鴿厝段白鴿厝小段160、161、162、163、165、166、167、170、171、172、179、182、183、184地號。東西長約560公尺，南北寬約560公尺，面積313,600平方公尺。","nearbyArcheologyCheck":"位於或鄰近普查遺址","nearbyArcheologyBrief":"無","cultralMean":"遺址範圍相當廣泛，且出土遺物相當豐富，同時包含有早晚期不同之文化層，其中上層之魚寮類型，出土遺物尤其豐富，具有區域性代表性文化類型之意義。","pastHistory":"本遺址發現起源於1940年前後，首見鹿野忠雄「東南亞細亞民族學先史學研究」中，並由其命名為魚寮型遺址。","actualStatus":"遺址目前為甘蔗田。","usageStatus":"以種植甘蔗淺耕為主。","landUsage":"現地保存。","announcementList":[{"classification":"變更/修正","officialDocNo":"府授文資字第1070107243號","registerDate":"2018-06-04 00:00:00.0"},{"classification":"指定/登錄","officialDocNo":"府文資字第0980088099號","registerDate":"2009-06-03 10:50:24.0"}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20090603000003","documents":["https://data.boch.gov.tw/upload/documents/2022-08-12/569d2ec7-a6ce-4d95-9080-f8f166875dae/魚寮遺址變更名稱公報20180604.pdf","https://data.boch.gov.tw/upload/documents/2022-08-18/e4e042c6-5ff3-438a-aaa8-f6b3b75d335e/魚寮遺址公告2009.06.03.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"臺灣糖業公司有限公司"}],"govInstitution":"嘉義縣政府","govDeptName":"嘉義縣文化觀光局文化資產科","govDeptAddress":"61248嘉義縣太保市東勢里太子大道158號","govDeptPhone":"05-3628123-318","repImgId":4553},{"caseId":"20060502000002","caseName":"麻豆水堀頭遺址","assetsClassifyCode":"2.1.2","assetsClassifyName":"直轄市定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性","具其他遺址價值者"],"registerReason":"具有「遺址指定及廢止審查辦法」第3條指定之基準","lawsReference":"依據文化資產保存法第40條","govInstitutionName":"臺南市政府","addresses":[{"itemNo":1,"cityName":"臺南市","distName":"麻豆區","address":"臺南市麻豆區溝子墘段40-2地號、麻豆段115-5地號"}],"longitude":120.26978,"latitude":23.191059,"relativePosition":"176號道路台糖加油站北側、臺灣首府大學南側","neighborPosition":"176號道路台糖加油站、臺灣首府大學","representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/upload/representImageFile/2025-06-23/e25a848a-69b3-4c0f-b4df-508621eb5b86/考古遺址001麻豆水堀頭遺址_P001_c.jpg"},"original":"https://data.boch.gov.tw/upload/representImageFile/2025-06-23/e25a848a-69b3-4c0f-b4df-508621eb5b86/考古遺址001麻豆水堀頭遺址_P001.jpg","name":"考古遺址001麻豆水堀頭遺址_P001"},"representImageSource":"臺南市政府","landScope":"臺南市麻豆區溝子墘段40-2地號、麻豆段115-5地號上之三合土遺構。","nearbyArcheologyCheck":"位於或鄰近列冊遺址","nearbyArcheologyBrief":"位居西寮遺址東南方。","cultralMean":"本遺址為地方上民間信仰地點，目前確認有大湖文化層與清領時期地層，除了確認該地點史前文化人類活動狀況外，亦為清領時期與古碼頭相關的遺址，具有研究漢人早期開發史之重要意義。","pastHistory":"(一)麻豆港位於水堀頭，其名見於蔣毓英（台灣府志）的康熙二十六年（西元一六八七年）左右，又康熙五十六年編撰完成的諸羅縣誌記載：「麻豆港、海汊，商船到此載糖、菁貨物」，而乾隆二十年（西元一七五五年）麻豆港道淤塞，因此麻豆港水堀頭遺址之三合土建構，創建年代及其上層人群生活遺留之文化層，約介於十八世紀中葉至十九世紀初期，相當於清乾隆年間至道光年間。較早之地層應屬清領初期之文化遺留。較早之地層應屬清領初期之文化遺留。\r\n(二)1942年國分直一曾指出麻豆水堀頭地區發現巴圖形石器。\r\n(三)2002-2003年臺南市政府委託中央研究院林玉茹、劉益昌進行「水堀頭遺址探勘試掘暨麻豆港歷史調查研究計畫」之歷史與考古學研究，其中首度以考古發掘方式進行地方上爭議多年的疑似古碼頭三合土遺跡之研究。\r\n(四)2008年再次委託劉益昌進行「麻豆水堀頭遺址考古調查發掘研究計畫」，清理原鳳池周遭之古碼頭區域，並進行古航道區地層探勘，確認大湖文化層之存在。","actualStatus":"麻豆水堀頭遺址之三合土結構部分埋藏地下，可見部份大致完好。其週遭地區，目前為「麻豆古港暨水堀頭史蹟文化園區」。","usageStatus":"本遺址三合土建構及其週遭土地，臺南市政府徵收為「麻豆古港暨水堀頭史蹟文化園區」。","landUsage":"A.屬農業區地目，毗鄰國有地溝子墘段39之1、之2、之3、之4、之5、之8、之10地目旱，及39之11地目水道。\r\nB.本遺址三合土建構及其週遭土地，原台南縣政府徵收為「麻豆古港暨水堀頭史蹟文化園區。","announcementList":[{"classification":"指定/登錄","officialDocNo":"府文資字第0950092107號","registerDate":"2006-05-02 10:53:26.0"}],"landlotList":[{"itemNo":1,"cityName":"臺南市","distName":"麻豆區","landNo":"溝子墘段","landSerialNo":"40-2地號","landownership":"","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":2,"cityName":"臺南市","distName":"麻豆區","landNo":"溝子墘段","landSerialNo":"115-5地號","landownership":"","cityLandUseTypeOther":"","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20060502000002","mediaImageList":[{"mediaName":"麻豆水堀頭遺址1","description":"109年委託博典拍攝，114年上傳。","url":"https://data.boch.gov.tw/upload/media/2025-06-23/6a2f66b1-b9cc-4df5-aac6-a38ab9d74beb/考古遺址001麻豆水堀頭遺址_P001.jpg"},{"mediaName":"麻豆水堀頭遺址2","description":"109年委託博典拍攝，114年上傳。","url":"https://data.boch.gov.tw/upload/media/2025-06-23/10a1a1cf-4684-45d0-8e86-2674e05fac27/考古遺址001麻豆水堀頭遺址_P002.jpg"},{"mediaName":"麻豆水堀頭遺址3","description":"109年委託博典拍攝，114年上傳。","url":"https://data.boch.gov.tw/upload/media/2025-06-23/3ddd936e-3fb4-4221-907e-37b00fd280f5/考古遺址001麻豆水堀頭遺址_P003.jpg"},{"mediaName":"麻豆水堀頭遺址4","description":"109年委託博典拍攝，114年上傳。","url":"https://data.boch.gov.tw/upload/media/2025-06-23/69ad5a6a-77dc-4e42-84ce-bb8208dc2636/考古遺址001麻豆水堀頭遺址_P004.jpg"},{"mediaName":"麻豆水堀頭遺址5","description":"109年委託博典拍攝，114年上傳。","url":"https://data.boch.gov.tw/upload/media/2025-06-23/f84b47fc-a6e8-4b45-9bc4-7112a0bfd645/考古遺址001麻豆水堀頭遺址_P005.jpg"},{"mediaName":"麻豆水堀頭遺址6","description":"109年委託博典拍攝，114年上傳。","url":"https://data.boch.gov.tw/upload/media/2025-06-23/646cdc7c-df99-48ca-97e6-dee6efdfcd3c/考古遺址001麻豆水堀頭遺址_P006.jpg"},{"mediaName":"麻豆水堀頭遺址7","description":"109年委託博典拍攝，114年上傳。","url":"https://data.boch.gov.tw/upload/media/2025-06-23/13e84c97-3eb5-4cbd-893c-38887cb0ca36/考古遺址001麻豆水堀頭遺址_P007.jpg"},{"mediaName":"麻豆水堀頭遺址8","description":"109年委託博典拍攝，114年上傳。","url":"https://data.boch.gov.tw/upload/media/2025-06-23/32852661-a8d2-4e61-a956-88353c131bc9/考古遺址001麻豆水堀頭遺址_P008.jpg"},{"mediaName":"麻豆水堀頭遺址9","description":"109年委託博典拍攝，114年上傳。","url":"https://data.boch.gov.tw/upload/media/2025-06-23/ef766ec9-b071-48cf-b9b9-d7b7f4818931/考古遺址001麻豆水堀頭遺址_P009.jpg"},{"mediaName":"麻豆水堀頭遺址10","description":"109年委託博典拍攝，114年上傳。","url":"https://data.boch.gov.tw/upload/media/2025-06-23/93bd424c-96a6-40e6-8b6a-32cd23266ec2/考古遺址001麻豆水堀頭遺址_P010.jpg"}],"documents":["https://data.boch.gov.tw/upload/documents/2021-06-28/aea1e602-e9cd-4bc3-90d6-bc2c10a95af7/道爺古墓.道爺南糖部遺址.麻豆水堀頭遺址公告-P.1.jpeg","https://data.boch.gov.tw/upload/documents/2021-06-28/b76dbe1b-acf1-4e77-aa2c-de288bfdf29c/道爺古墓.道爺南糖部遺址.麻豆水堀頭遺址公告-P.2.jpeg","https://data.boch.gov.tw/upload/documents/2021-06-28/1bf880d0-19e2-42c0-a549-5890513ed53b/道爺古墓.道爺南糖部遺址.麻豆水堀頭遺址公告-P.3.jpeg","https://data.boch.gov.tw/upload/documents/2021-06-28/81842de4-3166-4fe4-92b6-17ca5297f399/道爺古墓.道爺南糖部遺址.麻豆水堀頭遺址公告-P.4.jpeg","https://data.boch.gov.tw/upload/documents/2021-06-28/ccb77358-a78e-4c43-8609-1d55a5639a7e/道爺古墓.道爺南糖部遺址.麻豆水堀頭遺址公告-P.5.jpeg"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"中華民國"}],"govInstitution":"臺南市文化資產管理處","govDeptName":"有形文化資產組","govDeptAddress":"臺南市中西區中正路五巷一號3F","govDeptPhone":"06-2213569、06-2213597、06-2210750、06-2217052","repImgId":288822},{"caseId":"20091019000004","caseName":"瘦砂遺址","assetsClassifyCode":"2.1.2","assetsClassifyName":"直轄市定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性"],"registerReason":"「瘦砂遺址」包含三層文化層，出土遺物及生態遺物豐富，其中大湖文化保存豐富，狀態良好。","lawsReference":"文化資產保存法第40條","govInstitutionName":"臺南市政府","addresses":[{"itemNo":1,"cityName":"臺南市","distName":"新市區","address":"臺南市新市區三舍里"}],"longitude":120.261388,"latitude":23.099444,"representImage":{"ext":"gif","transform":{"c":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/37944/photo/57781cda-8f05-4903-ae26-336831a0d5a9_c.gif"},"original":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/37944/photo/57781cda-8f05-4903-ae26-336831a0d5a9.gif","name":"57781cda-8f05-4903-ae26-336831a0d5a9"},"representImageSource":"中央研究院歷史語言研究所.國立台灣史前文化博物館提供","landScope":"臺南市新市區新晶段70-0、75-0等2筆地號","nearbyArcheologyCheck":"位於或鄰近列冊遺址","nearbyArcheologyBrief":"道爺遺址\r\n東經120º15\u002753”；北緯23º6\u00275”\r\n2 ºTM：E175500×N2555500m\r\n位於堤塘港、柑港匯流處東北側，現今為園區公15保護用地、環3用地南側及其東側之變2、公7用地。區地勢平坦，遺留所在地層屬砂頁岩沖積砂壤土，上方覆砂頁岩沖積坋壤土。\r\n蔦松文化鞍子類型／近代漢人文化（約1800-1400／＜300B.P）\r\n\r\n道爺南遺址\r\n東經120º15\u002757”；北緯23º5\u002753”\r\n2 ºTM：E174800×N2555350m\r\n位於堤塘港、柑港匯流處東南岸，全區地勢平坦，堤塘港呈一曲流，而遺址即位於南側攻擊坡側。全區地勢平坦，土質上層為砂頁岩沖積砂壤土，下層屬砂頁岩沖積黏壤土。\r\n大湖文化大湖類型／大湖文化烏山頭類型／蔦松文化蔦松類型／近代漢人文化\r\n（約3300~2800／2800~2000／1400~1000／＜300B.P）","cultralMean":"1.具多文化層\r\n2.大湖文化層遺留豐富，保存狀況佳。\r\n3.鞍子類型分佈範圍廣。","pastHistory":"瘦砂遺址\r\n共見有三層史前文化遺留堆積，上文化層屬蔦松文化鞍子類型，分布範圍最廣，遺留沿柑港及堤塘港分布，向內岸延伸約200公尺，整體呈倒L型分布；埋藏深度北側較高，約在海拔2.5公尺，西南側近堤塘港岸約1.5公尺左右，文化層厚度約20公分左右；中層為大湖文化烏山頭類型，分布範圍僅在公滯5東側一帶，分布密度低，分布深度約海拔下0~0.3公尺左右。下層屬大湖文化大湖類型，同樣僅分布於公滯5東側，但範圍較中層更向東擴大，文化層深度約在海拔下1.3公尺左右，厚度約40公分。","actualStatus":"現為樹谷園區綠4及公滯5用地，保存狀況佳。","usageStatus":"現為樹谷園區綠4及公滯5用地，保存狀況佳。","landUsage":"現地保存，由由台南市政府管理。","announcementList":[{"classification":"指定/登錄","officialDocNo":"府文資字第0980252232A號、B號","registerDate":"2009-10-19 15:45:05.0"}],"landlotList":[{"itemNo":1,"cityName":"臺南市","distName":"新市區","landNo":"新晶段","landSerialNo":"70-0地號","landownership":"","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":2,"cityName":"臺南市","distName":"新市區","landNo":"新晶段","landSerialNo":"75-0地號","landownership":"","cityLandUseTypeOther":"","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20091019000004","documents":["https://data.boch.gov.tw/upload/documents/2021-06-28/2b60dd5e-030d-46f1-9566-8c2494a9d0bc/公告-P1.jpeg","https://data.boch.gov.tw/upload/documents/2021-06-28/3b3f41e3-d8b9-4a13-b5fb-0c964e7a415b/公告-P2.jpeg","https://data.boch.gov.tw/upload/documents/2021-06-28/60798f2b-7781-4464-87f1-bc62087c1260/公告-P3.jpeg"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"中華民國"}],"govInstitution":"臺南市文化資產管理處","govDeptName":"有形文化資產組","govDeptAddress":"臺南市中西區中正路五巷一號3F","govDeptPhone":"06-2213569、06-2213597、06-2210750、06-2217052","repImgId":4555},{"caseId":"20091019000005","caseName":"五間厝南遺址","assetsClassifyCode":"2.1.2","assetsClassifyName":"直轄市定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","遺址保存狀況之完整性"],"registerReason":"「五間厝南遺址」，有黑陶文化等文化層，具多樣性，內涵豐富且保存狀況良好，具文化期相之代表性。","lawsReference":"文化資產保存法第40條","govInstitutionName":"臺南市政府","addresses":[{"itemNo":1,"cityName":"臺南市","distName":"新市區","address":"臺南市新市區三舍里"}],"longitude":120.270833,"latitude":23.090555,"representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39469/photo/5555_c.jpg"},"original":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39469/photo/5555.jpg","name":"5555"},"representImageSource":"中央研究院歷史語言研究所.國立台灣史前文化博物館提供","landScope":"臺南市新市區新科段215-0等1筆地號","nearbyArcheologyCheck":"位於或鄰近列冊遺址","nearbyArcheologyBrief":"五間厝遺址\r\n東經120º16\u002725”；北緯23º5\u002739”\r\n2 ºTM：E175600×N2554915m\r\n遺址位於南科一路、南科南路交界處至大洲排水間，東側專24用地大億科技西側見一南北向淤積古河道並注入大洲溪，遺址即位於兩河匯流處西岸，現今屬專22用地。地勢平坦，略向東南傾，上層土質屬砂頁岩沖積砂壤土，厚度約1.5~1.8公尺，與下層坋壤土層呈不整合接觸。\r\n大湖文化烏山頭類型／蔦松文化蔦松類型／西拉雅文化\r\n（約2800~2000B.P.／1400~1000B.P.／500~300B.P.）","cultralMean":"1.具多層文化遺留。\r\n2.與大道公遺址可完整代表南科園區晚期史前文化內容。\r\n3.埋藏深，保存狀況良好。","pastHistory":"1.2003/2/11臺南科學工業園區道爺遺址未劃入保存區部份搶救考古計劃計畫鑽探發現。\r\n2.2003/3/1~2003/5/25臺南科學工業園區道爺遺址未劃入保存區部份搶救考古計畫搶救發掘。","actualStatus":"1.遺址西側專35用地業經搶救發掘。\r\n2.遺址東側綠26用地規劃為公園綠地，且遺留埋藏深，保存狀況良好。","usageStatus":"遺址西側業經搶救發掘，東側為馬路覆蓋及綠地，保存狀況佳。","landUsage":"現地保存，由南部科學工業園區管理局管理。","announcementList":[{"classification":"指定/登錄","officialDocNo":"府文資字第0980252232A號、B號","registerDate":"2009-10-19 15:18:50.0"}],"landlotList":[{"itemNo":1,"cityName":"臺南市","distName":"新市區","landNo":"新科段","landSerialNo":"215-0地號","landownership":"","cityLandUseTypeOther":"","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20091019000005","documents":["https://data.boch.gov.tw/upload/documents/2021-06-28/074c3590-a80f-426e-9c3a-102507ad6872/公告-P1.jpeg","https://data.boch.gov.tw/upload/documents/2021-06-28/8a9e771a-992f-4a6e-b69e-7b2f4502fb46/公告-P2.jpeg","https://data.boch.gov.tw/upload/documents/2021-06-28/1cbf384d-2fac-4b7a-aeb2-906a7b244d1c/公告-P3.jpeg"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"中華民國"}],"govInstitution":"臺南市文化資產管理處","govDeptName":"有形文化資產組","govDeptAddress":"臺南市中西區中正路五巷一號3F","govDeptPhone":"06-2213569、06-2213597、06-2210750、06-2217052","repImgId":4556},{"caseId":"20091019000006","caseName":"新市．木柵遺址","assetsClassifyCode":"2.1.2","assetsClassifyName":"直轄市定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址供展示教育規劃之適當性"],"registerReason":"「新市．木柵遺址」代表近代漢人文化，在區域發展史上，有其明確意義，具歷史考古研究價值，值得保存。","lawsReference":"文化資產保存法第40條","govInstitutionName":"臺南市政府","addresses":[{"itemNo":1,"cityName":"臺南市","distName":"新市區","address":"臺南市新市區豐華里"}],"longitude":120.256388,"latitude":23.106111,"representImage":{"ext":"JPG","transform":{"c":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/37945/photo/2ceeb71d-f269-4f64-96d8-248de770a972_c.JPG"},"original":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/37945/photo/2ceeb71d-f269-4f64-96d8-248de770a972.JPG","name":"2ceeb71d-f269-4f64-96d8-248de770a972"},"representImageSource":"中央研究院歷史語言研究所.國立台灣史前文化博物館提供","landScope":"臺南市新市區新科段71-0、72-0等2筆地號","nearbyArcheologyCheck":"位於或鄰近列冊遺址","nearbyArcheologyBrief":"(一)木柵西遺址：\r\n東經120º15\u002710”；北緯23º6\u002723” \r\n2 ºTM：E173460×N2556260m\r\n位於木柵港南岸，木柵遺址西側，現位於樹谷大道與活水路交會口南北兩側。全區地勢平坦，土質上層屬砂頁岩沖積砂壤土，下層為砂頁岩沖積坋壤土。\r\n蔦松文化蔦松類型（約1400~1000B.P.）\r\n(二)柑港遺址：\r\n東經120º16\u00279”；北緯23º6\u002727” \r\n2 ºTM：E175129×N2556360m\r\n位於柑港上游右（西）岸及木柵港上游北岸之間，原南135線東側，現今位於南科園區南科七路與三抱竹路交叉路口及其南側之水6、變4及停18用地內。全區地勢平坦。上層土質屬砂頁岩砂壤土，下層屬砂頁岩沖積坋壤土。\r\n蔦松文化蔦松類型／近代漢人文化（約1400~1000B.P.／\u003c300B.P.）","cultralMean":"1.文獻中木柵街及木柵汛防所在。\r\n2.南科園區內大型近代漢人文化遺址。\r\n3.康熙末年清軍與朱一貴軍曾大戰於此，見歷史意義。","pastHistory":"1.2005年4月南科液晶電視及產業支援工業區考古鑽探計畫鑽探發現。\r\n2.2007/9/20~2007/10/15南科液晶電視及產業支援工業區考古遺址受開發影響部份搶救發掘計畫項下搶救發掘。","actualStatus":"西側樹谷園區部分業經搶救發掘，東側南科園區部分規劃為公園綠地（公33）。","usageStatus":"現今東側為公33生態保育用地，西側為樹谷園區相關產業用地已搶救。","landUsage":"現地保存，由南部科學工業園區管理局管理。","announcementList":[{"classification":"指定/登錄","officialDocNo":"府文資字第0980252232A號.B號","registerDate":"2009-10-19 15:35:48.0"}],"landlotList":[{"itemNo":1,"cityName":"臺南市","distName":"新市區","landNo":"新科段","landSerialNo":"71-0地號","landownership":"","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":2,"cityName":"臺南市","distName":"新市區","landNo":"新科段","landSerialNo":"72-0地號","landownership":"","cityLandUseTypeOther":"","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20091019000006","documents":["https://data.boch.gov.tw/upload/documents/2021-06-28/aa4d5877-a714-4804-8c9b-8de86fb11069/公告-P1.jpeg","https://data.boch.gov.tw/upload/documents/2021-06-28/194fb6e0-0d90-49cb-a541-5cb89c0426ea/公告-P2.jpeg","https://data.boch.gov.tw/upload/documents/2021-06-28/b4c954f5-d8dc-44f6-bfce-f85c94d83842/公告-P3.jpeg"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"中華民國"},{"ownerType":"土地所有人","ownerName":"中華民國"}],"govInstitution":"臺南市文化資產管理處","govDeptName":"有形文化資產組","govDeptAddress":"臺南市中西區中正路五巷一號3F","govDeptPhone":"06-2213569、06-2213597、06-2210750、06-2217052","repImgId":4557},{"caseId":"20060502000003","caseName":"道爺南糖廍遺址","assetsClassifyCode":"2.1.2","assetsClassifyName":"直轄市定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性","具其他遺址價值者"],"registerReason":"具有「遺址指定及廢止審查辦法」第3條指定之基準","lawsReference":"文化資產保存法第40條","govInstitutionName":"臺南市政府","addresses":[{"itemNo":1,"cityName":"臺南市","distName":"新市區","address":"南部科學工業園區專35用地北側,位居南科三路、環西路一段交叉處之西側"}],"longitude":120.275058,"latitude":23.097496,"relativePosition":"南部科學工業園區第一高架水塔西南側","neighborPosition":"南部科學工業園區第一高架水塔","representImage":{"ext":"JPG","transform":{"c":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/37946/photo/73be07e9-2e64-4f47-8964-c61708bfb57c_c.JPG"},"original":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/37946/photo/73be07e9-2e64-4f47-8964-c61708bfb57c.JPG","name":"73be07e9-2e64-4f47-8964-c61708bfb57c"},"representImageSource":"臺南市政府","landScope":"臺南市新市區道爺段571-10、571-13地號廍灶及其他相關現象,如灰坑、溝渠等之分布範圍東西長40公尺、寬約20公尺,面積約800平方公尺。","nearbyArcheologyCheck":"位於或鄰近列冊遺址","nearbyArcheologyBrief":"道爺南遺址位居道爺遺址南側，文化層有大湖文化、蔦松文化、近代漢人文化。","cultralMean":"(一)台灣自荷蘭時期以迄民國70年，數百年來製糖是最重要的農工業之一。由於糖廍屬臨時建築，製糖後即予以拆除，出土的四組連灶，花條形火燒紅土面可證明糖廍之存在實證。此遺蹟見證了先民製糖的方法，是台灣目前唯一的發現，相當珍奇而可貴，就特殊性、稀有性而言，皆有其獨異處，亦具產業文化象徵與意義。\r\n(二)南科園內已發現的史前遺址多處，唯歷史時期遺蹟罕見，此為南科園區第一次發現的糖灶，也是全台灣第一次出現四組土窯糖灶，彌足珍貴。\r\n(三)糖廍遺蹟根據文獻圖繪可以復原，具有社教及公開展示及現地保存的價值。\r\n(四)南科史前文化遺蹟豐富，連灶遺蹟更能解釋埔漢文化之互動，值得保留。\r\n(五)此遺蹟位在路旁，且和北側生態公園相鄰、與東北側發現道爺古墓距離相近。可連貫成南科園區內歷史、文化、休憩、綜合綠帶。","pastHistory":"由於糖廍屬臨時建築，製糖時節後即予以拆除，發掘過程中並未發現有足以斷定確切年代之證據，惟由伴隨出土之遺物中見厚胎安平壺等屬於清領初期至清領中期之遺物，初步判斷年代約在18世紀左右。","actualStatus":"原台南縣政府文化局已辦理完成「糖廍強固維護計畫」，將糖廍之土埆結構，以矽酸酯（silicic acid ester）和OH100等材質強固後，完成回填保護作業。","usageStatus":"因恐雨水沖刷損毀，已完成道爺南糖廍強固維護計畫後，目前敷蓋保護。","landUsage":"「道爺南糖廍遺址」，所有人為國有，土地管理者為南部科學工業園區管理局。南部科學工業園區事業專用區。","announcementList":[{"classification":"指定/登錄","officialDocNo":"府文資字第0950092107","registerDate":"2006-05-02 09:51:09.0"}],"landlotList":[{"itemNo":1,"cityName":"臺南市","distName":"新市區","landNo":"道爺段","landSerialNo":"571-10地號","landownership":"","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":2,"cityName":"臺南市","distName":"新市區","landNo":"道爺段","landSerialNo":"571-13地號","landownership":"","cityLandUseTypeOther":"","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20060502000003","documents":["https://data.boch.gov.tw/upload/documents/2021-06-28/73db9aca-a64a-4592-a521-7ecb595d8723/道爺古墓.道爺南糖部遺址.麻豆水堀頭遺址公告-P.1.jpeg","https://data.boch.gov.tw/upload/documents/2021-06-28/f3b87198-1e92-4df4-96ce-bbde718aedf1/道爺古墓.道爺南糖部遺址.麻豆水堀頭遺址公告-P.2.jpeg","https://data.boch.gov.tw/upload/documents/2021-06-28/6327ef2b-6ce5-433d-9f04-22984da4f84a/道爺古墓.道爺南糖部遺址.麻豆水堀頭遺址公告-P.3.jpeg","https://data.boch.gov.tw/upload/documents/2021-06-28/dc6b0a52-25c1-4ac9-8383-a94db3185be6/道爺古墓.道爺南糖部遺址.麻豆水堀頭遺址公告-P.4.jpeg","https://data.boch.gov.tw/upload/documents/2021-06-28/abb5f1f5-9dca-4627-ab5e-bc871357a1c7/道爺古墓.道爺南糖部遺址.麻豆水堀頭遺址公告-P.5.jpeg"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"中華民國"}],"govInstitution":"臺南市文化資產管理處","govDeptName":"有形文化資產組","govDeptAddress":"臺南市中西區中正路五巷一號3F","govDeptPhone":"06-2213569、06-2213597、06-2210750、06-2217052","repImgId":4558},{"caseId":"20100428000002","caseName":"東沙考古遺址","assetsClassifyCode":"2.1.2","assetsClassifyName":"直轄市定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性"],"registerReason":"1.「東沙考古遺址」位於南海島群－東沙群島－東沙島之潟湖中段，為十八世紀晚期至十九世紀-清朝中晚期遺址。\n文化遺物有：陶器(橄欖綠釉唇口罐、素燒磨研器、堆貼龍紋折沿口褐釉盆、褐釉硬陶片、素燒陶壺)、瓷器(青花瓷碗、青花瓷盤、青花瓷杯)、金屬器(鐵釘、銅鈴)、生態遺留(獸骨)、岩石(石英石塊)等，由出土遺物發現明顯的文化層、遺跡現象與爐灶、陶瓷相關遺留，屬漁民多次性利用的臨時性的居留遺址。\n2.本案於民國107年(2018)11月28日重新公告變更名稱為「考古遺址」(高市府文資字第10732037810號函)","lawsReference":"\u003c\u003c遺址指定及廢止審查辦法\u003e\u003e第3條第1項第1、2、3、4、5款","govInstitutionName":"高雄市政府","addresses":[{"itemNo":1,"cityName":"高雄市","distName":"旗津區","address":"高雄市旗津區東沙段85地號"}],"longitude":116.72,"latitude":20.706111,"relativePosition":"東經116°43’12 ”北緯20°42’22 ”","neighborPosition":"東沙機場","representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/upload/representImageFile/2020-12-03/5a052070-69a3-4458-afdb-29899046a803/東沙考古遺址_c.jpg"},"original":"https://data.boch.gov.tw/upload/representImageFile/2020-12-03/5a052070-69a3-4458-afdb-29899046a803/東沙考古遺址.jpg","name":"東沙考古遺址"},"representImageSource":"高雄市政府文化局","landScope":"高雄市旗津區東沙段85-1、85-2地號，土地總面積6,706平方公尺。\n","nearbyArcheologyCheck":"位於或鄰近普查遺址","nearbyArcheologyBrief":"無","cultralMean":"由出土遺物發現明顯的文化層、遺跡現象與爐灶、陶瓷相關遺留，判斷屬於漁民多次性利用的臨時性的居留遺址。","pastHistory":"1.2006年11月13日核定成立台灣第一座海洋型國家公園為「東沙環礁國家公園」。\r\n2.2007年10月4日於高雄市都會公園成立「海洋國家公園管理處」。","actualStatus":"四周目前均為草海桐等雜林，地表可見零星陶瓷碎片。","usageStatus":"遺址範圍四周目前均為草海桐等雜林。","landUsage":"遺址範圍四周目前均為草海桐等雜林。","announcementList":[{"classification":"變更/修正","officialDocNo":"高市府文資字第10732037810號","registerDate":"2018-11-28 15:52:09.647","note":"重新公告文化資產類別名稱為「考古遺址」"},{"classification":"指定/登錄","officialDocNo":"高市府文二字第0990024136號","registerDate":"2010-04-28 00:00:00.0","note":"公告為市定遺址"}],"landlotList":[{"itemNo":1,"cityName":"高雄市","distName":"旗津區","landNo":"東沙段","landSerialNo":"85-1","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":2,"cityName":"高雄市","distName":"旗津區","landNo":"東沙段","landSerialNo":"85-2","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20100428000002","mediaImageList":[{"mediaName":"東沙考古遺址","url":"https://data.boch.gov.tw/upload/media/2020-12-03/0c7e427f-aecd-4481-84dc-b5fb0903a751/20121011150755558.jpg"},{"mediaName":"東沙考古遺址","url":"https://data.boch.gov.tw/upload/media/2020-12-03/ddd06aa6-1dcd-4b2b-abda-03a64c33467b/20121011150755449.jpg"},{"mediaName":"東沙考古遺址","url":"https://data.boch.gov.tw/upload/media/2020-12-03/720e0623-2b7f-412b-b931-9991c8824685/20121011150755324.jpg"},{"mediaName":"東沙考古遺址","url":"https://data.boch.gov.tw/upload/media/2020-12-03/c7189075-1de2-4971-92c5-fb4661d9f3ed/20121011150755199.jpg"},{"mediaName":"東沙考古遺址","url":"https://data.boch.gov.tw/upload/media/2020-12-03/3e5e61b4-4a9a-464d-b448-ae316be0e39c/20121011150755028.jpg"}],"documents":["https://data.boch.gov.tw/upload/documents/2020-12-03/b0bbbd5d-eb7a-4b4e-9103-d883cb121941/2.1071128-東沙考古遺址.pdf","https://data.boch.gov.tw/upload/documents/2020-12-03/188da129-ef63-492c-b1f5-3b68f362025b/2.990428-東沙考古遺址.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"中華民國"}],"govInstitution":"高雄市政府文化局","govDeptName":"文化資產中心","govDeptAddress":"高雄市苓雅區五福一路67號","govDeptPhone":"07-2225136*8426","repImgId":77549},{"caseId":"20060501000005","caseName":"鳳鼻頭（中坑門）考古遺址","assetsClassifyCode":"2.1.1","assetsClassifyName":"國定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","遺址文化堆積內涵之特殊性及豐富性","遺址供展示教育規劃之適當性","遺址供展示教育規劃之適當性","具其他遺址價值者","具其他遺址價值者"],"registerReason":"1、鳳鼻頭(中坑門)遺址位於本市林園區中門村中坑門聚落北側，鳳山丘陵南端前緣緩坡處，為一處海升後沖積平原所形成的台地，至今約有3500~2000年的歷史，在日治末期由日人考古學者坪井清足於挖掘壕溝時被發現，民國54年(1965)張光直先生曾有計畫發掘得知本遺址有大坌坑文化、繩紋紅陶文化、夾砂紅、灰陶文化等不同文化，遺址面積亦廣，為台灣地區重要的史前遺址之一。\n2、民國79年(1990)中研院史語所劉益昌與黃士強兩位教授針對遺址範圍與文化做研究，其所出土的遺物為台灣南部地區最早發現的，並含蓋有新石器時代早期至晚期之大坌坑文化、牛稠子文化鳳鼻頭型及鳳鼻頭文化等三個文化層，呈現台灣西南部史前文化之發展。（備註：2000年2月11日公告為國定古蹟，民國95年(2006)5月1日變更為國定遺址）","lawsReference":"文化資產保存法第102條規定辦理(民國94年公佈)","govInstitutionName":"文化部","addresses":[{"itemNo":1,"cityName":"高雄市","distName":"林園區","address":"中坑門聚落北側約350公尺處"}],"longitude":120.36915,"latitude":22.511367,"relativePosition":"","neighborPosition":"","representImage":{"ext":"JPG","transform":{"c":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39435/photo/鳳鼻頭_c.JPG"},"original":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39435/photo/鳳鼻頭.JPG","name":"鳳鼻頭"},"representImageSource":"文化部文化資產局","landScope":"林園區龔林段996等地號86筆，及柚子腳段1地號，共計87筆土地，面積計為97453.31平方公尺","nearbyArcheologyCheck":"位於或鄰近普查遺址","nearbyArcheologyBrief":"無","cultralMean":"1.文化類型多樣化。\r\n2.文化層堆積厚。\r\n3.類型中之鳳鼻頭類型具期相代表性且出現頻率低。\r\n4.首先建立南部史前文化層序之遺址，具考古學術史之意義。","pastHistory":"1、鳳鼻頭（中坑門）遺址位於本市林園區中門里中坑門聚落北側，鳳山丘陵南端前緣緩坡處，為一處海升後沖積平原所形成的台地，至今約有3500~2000年的歷史，在日治末期由日人考古學者坪井清足於挖掘壕溝時被發現，民國54年張光直先生曾有計畫發掘得知本遺址有大坌坑文化、繩紋紅陶文化、夾砂紅、灰陶文化等不同文化，遺址面積亦廣，為台灣地區重要的史前遺址之一。\r\n2、民國79年中研院史語所劉益昌與黃士強兩位教授針對遺址範圍與文化做研究，其所出土的遺物為台灣南部地區最早發現的，並含蓋有新石器時代早期至晚期之大坌坑文化、牛稠子文化鳳鼻頭型及鳳鼻頭文化等三個文化層，呈現台灣西南部史前文化之發展。","actualStatus":"遺址現況分布有果園、植栽及墓葬等，地主自行維護其果園用地，日常維護人員清掃遺址範圍內產業道路垃圾，路旁雜草整修；大雨過後，易雜草叢生再另雇工協助日常管理維護人員共同清理，並注意排水情形及路面污泥清除，以維持排水通暢及環境整潔。","usageStatus":"1.本遺址未來管理維護及發展方向經中央遺址審議委員會第一次臨時會議討論結果，將朝遺址公園方向發展。因此，為發展遺址公園並兼顧民眾財產權益，首要，應將遺址範圍內土地公有化，以彰顯對於本遺址保存之積極性及重要性。\r\n2.因面臨遺址周邊都市土地重劃開發，未來鳳鼻頭遺址發展腹地受侷限，未來發展操作原則擬以公告範圍作為遺址公園區，同時以縣府王公廟段區段徵收保留未標售之第207標土地變更使用分區為公共設施用地，以供設置遺址公園區展示館（陳列室）之用，著重生態環功能，建立教育展示中心，作為民眾生活教育之活教材。\r\n3.透過鳳鼻頭遺址文化價值的認定及重構，可結合社區或民間團體，共同將鳳鼻頭遺址所形成遺址園區發展成高雄地區重要的文化資產。","landUsage":"果園、植栽及墓葬等。","announcementList":[{"classification":"變更/修正","officialDocNo":"文授資局物字第11030085563號","registerDate":"2021-08-17 13:44:02.071","note":"公告調整定著土地地號"},{"classification":"變更/修正","officialDocNo":"文授資局物字第10630129932號","registerDate":"2017-11-17 15:35:21.038","note":"重新公告類別名稱"},{"classification":"指定/登錄","officialDocNo":"文資籌研字第09500017951號","registerDate":"2006-05-01 15:55:42.0"}],"landlotList":[{"itemNo":1,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"996","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":2,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"997","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":3,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"998","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":4,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"999","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":5,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1000","landownership":"公有","cityLandUseType":"保存區"},{"itemNo":6,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1001","landownership":"公有","cityLandUseType":"保存區"},{"itemNo":7,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1002","landownership":"公有","cityLandUseType":"保存區"},{"itemNo":8,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1003","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":9,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1004","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":10,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1005","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":11,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1006","landownership":"公有","cityLandUseType":"保存區"},{"itemNo":12,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1007","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":13,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1008","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":14,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1009","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":15,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1010","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":16,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1011","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":17,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1012","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":18,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1013","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":19,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1014","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":20,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1015","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":21,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1016","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":22,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1017","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":23,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"1018","landownership":"私有","cityLandUseType":"保存區"},{"itemNo":24,"cityName":"高雄市","distName":"林園區","landNo":"龔林段","landSerialNo":"101