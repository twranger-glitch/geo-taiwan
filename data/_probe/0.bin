{"created": "2026-10-22T02:38:01.964968+00:00", "modified": "2026-10-22T02:38:02.151608+00:00", "id": 23551543, "conceptrecid": "20047818", "doi": "10.5281/zenodo.23551543", "conceptdoi": "10.5281/zenodo.20047818", "doi_url": "https://doi.org/10.5281/zenodo.23551543", "metadata": {"title": "A 2010-2024 continuous GNSS dataset for Taiwan", "doi": "10.5281/zenodo.23551543", "publication_date": "2026-10-22", "description": "<p>This dataset provides continuous GNSS coordinate&nbsp;time series from more than 300 stations across Taiwan&nbsp;covering the period 2010&ndash;2024.</p>\n<p>The archived dataset includes:<br>- station metadata<br>- processed coordinate time series<br>- quality metrics<br>- equipment change records</p>\n<p>The dataset was processed using PPP/PPP-AR with GipsyX<br>in the ITRF2020 reference frame.</p>", "access_right": "open", "creators": [{"name": "Tung, Hsin", "affiliation": "Institute of Earth Sciences, Academia Sinica", "orcid": "0000-0002-2308-8282"}, {"name": "Hsu, Ya-Ju", "affiliation": "Institute of Earth Sciences, Academia Sinica"}, {"name": "Chen, Horng\u2010Yue", "affiliation": "Institute of Earth Sciences, Academia Sinica"}, {"name": "Liang, Wen-Tzong", "affiliation": "Institute of Earth Sciences, Academia Sinica", "orcid": "0000-0001-8904-156X"}], "contributors": [{"name": "Central Weather Administration, Taiwan", "affiliation": null, "type": "DataCollector"}, {"name": "Institute of Earth Sciences, Academia Sinica", "affiliation": null, "type": "DataCollector"}, {"name": "Ministry of the Interior, Taiwan", "affiliation": null, "type": "DataCollector"}, {"name": "Geological Survey and Mining Management Agency, Taiwan", "affiliation": null, "type": "DataCollector"}, {"name": "Water Resources Agency, Taiwan", "affiliation": null, "type": "DataCollector"}], "keywords": ["GNSS", "Taiwan", "ITRF2020", "crustal deformation"], "dates": [{"type": "collected", "description": "GNSS observation period covered by the dataset", "start": "2010-01-01"