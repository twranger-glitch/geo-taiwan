,"cityLandUseType":"保存區","noncityLandUseTypeOther":""},{"itemNo":32,"cityName":"新北市","distName":"八里區","landNo":"楓櫃段","landSerialNo":"576","landownership":"私有","cityLandUseType":"保存區","noncityLandUseTypeOther":""},{"itemNo":33,"cityName":"新北市","distName":"八里區","landNo":"楓櫃段","landSerialNo":"577","landownership":"私有","cityLandUseType":"保存區","noncityLandUseTypeOther":""},{"itemNo":34,"cityName":"新北市","distName":"八里區","landNo":"楓櫃段","landSerialNo":"578","landownership":"私有","cityLandUseType":"保存區","noncityLandUseTypeOther":""},{"itemNo":35,"cityName":"新北市","distName":"八里區","landNo":"楓櫃段","landSerialNo":"579","landownership":"私有","cityLandUseType":"保存區","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20060501000004","mediaImageList":[{"mediaName":"CE01新北市大坌坑遺址(2)","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/5201/photo/CE01新北市大坌坑遺址(2).JPG"},{"mediaName":"CE01新北市大坌坑遺址IMG_8909","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/5202/photo/CE01新北市大坌坑遺址IMG_8909.JPG"},{"mediaName":"CE01新北市大坌坑遺址IMG_8912","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/5203/photo/CE01新北市大坌坑遺址IMG_8912.JPG"},{"mediaName":"CE01新北市大坌坑遺址IMG_8913","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/5204/photo/CE01新北市大坌坑遺址IMG_8913.JPG"},{"mediaName":"CE01新北市大坌坑遺址IMG_8919","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/5205/photo/CE01新北市大坌坑遺址IMG_8919.JPG"},{"mediaName":"新北市大坌坑遺址","url":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/114903/photo/新北市大坌坑遺址.jpg"}],"documents":["https://data.boch.gov.tw/upload/documents/2021-08-11/23f3f689-1463-4154-b594-f294a900a6e4/95年公告.pdf","https://data.boch.gov.tw/upload/documents/2021-02-22/c020a4d9-69c2-44e4-b655-8340e2c2aa3d/文化部公告-重新公告類別名稱.pdf","https://data.boch.gov.tw/upload/documents/2020-10-13/fec70189-9421-40ec-a34c-61a20a034e0c/文化部公告-大坌坑指定理由及地號變更.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"張O"},{"ownerType":"土地所有人","ownerName":"張OOOOOO"},{"ownerType":"土地所有人","ownerName":"張OOOOOO"},{"ownerType":"土地所有人","ownerName":"張OOOOOO"},{"ownerType":"土地所有人","ownerName":"張OOOOOO"},{"ownerType":"土地所有人","ownerName":"中華民國"},{"ownerType":"土地所有人","ownerName":"洪OOOOO"},{"ownerType":"土地所有人","ownerName":"洪OOOOO"},{"ownerType":"土地所有人","ownerName":"張OOOOOO"},{"ownerType":"土地所有人","ownerName":"張OOOOOO"},{"ownerType":"土地所有人","ownerName":"李OOOOOO"},{"ownerType":"土地所有人","ownerName":"李OOOOOO"},{"ownerType":"土地所有人","ownerName":"中華民國"},{"ownerType":"土地所有人","ownerName":"中華民國"},{"ownerType":"土地所有人","ownerName":"張OOOOOO"},{"ownerType":"土地所有人","ownerName":"中華民國"},{"ownerType":"土地所有人","ownerName":"張OOOOOO"},{"ownerType":"土地所有人","ownerName":"中華民國"},{"ownerType":"土地所有人","ownerName":"張OOOOOO"},{"ownerType":"土地所有人","ownerName":"中華民國"},{"ownerType":"土地所有人","ownerName":"張OOOOOO"},{"ownerType":"土地所有人","ownerName":"中華民國"},{"ownerType":"土地所有人","ownerName":"康OOOOO"},{"ownerType":"土地所有人","ownerName":"黃OO"},{"ownerType":"土地所有人","ownerName":"周OO"},{"ownerType":"土地所有人","ownerName":"劉OO"},{"ownerType":"土地所有人","ownerName":"黃OO"},{"ownerType":"土地所有人","ownerName":"黃OO"},{"ownerType":"土地所有人","ownerName":"莊OO"},{"ownerType":"土地所有人","ownerName":"黃OOOOO"},{"ownerType":"土地所有人","ownerName":"張OOOOO"},{"ownerType":"土地所有人","ownerName":"林OOOOO"},{"ownerType":"土地所有人","ownerName":"林OOOOO"},{"ownerType":"土地所有人","ownerName":"林OOOOO"},{"ownerType":"土地所有人","ownerName":"中華民國"},{"ownerType":"土地所有人","ownerName":"張OOOOOO"},{"ownerType":"土地所有人","ownerName":"洪OO"},{"ownerType":"土地所有人","ownerName":"張OOOOOO"},{"ownerType":"土地所有人","ownerName":"莊OOOOO"}],"govInstitution":"文化部文化資產局","govDeptName":"古物遺址組遺址科","govDeptAddress":"台中市南區復興路三段362號","govDeptPhone":"(04)22177632","repImgId":4536},{"caseId":"20080321000003","caseName":"大園尖山考古遺址","assetsClassifyCode":"2.1.2","assetsClassifyName":"直轄市定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","遺址供展示教育規劃之適當性"],"registerReason":"（一）具文化發展脈絡中之定位及學術研究史上之意義：為國立臺灣大學考古人類學系首次考古田野發掘遺址。\n（二）具文化堆積內涵之特殊性及豐富性：\n1、本遺址豐富的遺物和遺留，對進一步釐清圓山文化和植物園文化的文化內涵，和圓山文化與植物園文化兩者的關係，具有相當的重要性。\n2、具地方期相代表性，且是桃園臺地上唯一較具規模且有代表性的遺址。\n（三）符合考古遺址指定及廢止審查辦法第3條第1項第1、2款之指定基準。","lawsReference":"考古遺址指定及廢止審查辦法第3條第1項第1、2款","govInstitutionName":"桃園市政府","addresses":[{"itemNo":1,"cityName":"桃園市","distName":"大園區","address":"桃園市大園區橫峰里中正東路160號（大園國小）"}],"longitude":121.20218,"latitude":25.06001,"representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/upload/representImageFile/2022-07-07/555ca0f2-f974-496b-849d-9476d8454058/大園尖山遺址 (4) - 複製_c.jpg"},"original":"https://data.boch.gov.tw/upload/representImageFile/2022-07-07/555ca0f2-f974-496b-849d-9476d8454058/大園尖山遺址 (4) - 複製.jpg","name":"大園尖山遺址 (4) - 複製"},"representImageSource":"桃園市政府文化局","landScope":"指定範圍為大園國小校地，總面積約39,408.48平方公尺。","discoveryDescription":"1931年，當時任教於大園國小的徐張水流先生，在校地整地時發現2件石錛，後與日本考古學者國分直一通信確認，並於後續進行研究發掘。","nearbyArcheologyCheck":"位於或鄰近普查遺址","nearbyArcheologyBrief":"","cultralMean":"1.具地方期相代表性。\r\n2.台大人類學系首次考古田野發掘遺址。","pastHistory":"大園尖山考古遺址目前為桃園市境內唯一的指定遺址，含有豐富的新石器時代晚期「圓山」與「植物園」文化堆積，及零星新石器時代中期之訊塘埔文化。\n\n遺址範圍含大園國小校地與校外西側田地，老街溪與新街溪間一個約 20 公尺高小丘上。1945 年為大園國小徐張水流校長所發現，其後歷經 1949 至 2010 年等幾次調查與試掘，發掘出大量陶器與石器，主要有盛物用的罐、缽，紡紗用的陶紡輪，砍伐與掘地用的石斧、石鋤、砍砸器，以及切割用的石片器、木工用的石錛、狩獵用的石鏃（箭頭）、製作魚網用的網墜、捶打用的石錘、磨製石器用的砥石、石砧等，顯現其為農耕漁獵並行的生活方式。\n\n大園尖山考古遺址的特色除了是臺灣學界第一個考古田野實習地點外，且從其出土現象與文物看來，遺址涵蓋時間長達一千多年，串連起新石器時代的圓山文化、植物園文化以及鐵器時代的十三行文化；多類型石材顯示了其高超的工藝技術；多樣性的陶器則佐證了當時臺灣島內互動幅員遼闊且交流頻繁。","actualStatus":"現為大園國小校園用地","usageStatus":"現已大部分為學校建物用地，昔日發掘之操場南側現為水泥球場及PU跑道用地。校園圍牆四週之堆積土壤為操場整地時之棄土，校園東側之民宅土地可見一文化斷層面。遺址大部分現已遭校園新建建築破壞，僅零星仍未遭受翻擾的空地及學校內未經建築的空地，可能保存有較佳的原始文化層堆積。","landUsage":"現為大園國小校園用地","announcementList":[{"classification":"變更/修正","officialDocNo":"府文資字第1110203324號","registerDate":"2022-08-01 14:45:58.437","note":"依據文化資產保存法第46、111條修正「遺址」名稱為「考古遺址」"},{"classification":"指定/登錄","officialDocNo":"府文資字第0971060393號","registerDate":"2008-03-21 16:38:27.0"}],"landlotList":[{"itemNo":1,"cityName":"桃園市","distName":"大園區","landNo":"東園段","landSerialNo":"43","landownership":"公有","cityLandUseType":"其他使用區","cityLandUseTypeOther":"學校用地"}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20080321000003","mediaImageList":[{"mediaName":"照片","url":"https://data.boch.gov.tw/upload/media/2022-06-01/8d90d516-7a7e-4986-957d-b2d5a543dadf/未命名.jpg"},{"mediaName":"照片","url":"https://data.boch.gov.tw/upload/media/2022-06-06/5c0c0327-08a0-4194-a678-2f3ed199b012/大園尖山遺址 (4) - 複製.jpg"},{"mediaName":"照片","url":"https://data.boch.gov.tw/upload/media/2022-06-06/8358d39d-b455-42ba-b894-f598dd461f6e/15602460269465.jpg"},{"mediaName":"照片","url":"https://data.boch.gov.tw/upload/media/2022-06-06/f6239568-812b-49ef-9a75-50a94bd91e82/大園尖山不是山.jpg"},{"mediaName":"照片","url":"https://data.boch.gov.tw/upload/media/2022-06-06/c2ca3c64-1e77-42f0-9208-0272eb60fb94/大園尖山遺址 (1).jpg"},{"mediaName":"照片","url":"https://data.boch.gov.tw/upload/media/2022-06-06/d930c4b7-dfaa-44e8-ab4b-4a2b8b86800a/大園尖山遺址 (2).jpg"}],"mediaVideoList":[{"mediaName":"大園尖山考古展示館 訪談影片","url":"https://imedia.culture.tw/iframe/697747c98e?api_access_key\u003d96059874-af5c-4958-8361-56c19bae953f"},{"mediaName":"大園尖山考古展示館~桃園市第一座考古遺址展示館","url":"https://youtu.be/_WtEO99GkU4?si\u003dzVUEsJhUIyf_kCux"}],"documents":["https://data.boch.gov.tw/upload/documents/2022-06-06/c210992e-aec5-42dd-bc34-539850ccc748/府文資字第0971060393號.pdf","https://data.boch.gov.tw/upload/documents/2022-08-04/a8cb8724-a033-43e7-84ce-56885e485742/府文資字第1110203324號.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"桃園市政府"}],"govInstitution":"桃園市政府","govDeptName":"文化局","govDeptAddress":"桃園市桃園區縣府路21號","govDeptPhone":"(03)332-2592分機8602","repImgId":172335},{"caseId":"20110506000001","caseName":"七家灣考古遺址","assetsClassifyCode":"2.1.2","assetsClassifyName":"直轄市定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性"],"registerReason":"1.在文化發展脈絡中之定位性及意義性：本遺址為目前臺灣地區已發現陶器遺址中，海拔最高之遺址。\r\n2.在學術研究史上之意義性：本遺址為顯示族群遷徙狀況的關鍵遺址，與史前人群在中高海拔山區適應模式，以及現今泰雅族之間的互動關係，具學術與族群研究之重要意義。\r\n3.遺址在文化堆積內涵之特殊性及豐富性：遺址出現豐富史前遺跡，包括柱洞、堆石結構、板岩、灰坑、火塘、墓葬等現象，並出土大量夾砂灰黑陶、有刃石器、陶偶、紡輪、有槽石棒、網墜、鐵器、玻璃器等文物，其多樣性、特殊性可期。\r\n4.同類型遺址數量之稀有性：本遺址有助於瞭解史前人類在臺灣中海拔以上高山活動和定居的生活實態，具相當之稀有性。\r\n5.遺址保存狀況之完整性：本遺址範圍內為武陵農場區域，因此保存狀況大體良好，結合武陵農場之自然與人文資源，可做為總體文化資產。\r\n6.遺址供展示教育規劃之適當性：本遺址為中海拔以上高山重要之代表性遺址，且與泰雅族群具有密切關係，具有學術研究特殊意義，且位於武陵農場境內，配合相關展示教育規劃，對於提升武陵地區人文與自然素質，以及改善目前旅遊型態，解決轉型困境均有重要幫助。","lawsReference":"\u003c\u003c遺址指定及廢止審查辦法\u003e\u003e第3條第1項第1、2、3、4、5、6款","govInstitutionName":"臺中市政府","addresses":[{"itemNo":1,"cityName":"臺中市","distName":"和平區","address":"臺中市和平區武陵農場境內"}],"longitude":121.285277,"latitude":24.354722,"relativePosition":"七家灣考古遺址位於雪霸國家公園內，現地為七家灣考古遺址公園，部分為停車場。","neighborPosition":"雪霸國家公園","representImage":{"ext":"JPG","transform":{"c":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/37379/photo/01b8b9c0-c8fd-4d50-9cea-544f694c2231_c.JPG"},"original":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/37379/photo/01b8b9c0-c8fd-4d50-9cea-544f694c2231.JPG","name":"01b8b9c0-c8fd-4d50-9cea-544f694c2231"},"representImageSource":"臺中市文化資產處","landScope":"臺中市和平區武陵段14-10地號","discoveryDescription":"1997年5月「大甲溪上游史前考古遺址及早期原住民活動調查」計畫項下調查發現，武陵農場第二賓館預定地採土已破壞相當部分，考古遺址西側保存情況較好；採集有橙色細砂陶和泥質陶、打製斧鋤型器、石刀、網墜等（劉益昌等 1997）。","nearbyArcheologyBrief":"位於武陵農場內雪山登山口附近的階地緩坡面上","cultralMean":"","pastHistory":"1.\t七家灣考古遺址為大甲溪上游海拔1500公尺以上的遺址，包含有二個文化層，晚期的上文化層年代大約距今500~1200年間，主要現象包括板岩結構、柱洞、堆石結構、火燒紅土區及墓葬等。下文化層年代距今2600~4000年間，遺跡主要包括柱洞、堆石結構以及灰坑、火塘、火燒紅土區等。出土遺物包括陶器、石器，其中一件泥質灰陶質地細緻，經登錄為古物。石器包括石鋤、錛鑿形器、石片石刀、切割器、矛鏃形器、尖狀器、刮削器、砍砸器、石錘、有槽石棒、網墜、砥石、打製圓盤、工作臺、石支腳等。\n\n2.\t本遺址為宜蘭、埔里與台中地區交通的重要據點，出土的遺物證明史前即有島內陸路交換與貿易能力。遺址有助於瞭解史前人類在臺灣中海拔以上高山活動和定居的生活實態，具相當之稀有性。\n\n3.\t本遺址為顯示族群遷徙狀況的關鍵遺址，探討史前人群在中高海拔山區適應模式，以及與現今泰雅族之間的互動關係，具學術與族群研究之重要意義。\n\n4.\t遺址為中海拔以上高山重要之代表性遺址，且與原住民族群具有密切關係，且位於武陵農場境內，配合相關展示教育規劃，對於提升武陵地區人文與自然資源，可做為總體文化資產。","actualStatus":"七家灣考古遺址位於雪霸國家公園內，現地為七家灣考古遺址公園，部分為停車場。","usageStatus":"目前由國軍退除役官兵輔導委員會武陵農場進行使用及維護管理。考古遺址的管理維護以現狀保存為方針，將考古遺址破壞程度降至最低，並依據文化資產保存法相關規定，維持考古遺址所定著土地上地形地貌之完整性。","landUsage":"1.\t考古遺址部分作為停車場使用，使用狀況良好，每月至少進行2次市定考古遺址巡查及其他監管保護。\n2.\t因遊客眾多，適合結合教育與觀光，係推廣文化資產保存之場域。","announcementList":[{"classification":"變更/修正","officialDocNo":"府授文資遺字第10701189956號","registerDate":"2018-06-04 00:00:00.0"},{"classification":"指定/登錄","officialDocNo":"府授文資字第0980004032號","registerDate":"2009-06-01 00:00:00.0"}],"landlotList":[{"itemNo":1,"cityName":"臺中市","distName":"和平區","landNo":"武陵段","landSerialNo":"14-10","landownership":"公有","noncityLandUseType":"國家公園區","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20110506000001","mediaImageList":[{"mediaName":"不同角度","url":"https://data.boch.gov.tw/upload/media/2022-08-15/fb080874-922b-4f11-89c8-c96db1fc9685/1.jpg"},{"mediaName":"七家灣考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/9b6c7058-bea6-40d3-9565-2b222e7a365b/DSC02673.jpg"},{"mediaName":"七家灣考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/bdc00ddf-4c72-4d11-83ba-b78caae67337/DSCN8975.jpg"},{"mediaName":"七家灣考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/cc5f5611-f4fd-467d-837c-9cdb6026b79d/DSCN8979.jpg"},{"mediaName":"七家灣考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/18dea456-68f9-419a-8e4b-dfa08f4a0411/DSCN8987.jpg"},{"mediaName":"七家灣考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/54779f91-5181-419c-8ba0-c938ac488110/DSCN8989.jpg"}],"mediaVideoList":[{"mediaName":" 【影音】臺中市市定考古遺址：七家灣考古遺址","description":"七家灣考古遺址簡介：\n　　七家灣考古遺址是一個古代長期有人類居住的古老聚落，主要可以分二個文化層，晚期的上文化層年代大約距今500-1200年左右，早期的下文化層年代則早至2600-4000年左右，這二個時期的史前人類主要活動的區域部分重疊，但因為時間不同，出土的日常生活用品與建築形式也不相同。\n　　上文化層主要現象包括柱洞、堆石結構、火燒紅土區、板岩結構及墓葬等。下文化層堆積很厚，出土的現象及存化遺物都較多，主要包括柱洞、堆石結構以及灰坑、火塘、火燒紅土區等遺跡。 下文化層出土遺物包括陶器、石器，陶器數量極多，其中一件泥質灰陶，質地細緻，陶質十分堅硬，後經登錄為古物。而石器則包括石鋤、錛鑿形器、石片石刀、切割器、矛鏃形器、尖狀器、刮削器、砍砸器、石錘、有槽石棒、網墬、砥石、打製圓盤、工作台、石支腳等。\n　　本考古遺址位於武陵農場遊客中心西南後方階地面上，遺址主要位於二個河階平面，上階地現為武陵富野渡假村，下階地目前為七家灣考古遺址公園，土質為砂頁岩石質土。\n　　本考古遺址現況，武陵富野渡假村興建工程已破壞部分，目前下階地已規劃為考古遺址公園進行覆土保存，此為目前本考古遺址保留較完整的區域。 上台地東側區域為武陵第二國民賓館新館現址，而上台地西側則維持原本的植被景觀。下台地亦留作保留地，用作行經上台地賓館的車道與周邊綠美化使用。出土遺物於武陵國民賓館展示。","url":"https://youtu.be/vfOR9Q90qdE"}],"documents":["https://data.boch.gov.tw/upload/documents/2022-01-19/3d020e63-a1d9-45dc-8bae-8bdcfde88d1d/0980601_七家灣考古遺址_指定公告.pdf","https://data.boch.gov.tw/upload/documents/2022-01-19/2b6eb44c-4ed8-400a-9426-bb4be41dc5c5/1070604_七家灣考古遺址_變更公告.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"中華民國"}],"govInstitution":"臺中市文化資產處","govDeptName":"遺址傳藝課","govDeptAddress":"臺中市西區市府路41巷19號","govDeptPhone":"04-22290280","repImgId":4539},{"caseId":"20110506000002","caseName":"清水中社考古遺址","assetsClassifyCode":"2.1.2","assetsClassifyName":"直轄市定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性"],"registerReason":"1.\t在文化發展脈絡中之定位及意義性：屬於金屬器時代番仔園文化之代表性考古遺址。\n2.\t在學術研究史上意義性：本考古遺址為近年考古人才培育之基準考古遺址，未來仍可持續，且具學術史研究之轉折意義。\n3.\t考古遺址文化堆積內涵之特殊性及豐富性：考古遺址文化層堆積深厚，且有早晚期變化，文化遺物、遺跡豐富。同類型番仔園文化考古遺址雖多，但如本考古遺址位於平原而保存良好者很少。本考古遺址文化堆積內涵占居年代甚為長久，且範圍極廣，預料埋藏遺物必然豐富，其多樣性、特殊性可期。\n4.\t同類型考古遺址數量之稀有性：本考古遺址於番仔園文化形態之各考古遺址中其厚度與廣度均首屈一指，且鄰近海岸，中部地區難以尋出如此近海之考古遺址。\n5.\t考古遺址保存狀況之完整性：本考古遺址範圍內雖有建築物，但為淺層建築，因此保存狀況大體良好。文化層位於潛水面以下保存有機質豐富，與眷村結合可作為總體文化資產。\n6.\t考古遺址供展示教育規劃之適當性：本考古遺址為中部地區重要之代表性考古遺址，面積廣大，且與平埔族群具有密切關係，具有學術研究特殊意義，且鄰近本市港區藝術中心，規劃展示均宜，爰除已於97年1月指定之考古遺址範圍外，再予擴大其範圍。\n7.\t符合考古遺址指定及廢止審查辦法第3條第1項第1款至第7款基準。","lawsReference":"\u003c\u003c遺址指定及廢止審查辦法\u003e\u003e第3條第1項第1、2、3、4、5、6款","govInstitutionName":"臺中市政府","addresses":[{"itemNo":1,"cityName":"臺中市","distName":"清水區","address":"臺中市清水區信義新村眷舍區"}],"longitude":120.547777,"latitude":24.269444,"relativePosition":"清水中社考古遺址位於清水區的中西側，涵蓋清水區公所以西眷村所在的區域，地理位置為海岸平原的中央。","neighborPosition":"臺中市港區藝術中心、清水眷村文化中心、海灣繪本館等。","representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/37401/photo/48021ae2-f038-45be-8a5e-d588686c7d73_c.jpg"},"original":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/37401/photo/48021ae2-f038-45be-8a5e-d588686c7d73.jpg","name":"48021ae2-f038-45be-8a5e-d588686c7d73"},"representImageSource":"臺中市文化資產處","landScope":"( 一) 原指定範圍:清水區銀聯段372 - 1 、372-2 、372 - 3 、372 - 7 、372 - 17 、372 - 18 、372 - 19 、372 - 20 、372 - 21 、372 - 26 、372 - 27 及372 - 52 共12 筆地號，面積約為6 . 6 公頃。\n( 二) 擴大指定範圍:清水區銀聯段207 - 1 、207 - 2 、207 - 3 、203 - 1 、208-3 、372 - 23 、372 - 9 、372 - 11 、372 - 12 、372 - 13 、372 - 14 、372 - 16 、623 - 7 、623 - 9 、624 、624-l 、624 - 2 、652 - 1 、652 - 2 、652 - 3 、623 - 4 、626 、626 -1 、627-2 、629 、630-1 及631-2 等27 筆地號，面積約為4. 4公頃，併同原指定範聞面積共約11 公頃(依據核定國實地分割測量面積為準)。","discoveryDescription":"1997年何佳修調查發現。","nearbyArcheologyCheck":"位於或鄰近普查遺址","nearbyArcheologyBrief":"1.鄰近牛罵頭遺址及社口遺址\r\n2.此三處遺址呈帶狀分布\r\n3.因遺址範圍極廣，相關內涵調查正進行研究中","cultralMean":"","pastHistory":"1.\t清水中社考古遺址位於清水社口尾與牛埔之間的沖積平原，介於大甲溪與大肚溪沖積扇間，地理位置為海岸平原的中央。\n\n2.\t清水中社考古遺址發現於1997年，1998年國立自然科學博物館國進行中小老師局部實習性的考古發掘工作，劉益昌於1997、2004、2008於中社進行三次考古發掘，出土豐富的文化遺留和墓葬，2019年李作婷搶救社口尾地點出土13具成人幼兒墓葬及出現稻米、粟、豆類等生態遺留。同年劉克竑於清水．中社遺址南社地點出土43具人骨距今1500～600年間。根據歷年的研究，顯示清水中社包括營埔文化、番仔園文化到歷史時期的瀑拉族大聚落，學者推測可能是中部地區牛駡社群的祖先所居之地。\n\n3.\t中社考古遺址經多次考古發掘，出土遺物及現象豐富，包括墓葬、貝塚、灰坑、水井、大量陶器、石器及獸骨、貝類、琉璃珠等。其中陶器具有大肚、八卦台地及苗栗淺山地區拍印魚骨紋、柵欄紋等特徵，反映了清水平原與周遭居民往來發展關係。\n\n4.\t中社考古遺址是清水平原大型聚落遺址，其範圍包括清水中社南社地點、社口尾、建國國小，東至社口，西至二槺榔，隨陸相環境穩定於區間往返移動長期利用的地域，本遺址提供研究平埔先民史前文化發展與變遷的重要資訊。","actualStatus":"目前部分考古遺址區域由國防部委託臺中市政府文化局港區藝術中心代為規畫管理，目前正執行「清水眷村園區改善工程計畫」，內容包含眷村展示推廣、工藝文創、在地社團進駐（海灣繪本館）、清水中社遺址文物館、國際藝術村等綜合型文化園區。","usageStatus":"目前由臺中市港區藝術中心代為管理，使用狀況良好，每月至少進行2次市定考古遺址巡查及其他監管保護。","landUsage":"1.閒置眷村區、私人耕作地與荒廢地\r\n2.臺中港特定區都市計劃（第四種住宅區、綠帶地、學校用地、道路用地、人行步道）","announcementList":[{"classification":"變更/修正","officialDocNo":"府授文資遺字第10701189955號","registerDate":"2018-06-04 00:00:00.0"},{"classification":"指定/登錄","officialDocNo":"府授文資二字第1020180730號","registerDate":"2013-10-01 00:00:00.0"}],"landlotList":[{"itemNo":1,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-1","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":2,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-2","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":3,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-3","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":4,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-7","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":5,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-17","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":6,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-18","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":7,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-19","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":8,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-20","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":9,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-21","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":10,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-26","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":11,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-27","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":12,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-52","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":13,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"207-1","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":14,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"207-2","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":15,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"207-3","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":16,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"203-1","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":17,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"208-3","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":18,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-23","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":19,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-9","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":20,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-11","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":21,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-12","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":22,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-13","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":23,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-14","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":24,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"372-16","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":25,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"623-7","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":26,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"623-9","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":27,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"624","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":28,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"624-1","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":29,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"624-2","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":30,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"652-1","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":31,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"652-2","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":32,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"652-3","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":33,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"623-4","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":34,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"626","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":35,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"626-1","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":36,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"627-2","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":37,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"629","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":38,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"630-1","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"},{"itemNo":39,"cityName":"臺中市","distName":"清水區","landNo":"銀聯段","landSerialNo":"631-2","landownership":"公有","noncityLandUseType":"特定專用區","noncityLandUseTypeOther":"臺中港特定區"}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20110506000002","mediaImageList":[{"mediaName":"不同角度","url":"https://data.boch.gov.tw/upload/media/2022-08-15/360493d3-7fe0-4287-906a-8d1a801d08a3/1.jpg"},{"mediaName":"清水中社考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/9b80d410-e16c-43b9-83d8-18a2ee75b6a4/DSC09144.jpg"},{"mediaName":"清水中社考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/8d09d64b-6011-4e63-9688-36c36a02aaa0/DSC09143.jpg"},{"mediaName":"清水中社考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/b2b95693-800e-4733-bc62-6537e5fca8a0/DSC09141.jpg"},{"mediaName":"清水中社考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/7eb9f711-20ab-408e-9306-b7bbd97b8ded/DSC08706.jpg"},{"mediaName":"清水中社考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-07-21/a07b5d8b-113e-403e-bddf-57d75b635c6a/DSC08705.jpg"},{"mediaName":"清水中社考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/8d8516ce-df76-42fd-91e4-c5ca29e4ac72/_DSC0927.jpg"},{"mediaName":"清水中社考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/e48c5091-2cfa-4a5d-9b15-cb6688900b8a/DSC09480.jpg"},{"mediaName":"清水中社考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/d14a656c-ffff-48ce-b321-ad18f8a8e653/DSC09481.jpg"}],"mediaVideoList":[{"mediaName":"【影音】臺中市市定考古遺址：清水中社考古遺址","description":"清水中社考古遺址簡介\n　　中社考古遺址分布範圍極廣，位居清水海岸平原區，介於大甲溪沖積扇與大肚溪沖積扇間，社口尾與牛埔之間的沖積平原上，地質屬全新世一萬年以來的現代沖積層，今所在為信義新村及港區藝術中心。\n　　從鰲峰路進入港區藝術中心後，即屬於考古遺址範圍的區域。1997年調查時於藝術館西側工程斷面採集標本多為灰黑陶器，與貝塚附近所採集標本似為兩個不同的文化屬性，屬番子園文化類型，年代一般界定在2000-400年前屬史前時代最晚階段之金屬時代(劉益昌等2007b:44)。\n　　番仔園文化分布範圍包括今臺中市大肚台地西側緩坡、臺中盆地、往南延伸至八卦台地、北至苗栗縣南部海岸丘陵。代表遺址包括臺中市大甲區鎮番仔園、外埔區麻頭路、清水區清水中社、沙鹿區鹿寮考古遺址、南勢坑考古遺址、龍井區山腳、龍泉村、台中市南屯區山仔腳考古遺址、西屯區惠來考古遺址上層等。\n　　本考古遺址分別於西元1997年、2004年及2008年分別進行三次考古發掘，遺址現象包括墓葬、貝塚、灰坑、水井等，出土文化遺物則有陶器、石器，且有生態遺留物，包括獸骨、貝類及碳化種子等等，於台中港區藝術中心西側及南側眷村內的私人耕作地與荒廢地均可採集到許多標本，文化層深度約在地表下30-50cm，厚度約100-150cm不等。\n　　本考古遺址為中部地區重要之代表性考古遺址，面積廣大，且與平埔族群具有密切關係，具有學術研究特殊意義，且鄰近本市港區藝術中心，規劃展示均宜，爰除已於97年1月指定之考古遺址範圍外，於102年10月1日再予公告擴大其範圍。","url":"https://youtu.be/5M1iwB-x4yg"}],"documents":["https://data.boch.gov.tw/upload/documents/2021-08-03/710db2e4-634a-46ef-ad39-622ba308737b/1021001_清水中社考古遺址_變更公告1.pdf","https://data.boch.gov.tw/upload/documents/2021-08-03/f0dc1e19-3d73-4ea6-8831-65662f9f9324/1070604_清水中社考古遺址_變更公告2.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"國防部政治作戰局"},{"ownerType":"土地所有人","ownerName":"臺中縣政府"}],"govInstitution":"臺中市文化資產處","govDeptName":"遺址傳藝課","govDeptAddress":"臺中市西區市府路41巷19號","govDeptPhone":"04-22290280","repImgId":4540},{"caseId":"20110506000003","caseName":"牛罵頭考古遺址","assetsClassifyCode":"2.1.2","assetsClassifyName":"直轄市定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性"],"registerReason":"1.在文化發展脈絡中之定位及意義性：牛罵頭考古遺址是臺灣中部史前新石器時代中期牛罵頭文化的命名與代表性考古遺址，具有新石器時代承先啟後的關鍵地位。\n2.在學術研究史上意義性：為1950年代台灣中部海岸區域史前文化層序建構的重要遺址之一，也是1970年代整體中部區域史前文化層序建構的重要遺址。\n3.考古遺址文化堆積內涵之特殊性及豐富性：牛罵頭考古遺址為多文化層遺址，包含史前時期牛罵頭文化和營埔文化，並發現大坌坑文化及番仔園文化遺物；歷史時期包括牛罵頭社、舊牛罵頭聚落、日治神社時期、國府軍營時期，出土文物除包含石器、陶器，並出土史前石頭排列之建築遺構，及首度發現牛罵頭文化時期之卵石砌墓葬群及人骨殘骸。\n4.同類型考古遺址數量之稀有性：牛罵頭文化的考古遺址分布範圍橫跨苗栗縣、臺中市、彰化縣、南投縣，為目前中部區域唯一新石器中期文化。本遺址包括四個文化層，在臺灣地區實屬罕見。\n5.考古遺址保存狀況之完整性：牛罵頭考古遺址所在之「牛罵頭遺址文化園區」，其基地廣場雖因舊時興建日治神社與國府軍營影響原文化層保存，惟其週邊西、北側區域因保安林而仍保留較完整的文化層。\n6.考古遺址供展示教育規劃之適當性：考古遺址位置及周邊為臺中市觀光遊憩景點，為考古遺址展示及教育的最佳場域，有助於了解臺中的城市歷史以及中部區域史前文化發展史。","lawsReference":"文化資產保存法第46條暨考古遺址指定及廢止審查辦法第3、4、5條","govInstitutionName":"臺中市政府","addresses":[{"itemNo":1,"cityName":"臺中市","distName":"清水區","address":"臺中市清水區鰲峰山公園內「牛罵頭遺址文化園區」(原陸軍清水營區)"}],"longitude":120.572777,"latitude":24.27042,"relativePosition":"1.\t牛罵頭考古遺址目前位於牛罵頭遺址文化園區，園區內亦包含臺中市歷史建築之鰲峰山營區及原清水神社遺構。","neighborPosition":"位於鰲峰山市鎮公園內，附近景點包括紫雲巖、清水公學校日式宿舍群、清水鬼洞等。","representImage":{"ext":"JPG","transform":{"c":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39474/photo/牛罵頭遺址_c.JPG"},"original":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/39474/photo/牛罵頭遺址.JPG","name":"牛罵頭遺址"},"representImageSource":"臺中市文化資產處","landScope":"臺中市清水區牛罵頭段12、13、14、16等4筆地號。","discoveryDescription":"牛罵頭考古遺址為日學者國分直一於日治末期1943年發現，但更早於1937年興建清水神社時可能已經露出，神社社主西村昌隆氏收藏有本考古遺址出土的石器與陶器。","nearbyArcheologyBrief":"社口遺址\r\n中社遺址","cultralMean":"","pastHistory":"1.\t牛罵頭考古遺址包含史前時期牛罵頭文化和營埔文化，並發現少量大坌坑文化及番仔園文化遺物；歷史時期包括牛罵頭社、舊牛罵頭聚落、日治神社時期、國府軍營時期，出土文物除包含石器、陶器，並出土史前石頭排列之建築遺構，2004年發現牛罵頭文化時期之卵石砌墓葬群及人骨殘骸。\n\n2.\t 遺址是臺灣中部史前新石器時代中期牛罵頭文化的命名考古遺址，具有新石器時代承先啟後的關鍵地位。\n\n3.\t牛罵頭文化分布範圍橫跨苗栗縣、臺中市、彰化縣、南投縣，遺址所在之「牛罵頭遺址文化園區」，其基地廣場雖因舊時興建日治神社與國府軍營影響原文化層保存，惟其週邊西、北側區域因保安林而仍保留較完整的文化層。\n\n4.\t考古遺址位置及周邊為臺中觀光遊憩景點，為考古遺址展示及地理環境教育的最佳場域，有助於了解清水區域史前文化發展史。","actualStatus":"1.牛罵頭考古遺址目前位於牛罵頭遺址文化園區，園區內亦包含臺中市歷史建築之鰲峰山營區及原清水神社遺構。\n2.牛罵頭遺址文化園區保留牛罵頭考古遺址TP3探坑，展示牛罵頭考古遺址界牆、南勢坑考古遺址灰坑剝取物。園區戶外另放置各考古遺址出土遺物如頭家厝遺址界牆、聚興疑似遺址駁坎等。\n3.園區館舍共有8棟，作為教育展示與遺物典藏空間。除了展示牛罵頭考古遺址相關遺物與介紹牛罵頭文化外，亦有恆溫典藏室供存放出土遺物。\n4.目前由臺中市文化資產處進行使用及維護管理，考古遺址的管理維護以現狀保存為方針，將考古遺址破壞程度降至最低，並依據文化資產保存法相關規定，維持考古遺址所定著土地上地形地貌之完整性。\n","usageStatus":"目前遺址指定本體範圍所在地位於臺中市清水區鰲峰山公園內之牛罵頭遺址文化園區(原陸軍清水營區)，地上使用面積為1.6672公頃，及在基地下方的保安林地2.5308公頃、林務局清水工作站為遺址保存區範圍，其鄰接區域則為大街路東側的街屋和南側的鰲峰山保安林與台灣自來水公司清水營運所、原清水神社副參道。","landUsage":"遺址指定本體範圍內地上空間原為陸軍營區，現利用原有營舍和空間規劃為牛罵頭遺址文化園區；保存區西北側為保安林地及林務局南投林區管理處清水工作站所在。","announcementList":[{"classification":"變更/修正","officialDocNo":"府授文資遺字第11401838113號","registerDate":"2025-07-02 15:48:33.137"},{"classification":"變更/修正","officialDocNo":"府授文資遺字第11002639241號","registerDate":"2021-10-19 09:52:21.99"},{"classification":"變更/修正","officialDocNo":"府授文資遺字第10701189953號","registerDate":"2018-06-04 00:00:00.0"},{"classification":"指定/登錄","officialDocNo":"府授文資字第 0950004236 號","registerDate":"2006-05-30 00:00:00.0"}],"landlotList":[{"itemNo":1,"cityName":"臺中市","distName":"清水區","landNo":"清水段清水小段","landSerialNo":"55-9","landownership":"公有","noncityLandUseTypeOther":""},{"itemNo":2,"cityName":"臺中市","distName":"清水區","landNo":"清水段清水小段","landSerialNo":"55-29","landownership":"公有","noncityLandUseTypeOther":""},{"itemNo":3,"cityName":"臺中市","distName":"清水區","landNo":"清水段清水小段","landSerialNo":"55-30","landownership":"公有","noncityLandUseTypeOther":""},{"itemNo":4,"cityName":"臺中市","distName":"清水區","landNo":"清水段清水小段","landSerialNo":"55-33","landownership":"公有","noncityLandUseTypeOther":""},{"itemNo":5,"cityName":"臺中市","distName":"清水區","landNo":"清水段清水小段","landSerialNo":"55-1","landownership":"公有","noncityLandUseTypeOther":""},{"itemNo":6,"cityName":"臺中市","distName":"清水區","landNo":"清水段清水小段","landSerialNo":"55-15","landownership":"公有","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20110506000003","mediaImageList":[{"mediaName":"不同角度","url":"https://data.boch.gov.tw/upload/media/2022-08-15/dbf465fb-83d6-4b27-883f-7f55d9a8a16a/1.jpg"},{"mediaName":"牛罵頭考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/c2f7463e-7491-4d1e-9585-c9fcaed3b4f0/_DSC0234.jpg"},{"mediaName":"牛罵頭考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/02ef19ac-09df-4c49-9829-e73ea4a8df56/_DSC0649.jpg"},{"mediaName":"牛罵頭考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/8af30017-a604-4046-937d-5580d8c0356d/_DSC9774.jpg"},{"mediaName":"牛罵頭考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/75f35594-2554-4020-8373-c30fe565828a/DSC01772.jpg"},{"mediaName":"牛罵頭考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/8ceb8a49-f634-4349-b861-42dea37d39d5/DSC01911.jpg"},{"mediaName":"牛罵頭考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/d032f4f4-7e49-4696-b529-f0a55d435323/DSC03302.jpg"},{"mediaName":"牛罵頭考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-07-21/4f5b4f4b-cde1-4ad5-b574-f4ac12467d3e/DSCN9710.jpg"},{"mediaName":"牛罵頭考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/e75f41f0-6985-4aae-a8bd-7f104028f27b/IMG_20200725_100515.jpg"}],"mediaVideoList":[{"mediaName":"【影音】臺中市市定考古遺址：牛罵頭考古遺址","description":"牛罵頭考古遺址簡介：\n　　「牛罵頭考古遺址」位於臺中市清水區（舊稱牛罵頭）鰲峰山公園原陸軍清水營區內，而「牛罵頭考古遺址」為臺灣中部地區新石器時代中期文化的代表，並以此地名作為本文化類型的命名，亦為國內第一個「命名遺址」，出土陶器以紅、褐色繩紋陶為主，石器的類型常見的有斧鋤形器、石刀、石錛、石鏃、網墜、石片器、石核器等農、漁獵用具。其年代在距今四千五百至三千五百年前之間，考古遺址大多分布於臺中盆地周緣的海岸階地、低位河階及地勢較高地區，到了晚期距今約三千七、八百年前，並向河流中游丘陵山地地區分布，考古遺址更遍及苗栗縣、臺中市、彰化縣、南投縣等地。\n　　牛罵頭考古遺址最早發現於日治時代末期，戰後，歷經五○年代至七○年代的調查研究後，有關牛罵頭考古遺址及相關歷史的研究，即趨於停頓。因此，前臺中縣文化局針對鰲峰山上原陸軍清水營區（土地已由軍方於民國八十六年撥還原臺中縣政府），亦為日治時期的臺中州大甲郡清水神社所在，委託國立臺灣師範大學歷史系溫振華教授和中央研究院歷史語言研究所劉益昌教授共同進行「牛罵頭遺址資料蒐集研究計畫」案，內容包括歷史文獻的調查研究和遺址範圍考古發掘兩部分，並於民國九十年四月完成研究報告。遺址發掘經向教育部申請並獲得核發考古挖掘執照後，於民國九十年一、二月間由劉益昌教授正式進行考古試掘工作，考古遺址經試掘後發現營區範圍的中間和廣場，大部分因日治時代興建清水神社將山嶺地形推平已經破壞原文化層，因此專家學者建議中間區域可開放作為規劃遺址活化利用等相關使用；而營區內西、北側區域目前則保存有良好之文化層堆積及出土有石頭排列之建築遺構。\n　　此外，考古遺址分布範圍的研究結果，亦較原來所知為低，約至海拔二十公尺，即由上方園區的軍營延伸至山下清水區大街路附近，並證實本考古遺址包括上層的番仔園文化，中層的營埔文化與下層的繩紋紅陶時期的牛罵頭文化，也是大肚台地三個主要的文化層。而參與審查研究案的學者均一致肯定牛罵頭文化考古遺址的重要性，建議應指定為考古遺址類型古蹟保存，和文獻資料蒐集有助於了解牛罵社（Gomach）與週遭其他平埔族社群的關係，及與清領時期漢人在今清水海岸平原一帶拓墾的互動實態，乃至日治時代清水街的社會和生活概況的建構；同時也印證了牛罵頭文化向上承接臺灣北部新石器時代早期的「大坌坑文化」，並與臺灣南部的「牛稠子文化」之間有明顯的往來關係；向下則開啟新石器時代晚期的臺灣中部「營埔文化」與金屬器和金石並用時期的「番仔園文化」。\n\n歷史沿革：\n　　此考古遺址為日學者國分直一於日治末期西元1943年所發現，但更早於1937年興建清水神社時可能已經露出，神社社主西村昌隆氏收藏有本考古遺址出土的石器與陶器。1950年代劉斌雄先生曾經進行詳細調查工作，發現本考古遺址至少包括具有繩紋紋飾的紅陶文化以及黑陶文化，亦即今日所稱的牛罵頭文化、營埔文化二個清晰的文化層和一個年代可能最晚而以橙褐色方格紋陶器（即為番仔園文化）為代表的文化層。\n　　牛罵頭考古遺址，於民國94年新版文資法修正施行，改為臺中縣縣定遺址，民國99年12月25日臺中縣、市合併，逕改列直轄市定遺址。","url":"https://youtu.be/w_lqpt7GR8k"},{"mediaName":"【影音】2020全國古蹟日-文化導覽(海線清水地區)尋找海之匠師","description":"2020全國古蹟日【找回技藝‧路路藏蹟】系列活動\n\n活動名稱：文化導覽(海線-清水地區)尋找海之匠師\n\n活動時間：2020年10月18日 (日) 上午9:00-下午14:00\n\n活動地點：臺中市清水區\n\n講師：臺中清水牛罵頭文化協進會理事長-吳長錕老師\n\n","url":"https://youtu.be/KAifY7XAvF8"}],"documents":["https://data.boch.gov.tw/upload/documents/2022-01-19/76298bc3-59a2-4e58-b808-d5bd86945812/0950530_牛罵頭考古遺址_指定公告.pdf","https://data.boch.gov.tw/upload/documents/2022-01-19/383e7af3-7fa8-45b1-87a5-eccf8f2deada/1070604_牛罵頭考古遺址_變更公告.pdf","https://data.boch.gov.tw/upload/documents/2022-01-19/7103a226-62ad-4fba-a77d-665b246b5712/1101019_牛罵頭考古遺址_變更公告.pdf","https://data.boch.gov.tw/upload/documents/2025-08-22/5a6faeb8-f56d-45d6-a359-611c1f8f836c/1140702_市定牛罵頭考古遺址調整公告_清冊_變更對照表.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"中華民國"}],"govInstitution":"臺中市文化資產處","govDeptName":"遺址傳藝課","govDeptAddress":"臺中市西區市府路41巷19號","govDeptPhone":"04-22290280","repImgId":4542},{"caseId":"20100106000001","caseName":"惠來考古遺址","assetsClassifyCode":"2.1.2","assetsClassifyName":"直轄市定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性","具其他遺址價值者"],"registerReason":"1.\t在文化發展脈絡中之定位及意義性：其牛罵頭文化及番仔園文化層對了解中部地區新石器時代早期及鐵器時代之人類生活具重要性。\n2.\t在學術研究史上意義性：中部地區首次發現之大型村落，對聚落形態的研究具有學術意義。\n3.\t考古遺址文化堆積內涵之特殊性及豐富性：牛罵頭文化的器型及番仔園文化的鐵器及墓葬與臺灣北部、南部地區不同而且內涵豐富。\n4.\t同類型考古遺址數量之稀有性：惠來考古遺址的類型雖然遍佈中部地區，但臺中市區內包括兩個文化層的考古遺址稀少。\n5.\t考古遺址保存狀況之完整性：出土的遺物、現象及墓葬、柱洞反映村落的佈局，保存相當良好。\n6.\t考古遺址供展示教育規劃之適當性：保存完整並且位在市區，為鄉土教育及展示的最佳場域，有助於了解臺中的城市歷史。\n","lawsReference":"「文化資產保存法」第40條暨「遺址指定及廢止審查辦法」第4、5條","govInstitutionName":"臺中市政府","addresses":[{"itemNo":1,"cityName":"臺中市","distName":"西屯區","address":"臺中市西屯區河南路三段、市政北一路口，惠民段144地號"}],"longitude":120.636583,"latitude":24.162055,"relativePosition":"市定惠來考古遺址目前規劃為小來公園","neighborPosition":"鄰近Tiger City購物中心、臺中歌劇院","representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/upload/representImageFile/2023-06-02/79a429eb-3b21-406c-b288-0f78fd3e2405/DSCN8756_c.jpg"},"original":"https://data.boch.gov.tw/upload/representImageFile/2023-06-02/79a429eb-3b21-406c-b288-0f78fd3e2405/DSCN8756.jpg","name":"DSCN8756"},"representImageSource":"臺中市文化資產處","landScope":"臺中市西屯區惠民段144地號","discoveryDescription":"2003年3月起 - 國立自然科學博物館副研究員屈慧麗率先進行惠來遺址試掘，並於西屯區惠民段144號抵費地發現番仔園文化。 ","nearbyArcheologyCheck":"位於或鄰近普查遺址","nearbyArcheologyBrief":"無","cultralMean":"","pastHistory":"1.\t惠來考古遺址位於台中都會中心，分佈東至文心路，西至環中路，範圍內包括三個文化層，分別是新石器時代中期牛罵頭文化、營埔文化及金屬器時期的番仔園文化。\n\n2.\t牛罵頭文化的年代距今4500至3400年之間，在市政路與河南路的牛罵頭文化層也發現少量具大坌坑紋飾之陶器，遺物有樹皮布打棒、三連杯、豆形器、陶紡輪、玉錛、半月形石刀等，許多閃玉錛顯示當時西部平原與東部進行交換。\n\n3.\t營埔文化出現在市議會地點，年代距今約2500到2800年，發現有鼎型器、束腰罐、豆型器、帶流罐等，與牛罵頭時期陶器類型明顯不同。\n\n4.\t市定遺址所在的小來公園番仔園文化層年代距今1600到900年之間，出土狗獾、龜甲、稻米等生態遺物，可見當時是農漁業並重的生業型態。另外還有許多灰坑、柱洞及24座墓葬，顯示遺址所在地當時是相當大型集中住居區。\n\n5.\t番仔園文化在臺灣西海岸中部地區為史前最晚階段，歷年來均以此文化體系做為海岸地帶拍瀑拉族的祖先型文化，不過文化遺物顯示其中陶器具有大肚、八卦台地及苗栗淺山地區拍印魚骨紋、柵欄紋等特徵，反映當時與瀑拉族、道卡斯族、巴宰海族、巴布薩族，甚至可能觸及洪雅族往來關係。","actualStatus":"民國95年惠來遺址即列入了臺中市認識古蹟日之「西大墩有約」路線景點，歷年來在教育推廣方面已頗具成效。","usageStatus":"目前以簡易遺址公園之最小密度開發方式予以公園化保存，園區展示棚架內委請專家復原界牆及坑底，並完成有人骨、獸骨、柱洞、筏子溪流域等模型，園區周圍亦完成植栽，整體園區規劃已具有保存文化資產及社教展示之功能，為市民提供一處兼具文化教育與休憩之用的綠地。","landUsage":"新市政中心專用區","announcementList":[{"classification":"變更/修正","officialDocNo":"府授文資遺字第10701189954號","registerDate":"2018-06-04 13:55:11.859"},{"classification":"指定/登錄","officialDocNo":"府授文資字0990004222號","registerDate":"2010-01-06 15:17:27.0"}],"landlotList":[{"itemNo":1,"cityName":"臺中市","distName":"西屯區","landNo":"惠民段","landSerialNo":"144","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20100106000001","mediaImageList":[{"mediaName":"不同角度","url":"https://data.boch.gov.tw/upload/media/2023-07-21/f9707c41-a6ac-467b-a361-a4254e4b6166/DSC06569.jpg"},{"mediaName":"惠來考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/14a80975-77cc-43e0-a5d5-221af48766d8/_DSC2100.jpg"},{"mediaName":"惠來考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/3b1c7165-d6d4-4941-b104-2baafd825940/_DSC2101.jpg"},{"mediaName":"惠來考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/479d37f9-10b9-4ddf-bef7-59edb8bc4819/_DSC2102.jpg"},{"mediaName":"惠來考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/2f333855-50d0-4eea-87f9-69073c10efc9/179e87b8-5a46-440a-b499-c1f600ae3b68.jpg"},{"mediaName":"惠來考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/00060655-f5cc-4e4b-a6a5-72876a5956a0/DSC07228.jpg"}],"mediaVideoList":[{"mediaName":"【影音】臺中市市定考古遺址：惠來考古遺址","description":"惠來考古遺址簡介：\n　　本考古遺址涵括二個文化層，分別是史前新石器時代中期的牛罵頭文化及晚期番子園文化，而出土文物也有大坌坑式繩紋陶及營埔文化之遺物，牛罵頭文化層出土重要的有三連杯豆形器、陶紡輪、石錛、半月形石刀等，其中更發現一蛇紋岩質石錛，是當時西部平原與東部交流的證物。\n　　而番仔園文化層，則出土獸骨、龜甲、稻米等遺物，可見當時農漁業並重的產業型態。另外還有許多灰坑、柱洞及數十個墓葬，顯示遺址所在地當時是相當大型集中住居區。 牛罵頭文化的年代在距今4500至3400年之間，遺址大多分布於臺中盆地周緣的海岸階地、低位河階及地勢較高地區，到了晚期距今約三千七、八百年前，並向河流中游丘陵山地地區分布，遺址遍及苗栗縣、臺中市、彰化縣、南投縣等地，範圍極廣。\n　　番仔園文化年代距今約2000至400年之前，分布範圍包括臺中市大肚台地西側緩坡、台中盆地、往南延伸至八卦台地、北至苗栗縣南部海岸丘陵。代表遺址包括臺中市大甲區番仔園、外埔區麻頭路、清水區中社、沙鹿區鹿寮考古遺址、南勢坑遺址、龍井區山腳、龍泉村、臺中市南屯區山仔腳考古遺址、西屯區惠來考古遺址上層等。\n　　惠來考古遺址可說是臺灣中部地區考古史上的重大發現，對聚落形態的研究具有學術意義。牛罵頭文化的器型及番仔園文化的鐵器及墓葬與臺灣北部、南部地區不同而且內涵豐富。出土的遺物、現象及墓葬、柱洞反映村落的佈局，保存相當良好，為本土教育及展示的最佳場域。\n　　惠來考古遺址歷年來在教育推廣方面已頗具成效，目前以簡易遺址公園之最小密度開發方式予以公園化保存，園區展示棚架內委請專家復原界牆及坑底，並完成有人骨、獸骨、柱洞、筏子溪流域等模型，園區周圍亦完成植栽，整體園區規劃已具有保存文化資產及社教展示之功能，為市民提供一處兼具文化教育與休憩之用的綠地。\n\n","url":"https://youtu.be/l45UbppkHXY"}],"documents":["https://data.boch.gov.tw/upload/documents/2022-01-19/637f18af-955b-4f91-9ddf-5552089f6be8/01-市定惠來考古遺址-指定公告990106.pdf","https://data.boch.gov.tw/upload/documents/2022-01-19/de7fee8d-ffa1-4ded-ac8b-e837bf3ac955/02-市定惠來考古遺址-第1次變更公告1070604.pdf","https://data.boch.gov.tw/upload/documents/2022-01-19/eac17adb-41ce-4765-9878-771a163244fc/03-惠來考古遺址清冊.docx"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"臺中市七期重劃區（抵費地）"}],"govInstitution":"臺中市文化資產處","govDeptName":"遺址傳藝課","govDeptAddress":"臺中市西區市府路41巷19號","govDeptPhone":"04-22290280","repImgId":224780},{"caseId":"20110831000001","caseName":"西大墩考古遺址","assetsClassifyCode":"2.1.2","assetsClassifyName":"直轄市定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性","具其他遺址價值者"],"registerReason":"1.在文化發展脈絡中之定位及意義性：具有牛罵頭文化、番仔園文化；遺址出土之祭祀遺物罕見於臺灣，亦屬同一時期第一次發現。\n2.在學術研究史上意義性：祭祀遺物之首次發現，具學術史意義；三連杯、陶器、玉梳型玉飾極為特殊。\n3.遺址文化堆積內涵之特殊性及豐富性：文化層堆積雖非深厚，但內涵十分特殊。\n4.同類型遺址數量之稀有性：臺中市其有牛罵頭文化之考古遺址雖多，但僅有本考古遺址出現相當稀少性祭把遺跡，目前出土之玉器型態為全國獨有。\n5.遺址保存狀況之完整性：遺址東側部分受道路、建築及農民耕作影響，西側保存完整。\n6.遺址供展示教育規劃之適當性：:結合考古遺址係存、節能減碳之教育休閒功能，與主題公園並存，可充分發揮展示教育功能。\n7.具其他遺址價值者：遺址保存、展示尚能結合鄰近自行車步道，兼顧觀光休閒產業。","lawsReference":"\u003c\u003c遺址指定及廢止審查辦法\u003e\u003e第3條第1項第1、2、3、4、5、6、7款","govInstitutionName":"臺中市政府","addresses":[{"itemNo":1,"cityName":"臺中市","distName":"西屯區","address":"環中路二段、福科路與福科二路間"}],"longitude":120.636111,"latitude":24.1775,"relativePosition":"臺中市第12期福星市地重劃區內，西側緊鄰中彰快速道路、環中路，北鄰福科路","neighborPosition":"","representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/upload/representImageFile/2023-06-02/f5eea76f-b233-4e06-a6c3-0f9ba9105afd/_DSC0405_c.jpg"},"original":"https://data.boch.gov.tw/upload/representImageFile/2023-06-02/f5eea76f-b233-4e06-a6c3-0f9ba9105afd/_DSC0405.jpg","name":"_DSC0405"},"representImageSource":"臺中市文化資產處","landScope":"臺中市西屯區福德段81地號","discoveryDescription":"98年3月24日至6月11日，國立自然科學博物館進行搶救發掘，共進行35條探溝和22個2公尺見方的探坑發掘。99年4月24日至7月5日，進行第二次的搶救發掘，共進行7條探溝和102個2公尺見方的探坑發掘。","nearbyArcheologyCheck":"位於或鄰近普查遺址","nearbyArcheologyBrief":"馬龍潭遺址邊緣北側偏東約500公尺內","cultralMean":"","pastHistory":"1.\t西大墩考古遺址位在筏子溪東側，遺址有三層文化層堆積，基地西側仍保存完整文化層，範圍內有西大墩兒童運動中心，遺址附近有距今一百多年的市定古蹟張廖家廟。\n\n2.\t遺址的上文化層包含距今約100〜200年間清歷史時期的遺留，中層是距今約1,300〜1,700年間番仔園文化層、下層是距今約3,500〜4,500年間牛罵頭文化層。\n\n3.\t牛罵頭文化層中出土極為特殊罕見的大型閃玉圭、大型石刀及數百件梳型玉飾，及上下相扣的三連杯及多量陶網墜同時出現。\n\n4.\t推測大型石刀是代表祈求農作豐收，集中出土的陶網墜代表祈求漁獲，及首次發現大型玉圭、玉梳為象徵禮天之用。\n\n5.\t臺中市具有牛罵頭文化層之考古遺址雖多，但目前僅有本考古遺址出現祭祀遺跡，西大墩考古遺址可說是臺灣中部地區考古史上的重大發現，對聚落形態的研究具有學術意義。","actualStatus":"西大墩考古遺址現為西大墩公園，目前由臺中市政府建設局進行公園維護管理。考古遺址的管理維護以現狀保存為方針，將考古遺址破壞程度降至最低，並依據文化資產保存法相關規定，維持考古遺址所定著土地上地形地貌之完整性。","usageStatus":"公園使用狀況良好，每月至少進行2次市定考古遺址巡查及其他監管保護。","landUsage":"目前臺中市政府建設局規劃為環保節能減碳主題公園","announcementList":[{"classification":"變更/修正","officialDocNo":"府授文資遺字第10701189952號","registerDate":"2018-06-04 00:00:00.0"},{"classification":"指定/登錄","officialDocNo":"府授文資字第1000165322號","registerDate":"2011-08-31 18:49:24.0"}],"landlotList":[{"itemNo":1,"cityName":"臺中市","distName":"西屯區","landNo":"福德段","landSerialNo":"81","landownership":"公有","cityLandUseType":"其他使用區","cityLandUseTypeOther":"公園用地","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20110831000001","mediaImageList":[{"mediaName":"不同角度","url":"https://data.boch.gov.tw/upload/media/2022-08-15/e0fa13fb-d0b3-48e9-b2ea-ba928a983c1f/1.jpg"},{"mediaName":"西大墩考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/04bda95f-8dcf-49a5-8a2a-df664abd2f04/_DSC0705.jpg"},{"mediaName":"西大墩考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/f42af47d-5821-4e9f-8627-2277474338b9/_DSC0984.jpg"},{"mediaName":"西大墩考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/0f45b68c-ea98-4706-b669-b827e1d3eb81/_DSC0986.jpg"},{"mediaName":"西大墩考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/5c55c986-c925-4a16-9746-8b534bde2157/_DSC1139.jpg"},{"mediaName":"西大墩考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/8275eb06-de8f-464f-8ade-c348d225cbc7/_DSC1935.jpg"}],"mediaVideoList":[{"mediaName":"【影音】臺中市市定考古遺址：西大墩考古遺址","description":"西大墩考古遺址簡介：\n　　本考古遺址地層堆積分有四層，表土層、文化層、生土層及礫石層等，文化層則包括中部歷史時期的遺留、番仔園和牛罵頭文化層，上層的年代距今約100~200年間，中層的年代距今約1300~1700年間，下層的年代距今約3000~4500年間，充分顯現臺中盆地從4000年前到數百年前，文化層具有牛罵頭文化、番仔園文化等特色，雖文化層堆積並不深厚，但其內涵十分特殊，遺址出土之祭祀遺物三連杯、陶器、玉梳型玉飾等皆極為特殊罕見於臺灣，亦屬首次發現，與本市發展關係密切。\n\n指定理由：\n1. 在文化發展脈絡中之定位及意義性：具有牛罵頭文化、番仔園文化；考古遺址出土之祭祀遺物罕見於臺灣，亦屬同一時期第一次發現。\n2. 在學術研究史上意義性：祭祀遺物之首次發現，具學術史意義；三連杯、陶器、玉梳型玉飾極為特殊。\n3. 考古遺址文化堆積內涵之特殊性及豐富性：文化層堆積雖非深厚，但內涵十分特殊。\n4. 同類型考古遺址數量之稀有性：牛罵頭文化遺址雖多，但具祭祀遺跡相當稀少，目前出土之玉器形態為全國獨有。\n5. 考古遺址保存狀況之完整性：東側部分受道路、建築及農民耕作影響，西側保存完整。\n6. 考古遺址供展示教育規劃之適當性：結合遺址保存、節能減碳之教育休閒功能，與主題公園並存，可充分發揮展示教育功能。\n7. 具其他考古遺址價值者：遺址保存尚能結合鄰近自行車步道，兼顧觀光休閒產業。","url":"https://youtu.be/xyx-8FKfnU8"}],"documents":["https://data.boch.gov.tw/upload/documents/2022-01-19/a18d04eb-43a0-434c-848a-99cc5043191e/1000831_西大墩考古遺址_指定公告.pdf","https://data.boch.gov.tw/upload/documents/2022-01-19/a00b38c2-8bad-4b51-8cf7-96f2fbc225c7/1070604_西大墩考古遺址_變更公告.pdf","https://data.boch.gov.tw/upload/documents/2022-01-19/2175c800-5ceb-45bf-b526-5670a1cc4cbf/04-市定西大墩考古遺址清冊.docx"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"臺中市政府"}],"govInstitution":"臺中市文化資產處","govDeptName":"遺址傳藝課","govDeptAddress":"臺中市西區市府路41巷19號","govDeptPhone":"04-22290280","repImgId":224774},{"caseId":"20130118000004","caseName":"麻糍埔考古遺址","assetsClassifyCode":"2.1.2","assetsClassifyName":"直轄市定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性","具其他遺址價值者"],"registerReason":"1.在文化發展脈絡中之定位及意義性：具有從營埔文化至番仔園文化早期發展歷程之特徵。\r\n2.在學術研究史上意義性：為臺中盆地內之大型遺址，具聚落遺址研究意義。\r\n3.遺址文化堆積內涵之特殊性及豐富性：有豐富的史前遺留，具牛罵頭、營埔及番仔園3個文化層。\r\n4.同類型遺址數量之稀有性：臺中盆地內類似的遺址僅一、兩處。\r\n5.遺址保存狀況之完整性：遺址文化層堆積完整，保存良好。\r\n6.遺址供展示教育規劃之適當性：位於臺中都會區，交通便利，且遺址所在之文高48、文中48用地，未來可考量作展示教育之規劃。\r\n7.具其他遺址價值者：保有原臺中盆地的自然環境。","lawsReference":"\u003c\u003c遺址指定及廢止審查辦法\u003e\u003e第3條第1項第1、2、3、4、5、6、7款","govInstitutionName":"臺中市政府","addresses":[{"itemNo":1,"cityName":"臺中市","distName":"南屯區","address":"位於臺中市南屯區鎮平里及豐樂里，鄰近永順路、黎明路與環中路。"}],"longitude":120.634213,"latitude":24.127463,"relativePosition":"","neighborPosition":"鄰近大慶火車站、中山醫學大學。","representImage":{"ext":"JPG","transform":{"c":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/37465/photo/f0820ac2-126f-4ad6-901d-42e033c8ca88_c.JPG"},"original":"https://data.boch.gov.tw/old_upload/_upload/Assets_new/archeology/37465/photo/f0820ac2-126f-4ad6-901d-42e033c8ca88.JPG","name":"f0820ac2-126f-4ad6-901d-42e033c8ca88"},"representImageSource":"臺中市文化資產處","landScope":"南屯區楓溪段37、38、39、40、41、42、43、44、248、254、363、364、365、366地號。","discoveryDescription":"1997年南屯文化工作隊在豐樂段地號1191－5附近地表發現橙色、灰黑色夾砂陶及磨製石刀、石器殘件，當時命名為麻糍埔遺址（劉益昌1997：台中縣考古遺址資料表）。","nearbyArcheologyCheck":"位於或鄰近列冊遺址","nearbyArcheologyBrief":"","cultralMean":"","pastHistory":"1.\t麻糍埔考古遺址位於臺中市南屯區鎮平里及豐樂里，鄰近永順路、黎明路、環中路及永春東三路，為臺中盆地內之大型遺址，具聚落遺址研究意義。\n\n2.\t遺址具有豐富的史前遺留，包括牛罵頭文化、營埔文化、番仔園文化層，但牛罵頭文化層已遭歷次洪氾破壞，僅見繩紋陶片偶而在礫石層與青灰色河砂層之上。麻糍埔營埔文化年代距今約2300年∼2700年，發現有數排礫石列似房屋的結構現象，周邊有一小型疑似引水溝渠，文化層厚度約130公分，出土陶獸足達150 隻，經過修復後為多個3足侈口鼎型器，此外有束腰罐、豆型器、帶流罐等，屬營埔文化特殊器型。\n\n3.\t麻糍埔番仔園文化層距今1000到1600年間，與惠來遺址番仔園文化層年代相近。麻糍埔遺址陶器特色為灰胎細砂陶，陶器類型包括罐形器、缽形器、瓢形器、缸形器、瓶形器、圈足、杯、陶紡輪、陶環、陶珠、陶蓋及陶把等，其中修復直徑達百公分的大缸形器在國內遺址罕見。石器方面本遺址出現許多完整的網墜，在惠來遺址番仔園文化層則無。麻糍埔遺址之內涵研究有助於探討大肚王之跨部落聯盟如何影響台中平原南側、八卦台地、彰化平原族群之互動。\n\n4.\t麻糍埔遺址文化層保存狀況良好，附近有舊南屯溪自然景觀，若能結合附近清代書院輔之居整體規劃，將是最佳教育展示地點。\n\n","actualStatus":"由土地管理機關依權管事項進行維護。","usageStatus":"由土地管理機關依權管事項進行維護。","landUsage":"麻糍埔考古遺址定著土地使用分區名稱為社教9、社教10、公兼滯11、公163、公164用地。","announcementList":[{"classification":"變更/修正","officialDocNo":"府授文資遺字第11401838111號","registerDate":"2025-07-02 15:57:28.598"},{"classification":"變更/修正","officialDocNo":"府授文資遺字第10802392581號","registerDate":"2019-10-16 00:00:00.0"},{"classification":"變更/修正","officialDocNo":"府授文資遺字第1030111354號","registerDate":"2014-06-19 00:00:00.0"},{"classification":"指定/登錄","officialDocNo":"府授文資二字第1020011082號","registerDate":"2013-01-18 09:26:17.0"}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20130118000004","mediaImageList":[{"mediaName":"不同角度","url":"https://data.boch.gov.tw/upload/media/2022-08-15/fda675a1-babd-4b55-aee6-0e6d7a498600/1.jpg"},{"mediaName":"麻糍埔考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/e6113682-1f7a-4fe8-990f-47f152a59d4f/DSC_3377.jpg"},{"mediaName":"麻糍埔考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-07-21/fb5f3290-e723-4185-9b8a-a7b432405192/DSC_3719.jpg"},{"mediaName":"麻糍埔考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/74b732ba-028b-443a-bd15-4417dbe7ec6c/DSC_3719.jpg"},{"mediaName":"麻糍埔考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/f35ef41b-6796-4753-b24f-bd89c3c5539e/DSC_3723.jpg"},{"mediaName":"麻糍埔考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/db08fc0d-c05f-4c50-bab1-af18cb3eac04/DSC_3773.jpg"},{"mediaName":"麻糍埔考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/e2b3fb82-04bf-4a2a-a522-ffb24941f682/DSC00036.jpg"},{"mediaName":"麻糍埔考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/4cbdd8c3-f5b3-4e34-81ab-ed3a116c0ef9/DSC00042.jpg"},{"mediaName":"麻糍埔考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/016c2563-d83c-4f94-99d4-cdde12a828df/DSC00659.jpg"},{"mediaName":"麻糍埔考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/8c05e625-4581-4aee-b4ef-50016e343e8f/DSC00664.jpg"},{"mediaName":"麻糍埔考古遺址","url":"https://data.boch.gov.tw/upload/media/2023-06-02/f470142e-fddb-431b-a4ef-7f682992d446/IMG_20181226_153056.jpg"}],"mediaVideoList":[{"mediaName":"【影音】臺中市市定考古遺址：麻糍埔考古遺址","description":"麻糍埔考古遺址指定理由：\n1. 在文化發展脈絡中之定位及意義性：具有從營埔文化至番仔園文化早期發展歷程之特徵。\n2. 在學術研究史上意義性：為臺中盆地內之大型考古遺址，具聚落遺址研究意義。\n3. 考古遺址文化堆積內涵之特殊性及豐富性：有豐富的史前遺留，具牛罵頭、營埔及番仔園3個文化層。\n4. 同類型考古遺址數量之稀有性：臺中盆地內類似的考古遺址僅一、兩處。\n5. 考古遺址保存狀況之完整性：遺址文化層堆積完整，保存良好。\n6. 考古遺址供展示教育規劃之適當性：位於臺中都會區，交通便利，且考古遺址所在之文高48、文中48用地，未來可考量作展示教育之規劃。\n7. 具其他考古遺址價值者：保有原臺中盆地的自然環境。","url":"https://youtu.be/y8hxMLNabVo"}],"documents":["https://data.boch.gov.tw/upload/documents/2022-01-19/3cef7753-517c-4910-bd55-d6544081defa/1020118_麻O埔考古遺址_指定公告.pdf","https://data.boch.gov.tw/upload/documents/2022-01-19/0abf622f-b6f6-47ec-8c78-c3a683f82059/1030619_麻O埔考古遺址_變更公告.pdf","https://data.boch.gov.tw/upload/documents/2022-01-19/7533b8a7-e0f6-42ac-870b-13ef23062c57/1081016_麻O埔考古遺址_變更公告2.pdf","https://data.boch.gov.tw/upload/documents/2025-08-22/c3911b7e-aa6c-4e16-aff8-175fcad93fd3/1140702_市定麻糍埔考古遺址調整公告公告_清冊_變更對照表.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"臺中市"}],"govInstitution":"臺中市文化資產處","govDeptName":"遺址傳藝課","govDeptAddress":"臺中市西區市府路41巷19號","govDeptPhone":"04-22290280","repImgId":4546},{"caseId":"20030307000001","caseName":"水蛙窟考古遺址","assetsClassifyCode":"2.1.3","assetsClassifyName":"縣(市)定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","具其他遺址價值者"],"registerReason":"1.考古遺址地下文化層埋葬豐富及完整，並具有新石器中、晚期階段之發展過程。\n2.為研究水蛙窟和大肚溪附近的營埔文化及東部卑南文化互動關係的關鍵性考古遺址。\n3.出土大量玉器及製造工藝遺物，為東、西交通及交換體系的重要考古遺址。\n4.研究聚落佈局及埋葬制度的典型罕見史前考古遺址。\n5.中部埔里盆地群的代表性遺址之一，水蛙堀時期的命名考古遺址。\n6.為南投縣增添一處可以完整保存的代表性考古遺址。\n","lawsReference":"文化資產保存法第111條","govInstitutionName":"南投縣政府","addresses":[{"itemNo":1,"cityName":"南投縣","distName":"埔里鎮","address":"南投縣埔里鎮史港里史港坑段"}],"longitude":120.952669,"latitude":23.999306,"relativePosition":"","neighborPosition":"","representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/upload/representImageFile/2023-10-02/aa345f62-8124-49e7-8501-7d083724a1a8/水蛙窟考古遺址_c.jpg"},"original":"https://data.boch.gov.tw/upload/representImageFile/2023-10-02/aa345f62-8124-49e7-8501-7d083724a1a8/水蛙窟考古遺址.jpg","name":"水蛙窟考古遺址"},"representImageSource":"南投縣政府文化局","landScope":"埔里鎮史港坑段：0292-0003、0292-0004、0292-0013、0292-0014、0292-0015、0292-0016、0292-0017、0292-0019、0292-0048、0292-0054、0292-0076等11筆台灣糖業股份有限公司私有土地，面積共計121,453平方公尺。","discoveryDescription":"本考古遺址是1970年代張光直先生主持的「濁大計劃」中，考古學組尹因印（R.Stamps）先生調查時發現，曾經進行小面積試掘，出土豐富的文化遺物，也有清晰的年代測定。","nearbyArcheologyCheck":"位於或鄰近列冊遺址","nearbyArcheologyBrief":"和大馬璘考古遺址一樣同屬大型聚落遺址，史前時代為台灣東西部之間往來交通的重要中繼站。","cultralMean":"1.考古遺址地下文化層埋葬豐富及完整，並具有新石器中、晚期階段之發展過程。\n2.為研究水蛙窟和大肚溪附近的營埔文化及東部卑南文化互動關係的關鍵性考古遺址。\n3.出土大量玉器及製造工藝遺物，為東、西交通及交換體系的重要考古遺址。\n4.研究聚落佈局及埋葬制度的典型罕見史前考古遺址。\n5.中部埔里盆地群的代表性遺址之一，水蛙堀時期的命名考古遺址。\n6.為南投縣增添一處可以完整保存的代表性考古遺址。","pastHistory":"本考古遺址是1970年代張光直先生主持的「濁大計劃」中，考古學組尹因印（R.Stamps）先生調查時發現，曾經進行小面積試掘，出土豐富的文化遺物，也有清晰的年代測定。 雖然本考古遺址發現至今已有多年，但研究仍相當稀少，「濁大計劃」時尹因印（R.Stamps）先生雖對遺址內涵多所著墨，但並未明確指出遺址範圍，此後學者即少有研究，自1980年代初期石璋如、劉益昌先生接手整理埔里大馬璘考古遺址初步報告以來，劉益昌先生針對性質相關的水蛙窟考古遺址曾經進行數次調查，但由於地上種滿牧草或長滿雜草很難進行調查，通常只在考古遺址最南邊道路東側農民耕作的階梯式田園的邊緣所切出的斷面，以及眉溪侵蝕遺址所在的紅土台地邊緣發現文化層堆積及文化遺物，但已經相當豐富\n1996年考古遺址遭受耕作大量破壞時，在考古遺址北側也出現清晰的文化層堆積與大量遺物，說明考古遺址的範圍超出學者早期的記錄。為進一步了解考古遺址的情形，劉益昌先生在1996年12月25日前往考古遺址進行現地勘查，考古遺址範圍如以此次觀察所得的結果而言，地表所見遺物出土分布範圍相當大，東西寬約400公尺，南北長約800公尺以上，西側確切範圍不清楚，南側亦因面臨眉溪階崖邊不斷崩塌，因此範圍當不只如此。1997年自然科學博物館利用文建會主辦的「地方考古人才培訓班」田野實習課程進行試掘工作，發掘探坑六處，發現豐富文化遺物及八處石板棺墓葬，並進行年代測定（何傳坤等 1997），使我們瞭解這個考古遺址可能擁有更豐富且複雜的文化內涵與演化機制，再次說明這個考古遺址的重要性。但新的年代出現反而使考古遺址的內涵及水蛙窟類型與大馬璘文化類型的關係更加模糊，且由於發掘的性質著重培訓班的實習性試掘與搶救工作，考古遺址的範圍亦未釐清。\n土地目前部分為旱作使用，有部分建築，其餘大多為廢耕田園但早期都經旱作。考古遺址所在為一緩坡，俯瞰埔里盆地，史港溪及眉溪在遺址東及南方匯合成溪，景觀良好視野廣闊。\n\n\n","actualStatus":"台糖公司租賃給耕農辦理「縣定水蛙窟遺址保土生態園藝栽培暨文化資產利用案」，業經本縣106年12月21日文化資產審議會核定在案，並請本局考古遺址專案人員每月執行巡查監管保護持續追蹤現況。","usageStatus":"種植淺層作物","landUsage":"台糖公司租賃給耕農辦理「縣定水蛙窟遺址保土生態園藝栽培暨文化資產利用案」，業經本縣106年12月21日文化資產審議會核定在案，並請本局考古遺址專案人員每月執行巡查監管保護持續追蹤現況。","announcementList":[{"classification":"指定/登錄","officialDocNo":"府授文資字第10702620561號公告","registerDate":"2018-11-20 00:00:00.0"}],"landlotList":[{"itemNo":1,"cityName":"南投縣","distName":"埔里鎮","landNo":"史港坑段","landSerialNo":"0292-0003","landownership":"私有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"特定目的事業用地"},{"itemNo":2,"cityName":"南投縣","distName":"埔里鎮","landNo":"史港坑段","landSerialNo":"0292-0004","landownership":"私有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"特定目的事業用地"},{"itemNo":3,"cityName":"南投縣","distName":"埔里鎮","landNo":"史港坑段","landSerialNo":"0292-0013","landownership":"私有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"特定目的事業用地"},{"itemNo":4,"cityName":"南投縣","distName":"埔里鎮","landNo":"史港坑段","landSerialNo":"0292-0014","landownership":"私有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"特定目的事業用地"},{"itemNo":5,"cityName":"南投縣","distName":"埔里鎮","landNo":"史港坑段","landSerialNo":"0292-0015","landownership":"私有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"特定目的事業用地"},{"itemNo":6,"cityName":"南投縣","distName":"埔里鎮","landNo":"史港坑段","landSerialNo":"0292-0016","landownership":"私有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"特定目的事業用地"},{"itemNo":7,"cityName":"南投縣","distName":"埔里鎮","landNo":"史港坑段","landSerialNo":"0292-0017","landownership":"私有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"特定目的事業用地"},{"itemNo":8,"cityName":"南投縣","distName":"埔里鎮","landNo":"史港坑段","landSerialNo":"0292-0019","landownership":"私有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"特定目的事業用地"},{"itemNo":9,"cityName":"南投縣","distName":"埔里鎮","landNo":"史港坑段","landSerialNo":"0292-0048","landownership":"私有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"特定目的事業用地"},{"itemNo":10,"cityName":"南投縣","distName":"埔里鎮","landNo":"史港坑段","landSerialNo":"0292-0054","landownership":"私有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"特定目的事業用地"},{"itemNo":11,"cityName":"南投縣","distName":"埔里鎮","landNo":"史港坑段","landSerialNo":"0292-0076","landownership":"私有","noncityLandUseType":"特定農業區","noncityLandUseTypeOther":"特定目的事業用地"}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20030307000001","mediaImageList":[{"mediaName":"水蛙窟考古遺址範圍空拍","author":"禾影文化影像工作室","takePhotoDate":"2023年","url":"https://data.boch.gov.tw/upload/media/2023-10-02/e21ae2e2-a0ee-4893-8814-98da88f6f010/水蛙窟考古遺址範圍空拍.jpg"},{"mediaName":"水蛙窟考古遺址告示牌","author":"禾影文化影像工作室","takePhotoDate":"2023年","url":"https://data.boch.gov.tw/upload/media/2023-10-02/e93ec057-9ae4-41f8-a3f6-6eca0a6b4482/水蛙窟考古遺址告示牌.jpg"}],"documents":["https://data.boch.gov.tw/upload/documents/2019-01-16/db9f0752-3e33-4e22-8325-ded36d6703a8/107年12月8日考古遺址更正公告.jpg"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"台OOOOOOOOO"}],"govInstitution":"南投縣政府","govDeptName":"文化資產科","govDeptAddress":"略","govDeptPhone":"略","repImgId":232331},{"caseId":"20091030000002","caseName":"大馬璘考古遺址","assetsClassifyCode":"2.1.3","assetsClassifyName":"縣(市)定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性","具其他遺址價值者"],"registerReason":"一、大馬璘考古遺址為日治時期初所發現的遺址，從發現至今，共經歷了9次考古發掘工作，由每一次的調查及考古發掘的資料顯示，大馬璘考古遺址的地下資料是相當豐富而多元的。由於文化內涵具有獨特性且具代表性，因此學界稱為大馬璘文化，本文化發展於距今3600-1000年前的大埔里地區，亦涵蓋了埔里地區水蛙窟、大馬璘及曲冰等重要的考古遺址。\n二、保留大馬璘文化之完整地層，其稀有性與重要性不言可喻，且深具現地保存與現地展示、教育的潛能。\n","lawsReference":"文化資產保存法第111條","govInstitutionName":"南投縣政府","addresses":[{"itemNo":1,"cityName":"南投縣","distName":"埔里鎮","address":"南投縣埔里鎮愛蘭里，位於烏牛欄聚落南側，醒靈寺西側，南港溪右岸階崖上方"}],"longitude":120.944872,"latitude":23.96915,"representImage":{"ext":"jpeg","transform":{"c":"https://data.boch.gov.tw/upload/representImageFile/2023-09-15/2cfdcc30-f355-4145-aed4-864a2ec7c2f3/大馬璘考古遺址入口_c.jpeg"},"original":"https://data.boch.gov.tw/upload/representImageFile/2023-09-15/2cfdcc30-f355-4145-aed4-864a2ec7c2f3/大馬璘考古遺址入口.jpeg","name":"大馬璘考古遺址入口"},"representImageSource":"南投縣政府文化局","landScope":"南投縣埔里鎮大馬璘段989、990、991、992、993、994、995、996、997地號等9筆土地南投縣埔里鎮大馬璘段989、990、991、992、993、994、995、996、997地號等9筆土地，面積總計為17053.97平方公尺。","discoveryDescription":"原為國軍營地，建築係屬低矮之平房，歷年來少有學者進入此一區域研究，惟國軍營區撤除後，南投縣政府教育處規劃設立射箭訓練中心，民國97年1月29日經埔里地區文史工作者通報南投縣政府文化局，南投縣政府於98年10月30日公告為縣定遺址。","nearbyArcheologyCheck":"位於或鄰近列冊遺址","nearbyArcheologyBrief":"縣定水蛙窟考古遺址","cultralMean":"大馬璘遺址的 2007 年及 2008-9 年的發掘資料中，其所見的大馬璘文化層 可見上下壓疊的生活面，證明該時期的史前人群有長期定居且反覆利用土地的發展傾向，不過在生活面之間往往亦留有短期間隔的不毛堆積地層，在 2009 年發 掘的南側區域具有早、中、晚三個不同的居住面，而根據地層堆積及年代測定結 3 果，說明大馬璘遺址得見大馬璘文化早、中、晚三大發展階段（劉益昌等 2009： 134）。參考水蛙堀、曲冰遺址得見的 1600-700B.P.之間的堆積，極可能是大馬璘 文化最末時期的堆積，如此大馬璘文化則有四期的發展與衰退過程（劉益昌 2013）。大馬璘文化早期（距今 3300-2800 年）出土之陶片以具營埔文化要素之 灰黑陶為代表，另外有小部分遺物呈現東部史前物質文化要素，且常出現向下打 破至生土層甚至礫石層的長方形凹坑現象，推測為半地穴居式之居住型態，半地 穴居之空間內常伴隨火塘現象，且半地穴居之空間外常伴隨圓形淺狀的灰坑現象， 約略可見當時家戶的空間配置模式；大馬璘文化中期（距今 2800-2300 年）出土 陶器已有明顯變遷，具有營埔文化與大馬璘文化要素的陶類大致相當，地層中石 板棺密集出現，並得見大量石材、石廢料密集堆置的區域，其上方則為清楚的列 石結構現象，當為地面式居住遺留，其方向與前一階段半地穴式住居不同，形式 也不相同，透過地層相對關係，可知當為長方形石板棺墓葬發展之最早階段，普 遍可見東部史前文化要素大量涉入大馬璘地區，並發展出大馬璘文化獨有物質特 色之最主要階段，推測此時期內大馬璘遺址上之人群生活同時接受來自東部與西 部沿海之史前物質文化要素，並在兩種物質文化基礎上發展出獨有的文化內涵； 大馬璘文化晚期（距今 2300-1700 年）陶片類型以大馬璘文化晚期類型之褐色夾 粗砂陶、中砂陶為主，文化層內亦含有大量之石器，亦延續長方形石板棺的墓葬 形式，推測為大馬璘文化中、晚期受東部史前文化要素影響之延續，呈顯出史前 時期某種共通之社會文化概念，而非單純的物質文化採借；大馬璘文化末期（距 今 1700-700 年）人群似乎在距今 1700 年左右離開大馬璘遺址，也逐漸離開埔里 盆地群，最後僅剩零散居住的人群，而進入濁水溪上游區域，亦即陳仲玉所稱曲 冰遺址的零星佔居期（陳仲玉 1994：201），文化遺物似乎仍維持大馬璘文化晚 期淡褐灰色夾砂陶的特徵，而且也大量使用石器，是否具有金屬器，仍無法確認 （劉益昌 2013：91）。 \n大馬璘文化在西海岸中部區域的分布，遺址（亦即聚落）分布於埔里盆地及 周邊區域，呈現嵌入於營埔文化與東埔一鄰文化之間的狀態，學者認為台灣東部 花岡山文化的人群，透過早期繩紋紅陶階段的互動與交換關係，逐步進入埔里地 區才在距今 3200-2800 年之間，選擇遷移進入埔里地區並形成大馬璘文化中期特 殊的文化內涵。設若如此，遷移的人群是否屬於小眾的工匠集團或是更多的人群 移入，則是目前必須進一步研究才能理解的課題（劉益昌 2013：99-100）。 \n綜觀上述歷來研究結果，大馬璘考古遺址保留大馬璘文化之完整地層，其稀 有性與重要性不言可喻，且深具現地保存與現地展示、教育的潛能。符合《文化 資產保存法》及《考古遺址指定及廢止審查辦法》第 3 條「1、考古遺址在文化 發展脈絡中之定位及意義性。2、考古遺址在學術研究史上意義性。3、考古遺址 文化堆積內涵之特殊性及豐富性。4、考古遺址保存狀況之完整性。5、考古遺址 供展示教育規劃之適當性。6、具其他遺址價值者。」無論於文化發展脈絡及學 術研究意義，皆有不可取代之重要性。\n","pastHistory":" 1900（明治 33）年日籍學者鳥居龍藏進行埔里社人類學調查時，於烏牛囒高 丘（即為大馬璘考古遺址所在台地）發現石器時代考古遺物（鳥居龍藏 1900）。 日治末期，鹿野忠雄在討論台灣史前文化地位，指出此一考古遺址所代表的文化， 還指出遺址的文化大致屬於西海岸系統，但也間有東海岸系統，從大馬璘考古遺 址出土石料，推定大馬璘考古遺址與東海岸之間，曾經有著透過中央山脈而互相 交通的關係（宋文薰譯 1955：104）。 \n1948 年 8 月，宋文薰進行大馬璘考古遺址的考古調查工作，採集所得的陶片中有二件為黑色彩繪網紋陶片，國分直一據此闡述營埔與大馬璘考古遺址為同 一系統之先史文化遺留（宋文薰譯 1956）。 \n1949 年 7 月中央研究院歷史語言研究所與國立台灣大學考古人類學系組成 發掘研究團隊，在「林氏學田」的資助之下，對遺址進行較大規模的考古研究工作，發現大量的石器、陶器等文化遺物，以及灰坑、石棺及類似建築的砌石牆、 鋪石地面等遺跡（石璋如 1953，石璋如、劉益昌 1987）。\n1970 年代「濁大計劃」進行濁大流域考古研究調查時，大馬璘考古遺址為該 計畫選定之重要研究遺址，Richard B. Stamps（尹因印）進行小規模發掘研究及年 代測定（Stamps 1977），所得資料為濁大計劃建立黑陶文化研究之重要基礎資料， 計畫主持人張光直以大馬璘考古遺址、洞角考古遺址、營埔考古遺址出土資料所 見灰黑陶特徵而建立中部史前文化層序中的灰黑陶文化，其中並以大馬璘考古遺 址為代表稱為大馬璘式黑陶文化（張光直 1977：424）。 \n1986 年中央研究院歷史語言研究所為完成 1949 年進行的大馬璘遺址發掘資 料之整理，因此派遣劉益昌前往大馬璘遺址及其周邊區域進行考古調查，除觀察 遺址之現狀外，並採取部分標本做為比對研究之用（石璋如、劉益昌 1987）。 \n1992 年內政部、文建會委託中國民族學會的「台灣地區重要考古遺址初步 評估第一階段研究」計畫，大馬璘考古遺址被考古學者選定為台灣地區重要考古 遺址之一，並建議儘速規劃部份地區進行現址保存並應指定為古蹟（宋文薰等 1992）。2004 年內政部主政文化資產古蹟類別時期委請中央研究院歷史語言研究 所進行南投縣考古遺址普查，大馬璘考古遺址資料表中亦提出本遺址與已定等古 蹟同等重要之評估意見（劉益昌等 2004：0802-TML-4）。 \n1996 年埔里高中因為興建女生宿舍之需，在梅村路旁一塊素地擬議興建， 因此在埔里地方人士協調之下進行工程前之考古搶救發掘，這是大馬璘遺址第一 次進行考古搶救發掘，也是首次進行塊狀區域發掘工作，獲得石板棺與建築基地 之關係，確認文化層生活面與埋葬行為的關連（劉益昌 1998、2000a）。 \n2000 年因財團法人埔里基督教醫院進行院區醫療大樓之施工工程而委託劉 益昌進行考古搶救工作，也發掘出土豐富的陶、石器及灰坑、火塘、柱洞、石板 棺、石器作坊等重要遺跡（劉益昌 2000b 未刊稿）。2006-2007 年由於大馬璘段 地號 330 等四筆土地為興建私人住宅，在經進行調查研究後，確認局部區域文化 層厚實，發現該基地具有相當豐富的文化遺物與遺跡（劉益昌 2007）。 \n2003-2004 年埔基醫院委託國立自然科學博物館進行埔基醫院醫療大樓第四 期工程（A 棟）的 B 區進行考古搶救，共計發掘 70 個 2 公尺×2 公尺共計 280 平 方公尺的面積，該次發掘更加確認遺址為一個橫跨新石器時代中、晚期的大型聚 落，佔居時間長達 2500 年，並確認具有中部牛罵頭文化成分、東部卑南文化成分、中部營埔文化成分與大馬璘遺址傳統文化成分（何傳坤、劉克竑 2004）。 \n2008 年在大馬璘考古遺址南側的邊緣，執行「大馬璘遺址射箭中心開發基 地範圍內影響評估考古探坑發掘研究計畫」，計畫評估區域為埔里鎮愛蘭里大馬 璘段 989-997 地號等九筆土地，經發掘發現其地層史前文化層完整、史前遺跡現 象豐富，實應就遺址指定與現地保存進行規劃。本案同時指出大馬璘考古遺址考 古學術研究意義經近年來研究，更進一步確認為大馬璘文化之命名遺址，具有史 前時期東西交通往來之特殊意義，其重要性已等同於國定遺址（劉益昌 2009）。 \n2012 年與 2013 年國立自然科學博物館搶救發掘「埔里基督教醫院長照教學 大樓」，根據試掘結果，可知此區在史前時代確實屬於大馬璘考古遺址的一部分， 有明顯的大馬璘史前文化層，而且在保存情況較良好的區域，有不少史前遺跡， 包括礫石列結構、礫石鋪面、豎立板岩結構等建築結構，以及 2 具小型石板棺， 出土史前遺物的數量與密度相當高（劉克竑 2013、2014）。\n","actualStatus":"大馬璘遺址文化園區","usageStatus":"現地保存/大馬璘遺址文化園區","landUsage":"現地保存/大馬璘遺址文化園區","announcementList":[{"classification":"指定/登錄","officialDocNo":"府授文資字第10702620561號公告","registerDate":"2018-11-20 00:00:00.0","note":"原公告為98年10月30日府授文資字第09802286610號公告"}],"landlotList":[{"itemNo":1,"cityName":"南投縣","distName":"埔里鎮","landNo":"大瑪璘段","landSerialNo":"989","landownership":"公有","noncityLandUseType":"山坡地保育區","noncityLandUseTypeOther":""},{"itemNo":2,"cityName":"南投縣","distName":"埔里鎮","landNo":"大瑪璘段","landSerialNo":"990","landownership":"公有","noncityLandUseType":"山坡地保育區","noncityLandUseTypeOther":""},{"itemNo":3,"cityName":"南投縣","distName":"埔里鎮","landNo":"大瑪璘段","landSerialNo":"991","landownership":"公有","noncityLandUseType":"山坡地保育區","noncityLandUseTypeOther":""},{"itemNo":4,"cityName":"南投縣","distName":"埔里鎮","landNo":"大瑪璘段","landSerialNo":"992","landownership":"公有","noncityLandUseType":"山坡地保育區","noncityLandUseTypeOther":""},{"itemNo":5,"cityName":"南投縣","distName":"埔里鎮","landNo":"大瑪璘段","landSerialNo":"993","landownership":"公有","noncityLandUseType":"山坡地保育區","noncityLandUseTypeOther":""},{"itemNo":6,"cityName":"南投縣","distName":"埔里鎮","landNo":"大瑪璘段","landSerialNo":"994","landownership":"公有","noncityLandUseType":"山坡地保育區","noncityLandUseTypeOther":""},{"itemNo":7,"cityName":"南投縣","distName":"埔里鎮","landNo":"大瑪璘段","landSerialNo":"995","landownership":"公有","noncityLandUseType":"山坡地保育區","noncityLandUseTypeOther":""},{"itemNo":8,"cityName":"南投縣","distName":"埔里鎮","landNo":"大瑪璘段","landSerialNo":"996","landownership":"公有","noncityLandUseType":"山坡地保育區","noncityLandUseTypeOther":""},{"itemNo":9,"cityName":"南投縣","distName":"埔里鎮","landNo":"大瑪璘段","landSerialNo":"997","landownership":"公有","noncityLandUseType":"山坡地保育區","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20091030000002","mediaImageList":[{"mediaName":"展示坑區域","author":"禾影文化影像工作室","takePhotoDate":"2023年","url":"https://data.boch.gov.tw/upload/media/2023-09-15/c156f663-0135-43a1-a9eb-912563a15e10/展示坑區域2.jpg"},{"mediaName":"大馬璘考古遺址空拍整體範圍","author":"禾影文化影像工作室","takePhotoDate":"2023年","url":"https://data.boch.gov.tw/upload/media/2023-10-02/3bd5f3f0-b2a7-4594-bd45-ed0c65ae9a1f/大馬璘考古遺址空拍整體範圍.jpeg"},{"mediaName":"展示坑","author":"禾影文化影像工作室","takePhotoDate":"2023年","url":"https://data.boch.gov.tw/upload/media/2023-09-15/1b3bff90-df02-4adf-9058-8e6dd93d8ae8/展示坑.jpg"},{"mediaName":"展示坑-展版簡介","author":"禾影文化影像工作室","takePhotoDate":"2023年","url":"https://data.boch.gov.tw/upload/media/2023-09-15/088e654f-1abe-456d-bac1-ee557149e6e7/展示坑-展版簡介.jpg"},{"mediaName":"展示坑-展版簡介","author":"禾影文化影像工作室","takePhotoDate":"2023年","url":"https://data.boch.gov.tw/upload/media/2023-09-15/1039e7d5-1763-4463-b9eb-8b3e098f5321/展示坑-展版簡介.png"},{"mediaName":"展示坑區域","author":"禾影文化影像工作室","takePhotoDate":"2023年","url":"https://data.boch.gov.tw/upload/media/2023-09-15/5db1bc14-e4b4-4f2b-8e6d-28104575cafe/展示坑區域.jpg"},{"mediaName":"展示坑展版簡介","author":"禾影文化影像工作室","takePhotoDate":"2023年","url":"https://data.boch.gov.tw/upload/media/2023-09-15/86779b5d-2635-4284-8a2a-54c2436224fb/展示坑展版簡介.jpeg"}],"mediaVideoList":[{"mediaName":"大馬璘考古遺址","author":"鑫傳國際多媒體科技股份有限公司","takePhotoDate":"2025年","url":"https://youtu.be/7bttdh5lfDo?si\u003dBhLGR1r5UzfHBQ1_"}],"documents":["https://data.boch.gov.tw/upload/documents/2019-01-16/22f06d90-45f2-484f-9586-f61919a4a9a9/107年12月8日考古遺址更正公告.jpg","https://data.boch.gov.tw/upload/documents/2022-09-27/5261dd0d-52fd-4c43-9d79-3680144e327f/981030大馬璘遺址原公告.jpg"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"中華民國"}],"govInstitution":"南投縣政府文化局","govDeptName":"文化資產科","govDeptAddress":"540南投市建國路135號","govDeptPhone":"2231191","repImgId":231312},{"caseId":"20080923000002","caseName":"古坑‧大坪頂考古遺址","assetsClassifyCode":"2.1.3","assetsClassifyName":"縣(市)定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性","遺址文化堆積內涵之特殊性及豐富性","同類型遺址數量之稀有性","遺址保存狀況之完整性","遺址供展示教育規劃之適當性","具其他遺址價值者"],"registerReason":"一、遺址具完整文化層，含有繩紋紅陶文化及營埔文化二層文化層堆積，文化內涵堆積豐富，且遺跡豐富。\n二、目前保存狀況良好，並與湖山水庫鄰近，具有展示教育之重要性。","lawsReference":"文化資產保存法第46條、第111條暨考古遺址指定及廢止審查辦法第3、4、5條。","govInstitutionName":"雲林縣政府","addresses":[{"itemNo":1,"cityName":"雲林縣","distName":"古坑鄉","address":"雲林縣古坑鄉棋盤村"}],"longitude":120.610722,"latitude":23.688055,"representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/upload/representImageFile/2021-12-13/c749c627-e2f9-4540-aa49-316b2417aeeb/DJI_0330_c.jpg"},"original":"https://data.boch.gov.tw/upload/representImageFile/2021-12-13/c749c627-e2f9-4540-aa49-316b2417aeeb/DJI_0330.jpg","name":"DJI_0330"},"representImageSource":"為承辦人或權責單位自行拍攝或取得授權之圖片。","landScope":"雲林縣古坑鄉棋盤厝段107-1，107-2，107-4，221-71，221-93地號，北緯2620325.999以北至2620782.666以南、東經210947.519以東至211433.065以西之土地(如附圖)","nearbyArcheologyCheck":"位於或鄰近普查遺址","nearbyArcheologyBrief":"無","cultralMean":"古坑．大坪頂遺址含有繩紋陶及營埔式灰黑陶二層文化層之原始堆積，下層繩紋陶文化可與附近梅林遺址銜接，上層灰黑陶文化可與附近林內坪頂的下文化層銜接，灰黑陶紋飾風格質地均與西海岸中部分布甚廣的營埔文化近似。古坑．大坪頂遺址的灰黑陶文化層早期出現印有繩紋的黑色夾砂陶，而且兩個文化層均出土石英質石球，為繩紋陶文化與灰黑陶文化的傳承關係提供重要佐證；並且由灰黑陶文化層普遍打破繩紋陶文化層，且灰黑陶層底部常有繩紋陶遺留的現象可知兩個文化雖有時代先後區別，但很可能曾經混居，時間約在距今三千餘年至二千餘年之間。就雲林縣境新石器時代族群與文化互動關係而言極為重要，同時亦為營埔灰黑陶文化在台灣西海岸中部以南活動提供重要資料。另由遺址地層堆積狀況觀察，兩個文化層居住時期，古坑．大坪頂遺址的地理形貌相差不多，均為離水很近的河階，而且經常受到水患及小型土石流的威脅。出土石質工具反應史前居民生業型態，相當數量的矛鏃形器且大多殘斷顯示史前人狩獵活動頻繁，網墜出現代表亦有漁撈行為，石鋤數量繁多顯示應有農耕活動，均屬台灣新石器時代居民生活之典型。此外本遺址出土多量以打剝石片加工或不加工即作為工具使用，史前人並且利用自然破裂石片作為工具，是為古坑．大坪頂遺址之特色。","pastHistory":"古坑．大坪頂I、II遺址為民國95年經濟部水利署中區水資源局進行湖山水庫工程規劃，在執行環境影響評估文化資產項目調查時發現，隨後經過多次地表考古調查及會勘，由地表遺物分布及斷面暴露的文化層確認為史前遺址。民國97年經由考古試掘及內涵評估發現有繩紋陶及營埔式灰黑陶二層文化層，民國97年8月26日經雲林縣遺址審議委員會通過並公告為縣定遺址。","actualStatus":"遺址西側之侵蝕斷崖仍有不斷崩坍現象，致使考古遺物露出並且掉落斷崖，若無邊坡處理，遺址內涵有持續受損之虞。","usageStatus":"由地表調查發現，文化層堆積較淺，遺址北邊散落數量不少的陶片遺物，可以推測遺址應該已受到農業耕作相當程度的擾動破壞。","landUsage":"一般農業區、特定專用區、森林區","announcementList":[{"classification":"變更/修正","officialDocNo":"府文資二字地1153807919B號","registerDate":"2026-02-26 00:00:00.0","note":"原指定古坑大坪頂遺址重新公告為古坑大坪頂考古遺址並修正理由及法令依據"},{"classification":"指定/登錄","officialDocNo":"府文資字第0972401489號","registerDate":"2008-09-23 09:19:22.0"}],"landlotList":[{"itemNo":1,"cityName":"雲林縣","distName":"古坑鄉","landNo":"棋盤厝段","landSerialNo":"107-1","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":2,"cityName":"雲林縣","distName":"古坑鄉","landNo":"棋盤厝段","landSerialNo":"107-2","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":3,"cityName":"雲林縣","distName":"古坑鄉","landNo":"棋盤厝段","landSerialNo":"107-4","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":4,"cityName":"雲林縣","distName":"古坑鄉","landNo":"棋盤厝段","landSerialNo":"221-71","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":5,"cityName":"雲林縣","distName":"古坑鄉","landNo":"棋盤厝段","landSerialNo":"221-93","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""}],"caseUrl":"http://nchdb.boch.gov.tw/assets/advanceSearch/archaeologicalSite/20080923000002","documents":["https://data.boch.gov.tw/upload/documents/2021-10-04/0d8f1a45-5ce5-4bae-9a0a-9b2745bfe24d/中華民國97年09月23日 府文資字第0972401489號 古坑大坪頂遺址.pdf","https://data.boch.gov.tw/upload/documents/2026-05-20/1c9e92fd-5c00-4184-8dec-5deb5e6a714e/1150226(函+公告)原指定古坑大坪頂遺址重新公告為古坑大坪頂考古遺址並修正理由及法令依據.pdf"],"caseOwnership":[{"ownerType":"土地所有人","ownerName":"經濟部水利署中水資源局"},{"ownerType":"土地所有人","ownerName":"雲林縣政府"}],"govInstitution":"雲林縣政府","govDeptName":"文化觀光處","govDeptAddress":"雲林縣斗六市大學路三段310號","govDeptPhone":"(05)5523218","repImgId":147417},{"caseId":"20061222000006","caseName":"古笨港考古遺址","assetsClassifyCode":"2.1.3","assetsClassifyName":"縣(市)定考古遺址","judgeCriteria":["遺址在文化發展脈絡中之定位及意義性","遺址在學術研究史上意義性"],"registerReason":"一、本案為重要之十七世紀至十九世紀之考古遺留，宜予全面保存。\n二、古笨港考古遺址，位於今日北港溪下游兩岸，因早期北港溪曲流作用旺盛，造成溪流改道沖毀古笨港聚落，致使笨港市街一分為二，南北相隔，而遺址則深埋於河道兩側的地下。\n","lawsReference":"文化資產保存法第46條、第111條暨考古遺址指定及廢止審查辦法第3、4、5條。","govInstitutionName":"雲林縣政府","addresses":[{"itemNo":1,"cityName":"雲林縣","distName":"北港鎮","address":"北港溪，西至堤防，東至雲林縣境內，北緯2607500以北至2608500以南之水利地"}],"longitude":120.295555,"latitude":23.565555,"relativePosition":"","neighborPosition":"","representImage":{"ext":"jpg","transform":{"c":"https://data.boch.gov.tw/upload/representImageFile/2021-10-06/82004065-bc01-4a2b-a3c0-682c874ec71c/古笨港遺址_c.jpg"},"original":"https://data.boch.gov.tw/upload/representImageFile/2021-10-06/82004065-bc01-4a2b-a3c0-682c874ec71c/古笨港遺址.jpg","name":"古笨港遺址"},"representImageSource":"雲林縣政府","landScope":"北港溪，西至堤防，東至雲林縣境內，北緯2607500以北至2608500以南之水利地(如附圖)","nearbyArcheologyCheck":"位於或鄰近普查遺址","nearbyArcheologyBrief":"無","cultralMean":"根據發掘的結果看來，崩溪缺地點遺物出現的地區，主要是在北港溪河床東岸，距離台糖鐵橋南、北各250m的範圍內。文化遺物主要包含在黑色粗砂夾雜小礫層中，屬於黏板岩質砂，高程大約在海拔3-4m之間，厚度一般為10-40cm。在遺物包含層以上，是厚達4-5m細砂，可能是近百年內堆積的風成砂丘；遺物包含層以下是灰色的細泥層。在遺物包含層內的古代遺物，似乎是曾被河水翻攪，全部混雜在一起，缺乏人類行為的脈落關係。內容主要包括大量的磚瓦、陶瓷碎片、家用器物如圍棋、小玻璃瓶、煙斗、柱礎、石磨等，但也包含大量銅錢、髮簪、首飾、指環等較珍貴的財物，這些遺物的年代屬於清領末期，偶而出現少許日治時代的遺物。","pastHistory":"雲林縣北港鎮及嘉義縣新港鄉南港村一帶，古時候名叫笨港，是台灣清領時期最重要的港口之一，也是漢人較早開發的地區，曾經繁華一時，有「一府二笨三艋舺」的俗諺。由於北港溪水患嚴重，夏季經常氾濫成災，甚至曾多次改道，沖毀或淹沒部份街市。所以在這個地區，地下埋藏了大量古代笨港的遺物。民國90年底到91年初，雲林縣政府水利局為了杜絕水患，在北港鎮東側土名崩溪缺的地點，修建新的河堤，並挖掘北港溪東岸的沙丘填充，同時迫使北港溪河道向東遷移50公尺。從91年5月開始，每逢大雨溪水暴漲，就會快速沖蝕溪畔的沙洲。水退之後，河灘上遍地都是古文物，引起附近民眾及古董販子的爭相撿拾與私自挖掘。","actualStatus":"局部都巿計畫用地、部份農地、部份河川地","usageStatus":"局部都巿計畫用地、部份農地、部份河川地","landUsage":"現地保存，維持原有使用，避免過度開發、重機翻整，以及注意新建築申請。","announcementList":[{"classification":"變更/修正","officialDocNo":"府文資二字第1153807948B號","registerDate":"2026-02-26 00:00:00.0","note":"原指定古笨港遺址重新公告為古笨港考古遺址並修正指定理由及法令依據"},{"classification":"指定/登錄","officialDocNo":"府文資字第0952401210號","registerDate":"2006-12-22 14:39:15.0"}],"landlotList":[{"itemNo":1,"cityName":"雲林縣","distName":"北港鎮","landNo":"北港段","landSerialNo":"1278-0009","landownership":"私有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":2,"cityName":"雲林縣","distName":"北港鎮","landNo":"北港段","landSerialNo":"1278-0048","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":3,"cityName":"雲林縣","distName":"北港鎮","landNo":"北港段","landSerialNo":"1278-0133","landownership":"公有","cityLandUseTypeOther":"","noncityLandUseTypeOther":""},{"itemNo":4,"cityName":"雲林縣","distName":"北港鎮","landNo":"北港段","landSerialNo":"1278-0134","landownership":"公有","cityLandUseTypeOther":