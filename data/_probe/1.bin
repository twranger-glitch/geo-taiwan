ode":"YM09"},{"lng":121.5894,"lat":25.1879,"Ve":"1.7","Vn":"1.3","Vu":"0.0","VH":"2.1401","degH":"52.5946","station_code":"YMN4"},{"lng":121.5741,"lat":25.1657,"Ve":"3.1","Vn":"-0.3","Vu":"0.9","VH":"3.1145","degH":"95.5275","station_code":"YMSM"},{"lng":121.7789,"lat":24.8617,"Ve":"5.0","Vn":"1.1","Vu":"0.2","VH":"5.1196","degH":"77.5926","station_code":"YNTS"},{"lng":120.5542,"lat":23.6261,"Ve":"-7.3","Vn":"4.6","Vu":"-0.5","VH":"8.6284","degH":"302.2165","station_code":"YOKN"},{"lng":120.086,"lat":23.1466,"Ve":"0.3","Vn":"-1.2","Vu":"-5.8","VH":"1.2369","degH":"165.9638","station_code":"YSAN"},{"lng":120.2223,"lat":23.7392,"Ve":"-1.5","Vn":"-0.1","Vu":"-20.1","VH":"1.5033","degH":"266.1859","station_code":"YSLL"},{"lng":121.3002,"lat":23.3214,"Ve":"-29.8","Vn":"22.4","Vu":"-11.4","VH":"37.2800","degH":"306.9314","station_code":"YUL1"},{"lng":121.3011,"lat":23.3409,"Ve":"-31.3","Vn":"22.4","Vu":"-11.9","VH":"38.4896","degH":"305.5896","station_code":"YULI"},{"lng":120.7986,"lat":23.8839,"Ve":"-19.5","Vn":"8.1","Vu":"3.4","VH":"21.1154","degH":"292.5572","station_code":"YUNL"},{"lng":120.9591,"lat":23.4873,"Ve":"-36.1","Vn":"8.7","Vu":"4.0","VH":"37.1335","degH":"283.5497","station_code":"YUSN"},{"lng":120.194,"lat":23.5462,"Ve":"-1.8","Vn":"1.9","Vu":"-15.4","VH":"2.6173","degH":"316.5482","station_code":"YWJS"},{"lng":121.2726,"lat":23.2782,"Ve":"-31.6","Vn":"21.2","Vu":"-9.4","VH":"38.0526","degH":"303.8571","station_code":"ZCRS"},{"lng":120.2176,"lat":22.9433,"Ve":"-14.0","Vn":"-2.0","Vu":"4.3","VH":"14.1421","degH":"261.8699","station_code":"ZEND"},{"lng":121.5443,"lat":25.1622,"Ve":"1.1","Vn":"-1.0","Vu":"1.1","VH":"1.4866","degH":"132.2737","station_code":"ZUZH"}];
		var refSta = "S01R";
		// TODO: test heatmap
		let arr = new Array();
		// Velocity Type 
		let typeV = true;
		// Velocity style
		let colorValue = "black"; // 預設顏色
		let sizeValue = 1; // 預設大小
		let cMarkershow = false; //預設不顯示圓圈

		data.map((IntData)=>{
			IntData.lat = IntData.lat.toFixed(4);
			IntData.lng = IntData.lng.toFixed(4);
			arr.push([IntData.lat,IntData.lng,IntData.VH]);
		})
		// Add the heatlayer to the map
		// var heat = L.heatLayer(arr, {
        // 	radius: 15,
		// 	blur: 10,
		// 	max: 1,
		// 	minOpacity: 0,
      	// }).addTo(map);

		$('#station-table tbody').on('click', 'tr', function (e) {			
			var data = STtable.row( this ).data();
			if(data[0] !== refSta) {
				MarkerArray[data[0]].openPopup();
				map.setView(MarkerArray[data[0]].getLatLng());
			}else{
				RefStaArray.openPopup();
				map.setView(RefStaArray.getLatLng());
			}
			setTimeout(function(){
					$('#station-table tbody tr').each(function(idx,val){
						if ($(val).find("td:contains('"+data[0]+"')")[0]){
							
							$(this).addClass("table-active");
							// 使用 position() 來計算相對於滾動容器的偏移
							let scrollBody = $('.dataTables_scrollBody');
							let offsetTop = $(this).position().top;
							scrollBody.animate({
								scrollTop: offsetTop
							}, 100);
							
						}				
					});
			},500);	

			
		});
		let clickSta = null;
		map.on('popupopen', function(e) {
			if(refSta !== e.popup._source.options.data.station_code){
				clickSta = e.popup._source.options.data.station_code; //TODO:test
			}
			var data = e.popup._source.options.data;
			setTimeout(function(){
				$('#station-table tbody tr').each(function(idx,val){
					if ($(val).find("td:contains('"+data.station_code+"')")[0]){					
						$(this).addClass("table-active");
						
						// 使用 position() 來計算相對於滾動容器的偏移
    					let scrollBody = $('.dataTables_scrollBody');
    					let offsetTop = $(this).position().top;
						scrollBody.animate({
							scrollTop: offsetTop
						}, 100);
					}else{
						$(this).removeClass("table-active");
					}		
				});
			},500);
		});
		const STtable = $('#station-table').DataTable({
			//data: data,
			select: true,
			bAutoWidth: true,
			scrollY: '720px',
			scrollCollapse: true,
			paging: false,
			"columnDefs": [
					{
						"targets": [2,3,4],
						"render":function ( data, type, row ) {
							return parseFloat(data) ;
						}
					},{
						"targets": [2,3,4],
						"className":'text-end'
					},
					{
						"width":"15%",
						"target":[1,2,3,4]
					}
					
				],
			
		});
		//const StaLayer = new L.markerClusterGroup({maxClusterRadius:1, iconCreateFunction: function (cluster) {
		//	var markers = cluster.getAllChildMarkers();
		//	var html = '<div class="circle" style="border-color:#ccc">' + markers.length + '</div>';
		//	return L.divIcon({ html: html, className: 'mycluster', iconSize: L.point(20, 20) });
		//}}); 
		const StaLayer = new L.layerGroup();
		let MarkerArray = new Array();
		let ArrowArray = new Array();
		let RefStaArray = null;
		let GPSscale = null;
		const Icon= new setMapIcon({
			map		:map,
			data	:data,
			table	:STtable,
			Layer	:StaLayer,
			opacity	:0,
			markerArray:MarkerArray,
			refSta :refSta,
		}); 

		// 初始載入讓station置頂
		setTimeout(function(){
				$('#station-table tbody tr').each(function(idx,val){
					if ($(val).find("td:contains('"+refSta+"')")[0]){					
						$(this).addClass("table-active");
						
						// 使用 position() 來計算相對於滾動容器的偏移
    					let scrollBody = $('.dataTables_scrollBody');
    					let offsetTop = $(this).position().top;
						scrollBody.animate({
							scrollTop: offsetTop
						}, 0);
					}else{
						$(this).removeClass("table-active");
					}		
				});
			},100);
		
		
			map.on('zoomend', function() {
			detectmap(this);
		});

		map.on('move', function() {
			detectmap(this);
		});
		function detectmap(map){
			var bound=map.getBounds();
			var west	= bound.getWest();
			var south	= bound.getSouth();
			var east	= bound.getEast();
			var north	= bound.getNorth();
			var showData=[];
			data.map((IntData)=>{
				if (IntData.lat < north && IntData.lat > south && IntData.lng > west && IntData.lng <east){
					showData.push([	
						IntData.station_code,
						IntData.lat,
						IntData.lng,
						IntData.Vu,
						IntData.Vn,
						IntData.Ve
					]);
				}
			})
			STtable.clear();
			STtable.rows.add(showData);
			STtable.draw();
			
		}
		function setMapIcon(options){
			this.color = '#000';
			this.opacity = 0;
			this.refSta = refSta;
			
			if (options.data !== undefined){
				this.data = options.data;
			}else{
				console.log('error: data not defined.');
				return false;
			}
			if (options.map !== undefined){
				this.map = options.map;	
			}else{
				console.log('error: map not defined.');
				return false;
			}
			if (options.Layer !== undefined){
				this.Layer = options.Layer;
			}else{
				console.log('error: Layer not defined.');
				return false;
			}
			if (options.markerArray !== undefined){
				this.markerArray = options.markerArray;
			}else{
				
				console.log('error: MarkerArray not defined.');
				return false;
			}
			if (options.opacity !== undefined){
				this.opacity= options.opacity;
			}
			if (options.table !== undefined){
				this.table = options.table;
			}
			
			_putIcon(this);
			_setTable(this,this.data);
			
			// 初始interseismic deformation
			function _putIcon(e){
				const OBJECT_PROTOTYPE_KEYS = Object.getOwnPropertyNames(Object.prototype);
				function isPlainObject(obj) {
					return obj && typeof obj === 'object' && Object.getPrototypeOf(obj) === Object.prototype;
				}
				function merge(target, source) {
					if (Array.isArray(source) && Array.isArray(target)) {
						// 如果是陣列，直接合併元素
						source.forEach((item, index) => {
							if (typeof target[index] === 'undefined') {
								target[index] = item;
							} else if (isPlainObject(target[index]) && isPlainObject(item)) {
								merge(target[index], item);
							} else if (Array.isArray(target[index]) && Array.isArray(item)) {
								merge(target[index], item);
							} else {
								target[index] = item; // 覆蓋目標的值
							}
						});
					} else if (isPlainObject(source) && isPlainObject(target)) {
						for (let key in source) {
							// 過濾不安全的屬性
							if (
								OBJECT_PROTOTYPE_KEYS.includes(key) ||
								key === '__proto__' ||
								key === 'constructor' ||
								key === 'prototype'
							) {
								continue;
							}
							if (key in target && isPlainObject(target[key]) && isPlainObject(source[key])) {
								merge(target[key], source[key]);
							} else {
								target[key] = source[key];
							}
						}
					} else {
						throw new Error("Source and target must both be objects or arrays.");
					}
				}
				let data = [];
				merge(data, e.data);

				let GPSinter = new Array();
				map.createPane("locationMarker");
				map.getPane("locationMarker").style.zIndex = 600;
				
				data.map((IntData)=>{
					if (IntData.station_code !== refSta) {
						var marker1 = L.circleMarker([IntData.lat, parseFloat(IntData.lng)],{
							radius	:3,
							color : "#615C60",
							weight : 1.2,
							// fillColor : IntData.color,
							opacity : e.opacity,
							fillOpacity : e.opacity,
							data:IntData,
							pane: "locationMarker"
						});
						
						html = _setVHPupup(e,IntData,e.refSta);					
						marker1.bindPopup(html);					
						e.markerArray[IntData.station_code] =marker1;
						e.Layer.addLayer(marker1);


						// TODO arrow svg
						// degree-90，是因為圖示箭頭是朝右90度
						const vB = 200;
						const line = vB / 2;
						let Color = colorValue;
						let svgString = `
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${vB} ${vB}"
						style="transform: rotate(${IntData.degH - 90}deg);">
								<defs>
									<marker id="arrowhead" markerWidth="15" markerHeight="10"
										refX="0" refY="5" orient="auto" fill="${Color}">
										<polygon points="0 0, 0 10, 15 5" />
									</marker>
								</defs>
								<line x1="${line}" y1="${line}" x2="170" y2="${line}" stroke="${Color}"
								stroke-width="2" marker-end="url(#arrowhead)" />
						</svg>`;
						let url = `data:image/svg+xml;base64,${btoa(svgString)}`;
						let gpsP = 2.5*sizeValue
						let myIcon = L.icon({
							iconUrl: url,
							iconSize: [IntData.VH * gpsP / 2, IntData.VH * gpsP / 2],
							iconAnchor: [IntData.VH * gpsP / 2 / 2, IntData.VH * gpsP / 2 / 2],
						});
						let arrow = L.marker([IntData.lat, parseFloat(IntData.lng)],{
							interactive: false,
							icon: myIcon,
						});
						ArrowArray[IntData.station_code] =arrow;
						e.Layer.addLayer(arrow);

						// TODO test
					}else {
						// Reference Station
						let refST = L.icon({
							iconUrl: '/img/Interseismic/refSta.png',
							iconSize: [30, 30],
							iconAnchor: [15, 30],
							popupAnchor: [0, -30],
						});
						let refhtml='';
						refhtml+='<span class="station_title font-weight-bold" style="font-size:1.8em;">'+IntData.station_code+'</span></br>';					
						refhtml+='<text data-lang="Latitude">Latitude</text>: '+IntData.lat+'<sup>。</sup></br>';
						refhtml+='<text data-lang="Longitude">Longitude</text>: '+IntData.lng+'<sup>。</sup></br>';

						var refSTmarker = L.marker([IntData.lat, parseFloat(IntData.lng)],{
							icon: refST,
							data:IntData,
						});
						refSTmarker.bindPopup(refhtml);
						RefStaArray =refSTmarker;
						e.Layer.addLayer(refSTmarker);	
						
						// reference station marker
						var markerRef = L.circleMarker([IntData.lat, parseFloat(IntData.lng)],{
							radius	:3,
							color : "#615C60",
							weight : 1.2,
							opacity : e.opacity,
							fillOpacity : e.opacity,
							data:IntData,
							// interactive: false,
							pane: "locationMarker",
						});
						markerRef.bindPopup(refhtml);
						e.markerArray[IntData.station_code] =markerRef;
						e.Layer.addLayer(markerRef);

					}
				})
				e.Layer.addTo(e.map);

				// TODO GPS scale (50mm/yr)
				let gpsP = 2.5*sizeValue
				let GPSString = `
						<svg xmlns="http://www.w3.org/2000/svg" width="${50 * gpsP / 2 / 2+15}" height="80" style="background-color: rgba(187, 187, 187, .4);">
                        <!-- text tick -->
                        <text x="${(50 * gpsP / 2 / 2+15)/2}" y="20" style="font-size:10px;" fill="${colorValue}"
                            text-anchor="middle">50 mm/yr</text>
                        <!-- arrow -->
                        <defs>
                            <marker id="arrowhead" markerWidth="6" markerHeight="4" refX="5" refY="2" orient="auto"
                                fill="${colorValue}">
                                <polygon points="0 0, 0 4, 6 2" />
                            </marker>
                        </defs>
                        <!-- line+arrow -->
                        <line x1="0" y1="40" x2="${50 * gpsP / 2 / 2 - 3}" y2="40" stroke="${colorValue}" stroke-width="3"
                            marker-end="url(#arrowhead)" />
                        <!-- title -->
                        <text x="${(50 * gpsP / 2 / 2+15)/2}" y="60" style="font-size:10px;" fill="${colorValue}"
                            text-anchor="middle">Velocity
						</text>
                    </svg>`;
				let GPSurl = `data:image/svg+xml;base64,${btoa(GPSString)}`;
				let GPSIcon = L.icon({iconUrl: GPSurl});
				map.createPane("GPSscale");
				map.getPane("GPSscale").style.zIndex = 600;
				GPSscale = new L.marker([23, 117.5],{
							interactive: true,
							icon: GPSIcon,
							draggable: true,
							pane: "GPSscale"
						});
				e.Layer.addLayer(GPSscale);		
			}
			function _setVHPupup(e,data,refSta){
				var html='';
				
				html+='<span class="station_title font-weight-bold" style="font-size:1.8em;">'+data['station_code']+'</span></br>';
				// html+='<hr style="margin-top:0.5rem; margin-botton:0.5rem">';
				html+='<text data-lang="VH">Horizontal Velocity</text>: <b>'+data['VH']+'(mm/yr)</b></br>';
				html+='<text data-lang="degH">Azimuth</text>: <b>'+data['degH']+'<sup>。</sup></b></br>';
				html+='<text data-lang="Latitude">Latitude</text>: '+data['lat']+'<sup>。</sup></br>';
				html+='<text data-lang="Longitude">Longitude</text>: '+data['lng']+'<sup>。</sup></br>';
				html+='<hr style="margin-top:0.5rem; margin-botton:0.5rem">';

				html+='<text>Relative to </text>'+refSta+'</br>'; 
				html+='<text data-lang="Vu">Vu</text>: '+data['Vu']+'(mm/yr)</br>';
				html+='<text data-lang="Vn">Vn</text>: '+data['Vn']+'(mm/yr)</br>';
				html+='<text data-lang="Ve">Ve</text>: '+data['Ve']+'(mm/yr)</br>';
				// html += '<text>Set as </text><button id="replaceButton" data-station-code="' + data['station_code'] + '">Reference</button>';	
				html+='<text>Set as </text><a href="/interseis/'+data['station_code']+'">Reference</a>';				

				return html;
			}
			function _setVUPupup(e,data,refSta){
				var html='';
				
				html+='<span class="station_title font-weight-bold" style="font-size:1.8em;">'+data['station_code']+'</span></br>';
				// html+='<hr style="margin-top:0.5rem; margin-botton:0.5rem">';
				html+='<text data-lang="VH">Vertical Velocity</text>: <b>'+data['Vu']+'(mm/yr)</b></br>';
				html+='<text data-lang="Latitude">Latitude</text>: '+data['lat']+'<sup>。</sup></br>';
				html+='<text data-lang="Longitude">Longitude</text>: '+data['lng']+'<sup>。</sup></br>';
				html+='<hr style="margin-top:0.5rem; margin-botton:0.5rem">';

				html+='<text>Relative to </text>'+refSta+'</br>'; 
				html+='<text data-lang="Vu">Vu</text>: '+data['Vu']+'(mm/yr)</br>';
				html+='<text data-lang="Vn">Vn</text>: '+data['Vn']+'(mm/yr)</br>';
				html+='<text data-lang="Ve">Ve</text>: '+data['Ve']+'(mm/yr)</br>';
				html+='<text data-lang="degH">Horizontal Azimuth</text>: '+data['degH']+'<sup>。</sup></br>';
				// html += '<text>Set as </text><button id="replaceButton" data-station-code="' + data['station_code'] + '">Reference</button>';	
				html+='<text>Set as </text><a href="/interseis/'+data['station_code']+'">Reference</a>';				

				return html;
			}

			// Map
			// 替換參考站動作
			$(document).on('click', '#replaceButton', function(e) {
				$.ajax({
					url: 'https://tgm.earth.sinica.edu.tw/replace-station-code',
					type: 'POST',
					data: {
						_token: '0285r8CIzN9Rzlv5BU2hwy3C6s2nIlEqOsiZbIPG',
						station_code: clickSta
					},
					success: function(response) {
						alert('The reference station has been successfully replaced by '+refSta+'.');
						// 其他後續處理，如刷新地圖或顯示替換結果
						// Update the data with the new station and reference station
						data = JSON.parse(response.station);
						refSta = JSON.parse(response.refSta);

						// Clear existing markers and table rows
						clearMapAndTable();

						// Redraw map markers and table rows
						drawMapAndTable(data,refSta);
						
					}
				});
			});
			function clearMapAndTable() {
				// Clear the map markers
				map.closePopup();
				for (var key in MarkerArray) {
					if (MarkerArray.hasOwnProperty(key) && ArrowArray.hasOwnProperty(key)) {
						map.removeLayer(MarkerArray[key]);
						map.removeLayer(ArrowArray[key]);
					}
				}
				map.removeLayer(RefStaArray);

				MarkerArray = new Array();
				ArrowArray = new Array();
				RefStaArray = null;

				arr = new Array();
				// map.removeLayer(heat);
				
				// Clear the map markers and table rows
				showData=[];
				STtable.clear();
			}
			function drawMapAndTable(data, refSta) {
				// Redraw map markers on the updated data				
				data.map((IntData)=>{
					addVHMarkerToMap(IntData, refSta);
					addRowToTable(IntData);
					arr.push([IntData.lat,IntData.lng,IntData.VH]);
				})
				// heatmap marker
				// heat = L.heatLayer(arr, {
				// 	radius: 15,
				// 	blur: 10,
				// 	max: 1,
				// 	minOpacity: 0,
				// }).addTo(map);
				// Open reference station popup
				RefStaArray.openPopup();

				// Redraw map markers and table rows on the updated data
				STtable.rows.add(showData);
				STtable.draw();
			}
			function addVHMarkerToMap(data, refSta) {
				if (data['station_code'] !== refSta) {
					marker1 = L.circleMarker([data['lat'], parseFloat(data['lng'])],{
							radius	:3,
							color : colorValue,
							weight : 1.2,
							opacity : cMarkershow ? 1:0,
							fillOpacity : 0,
							data:data,
							pane: "locationMarker"
						});
					let e = null;	
					html = _setVHPupup(e,data,refSta);	
					marker1.bindPopup(html);					
					marker1.addTo(map);
					MarkerArray[data['station_code']] =marker1;

					// Arrow marker
					// degree-90，是因為圖示箭頭是朝右90度
					const vB = 200;
					const line = vB / 2;
					let Color = colorValue;
					let svgString = `
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${vB} ${vB}"
					style="transform: rotate(${data['degH'] - 90}deg);">
							<defs>
								<marker id="arrowhead" markerWidth="15" markerHeight="10"
									refX="0" refY="5" orient="auto" fill="${Color}">
									<polygon points="0 0, 0 10, 15 5" />
								</marker>
							</defs>
							<line x1="${line}" y1="${line}" x2="170" y2="${line}" stroke="${Color}"
							stroke-width="2" marker-end="url(#arrowhead)" />
					</svg>`;
					let url = `data:image/svg+xml;base64,${btoa(svgString)}`;
					let gpsP = 2.5*sizeValue
					let myIcon = L.icon({
						iconUrl: url,
						iconSize: [data['VH'] * gpsP / 2, data['VH'] * gpsP / 2],
						iconAnchor: [data['VH'] * gpsP / 2 / 2, data['VH'] * gpsP / 2 / 2],
					});
					var arrow = L.marker([data['lat'], parseFloat(data['lng'])],{
						interactive: false,
						icon: myIcon,
					});
					ArrowArray[data['station_code']] =arrow;
					arrow.addTo(map);
				} else {
					// Reference Station
					let refST = L.icon({
							iconUrl: '/img/Interseismic/refSta.png',
							iconSize: [30, 30],
							iconAnchor: [15, 30],
							popupAnchor: [0, -30],
						});
					let refhtml='';
					refhtml+='<span class="station_title font-weight-bold" style="font-size:1.8em;">'+data['station_code']+'</span></br>';					
					refhtml+='<text data-lang="Latitude">Latitude</text>: '+data['lat']+'<sup>。</sup></br>';
					refhtml+='<text data-lang="Longitude">Longitude</text>: '+data['lng']+'<sup>。</sup></br>';

					var refSTmarker = L.marker([data['lat'], parseFloat(data['lng'])],{
						icon: refST,
						data:data
					});
					refSTmarker.bindPopup(refhtml);
					RefStaArray =refSTmarker;
					refSTmarker.addTo(map);

					// reference station marker
					markerRef = L.circleMarker([data['lat'], parseFloat(data['lng'])],{
							radius	:3,
							color : "#615C60",
							weight : 1.2,
							opacity : 0,
							fillOpacity : 0,
							data:data,
							// interactive: false,
							pane: "locationMarker",
						});
						
					markerRef.bindPopup(refhtml);
					MarkerArray[data['station_code']] =markerRef;
					markerRef.addTo(map);
				}
			}
			function addVUMarkerToMap(data, refSta) {
				if (data['station_code'] !== refSta) {
					marker1 = L.circleMarker([data['lat'], parseFloat(data['lng'])],{
							radius	:3,
							color : colorValue,
							weight : 1.2,
							opacity : cMarkershow ? 1:0,
							fillOpacity : 0,
							data:data,
							pane: "locationMarker"
						});
					let e = null;	
					html = _setVUPupup(e,data,refSta);					
					marker1.bindPopup(html);					
					marker1.addTo(map);
					MarkerArray[data['station_code']] =marker1;

					// Arrow marker
					// degree-90，是因為圖示箭頭是朝右90度
					const vB = 200;
					const line = vB / 2;
					let Color = "blue";
					let VUdeg = 0;
					let Vu = data['Vu'];
					if (data['Vu'] > 0) {
						VUdeg = 0;
						Color = "red";
					} else {
						Vu = Vu *(-1)
						VUdeg = 180;
						Color = "blue";
					}
					let svgString = `
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${vB} ${vB}"
					style="transform: rotate(${VUdeg-90}deg);">
							<defs>
								<marker id="arrowhead" markerWidth="15" markerHeight="10"
									refX="0" refY="5" orient="auto" fill="${Color}">
									<polygon points="0 0, 0 10, 15 5" />
								</marker>
							</defs>
							<line x1="${line}" y1="${line}" x2="170" y2="${line}" stroke="${Color}"
							stroke-width="2" marker-end="url(#arrowhead)" />
					</svg>`;
					let url = `data:image/svg+xml;base64,${btoa(svgString)}`;
					let gpsP = 2.5*sizeValue
					let myIcon = L.icon({
						iconUrl: url,
						iconSize: [Vu * gpsP/2, Vu * gpsP/2],
						iconAnchor: [Vu * gpsP/2/2, Vu * gpsP/2/2],
					});
					var arrow = L.marker([data['lat'], parseFloat(data['lng'])],{
						interactive: false,
						icon: myIcon,
					});
					ArrowArray[data['station_code']] =arrow;
					arrow.addTo(map);
				} else {
					// Reference Station
					let refST = L.icon({
							iconUrl: '/img/Interseismic/refSta.png',
							iconSize: [30, 30],
							iconAnchor: [15, 30],
							popupAnchor: [0, -30],
						});
					let refhtml='';
					refhtml+='<span class="station_title font-weight-bold" style="font-size:1.8em;">'+data['station_code']+'</span></br>';					
					refhtml+='<text data-lang="Latitude">Latitude</text>: '+data['lat']+'<sup>。</sup></br>';
					refhtml+='<text data-lang="Longitude">Longitude</text>: '+data['lng']+'<sup>。</sup></br>';

					var refSTmarker = L.marker([data['lat'], parseFloat(data['lng'])],{
						icon: refST,
						data:data
					});
					refSTmarker.bindPopup(refhtml);
					RefStaArray =refSTmarker;
					refSTmarker.addTo(map);

					// reference station marker
					markerRef = L.circleMarker([data['lat'], parseFloat(data['lng'])],{
							radius	:3,
							color : "#615C60",
							weight : 1.2,
							opacity : 0,
							fillOpacity : 0,
							data:data,
							// interactive: false,
							pane: "locationMarker",
						});
						
					markerRef.bindPopup(refhtml);
					MarkerArray[data['station_code']] =markerRef;
					markerRef.addTo(map);
				}
			}
			function clearMap() {
				// Clear the map markers
				map.closePopup();
				for (var key in MarkerArray) {
					if (MarkerArray.hasOwnProperty(key) && ArrowArray.hasOwnProperty(key)) {
						map.removeLayer(MarkerArray[key]);
						map.removeLayer(ArrowArray[key]);
					}
				}
				map.removeLayer(RefStaArray);
				map.removeLayer(GPSscale);

				MarkerArray = new Array();
				ArrowArray = new Array();
				RefStaArray = null;

				arr = new Array();
				// map.removeLayer(heat);
			}
			function drawMap(data, refSta) {
				// Redraw map markers on the updated data				
				data.map((IntData)=>{
					addVHMarkerToMap(IntData, refSta);
					arr.push([IntData.lat,IntData.lng,IntData.VH]);
				})
				// heatmap marker
				// heat = L.heatLayer(arr, {
				// 	radius: 15,
				// 	blur: 10,
				// 	max: 1,
				// 	minOpacity: 0,
				// }).addTo(map);
				// Open reference station popup
				RefStaArray.openPopup();
			}
			function RedrawMap(data, refSta, typeV) {
				// Redraw map markers on the updated data
				if (typeV)	{
					// 水平向			
					data.map((IntData)=>{
						addVHMarkerToMap(IntData, refSta);
						arr.push([IntData.lat,IntData.lng,IntData.VH]);
					})
					// heatmap marker
					// heat = L.heatLayer(arr, {
					// 	radius: 15,
					// 	blur: 10,
					// 	max: 1,
					// 	minOpacity: 0,
					// }).addTo(map);

					// TODO GPS scale (50mm/yr)
					let gpsP = 2.5*sizeValue
					let GPSString = `
						<svg xmlns="http://www.w3.org/2000/svg" width="${50 * gpsP / 2 / 2+15}" height="80" style="background-color: rgba(187, 187, 187, .4);">
							<!-- text tick -->
							<text x="${(50 * gpsP / 2 / 2+15)/2}" y="20" style="font-size:10px;" fill="${colorValue}"
								text-anchor="middle">50 mm/yr</text>
							<!-- arrow -->
							<defs>
								<marker id="arrowhead" markerWidth="6" markerHeight="4" refX="5" refY="2" orient="auto"
									fill="${colorValue}">
									<polygon points="0 0, 0 4, 6 2" />
								</marker>
							</defs>
							<!-- line+arrow -->
							<line x1="0" y1="40" x2="${50 * gpsP / 2 / 2 - 3}" y2="40" stroke="${colorValue}" stroke-width="3"
								marker-end="url(#arrowhead)" />
							<!-- title -->
							<text x="${(50 * gpsP / 2 / 2+15)/2}" y="60" style="font-size:10px;" fill="${colorValue}"
								text-anchor="middle">Velocity
							</text>
						</svg>`;
					let GPSurl = `data:image/svg+xml;base64,${btoa(GPSString)}`;
					let GPSIcon = L.icon({iconUrl: GPSurl});
					map.createPane("GPSscale");
					map.getPane("GPSscale").style.zIndex = 600;
					GPSscale = new L.marker([23, 117.5],{
								interactive: true,
								icon: GPSIcon,
								draggable: true,
								pane: "GPSscale"
							});
					map.addLayer(GPSscale);	
				} else {
					// 垂直向
					data.map((IntData)=>{
						addVUMarkerToMap(IntData, refSta);
						arr.push([IntData.lat,IntData.lng,IntData.Vu]);
					})
					// TODO GPS scale (50mm/yr)
					let gpsP = 2.5*sizeValue
					let GPSString = `
							<svg xmlns="http://www.w3.org/2000/svg" width="130"  height="${50 * gpsP / 3 + 20 }"
							style="transform: rotate(90deg); transform-origin: 40px 40px; background-color: rgba(187, 187, 187, .4);">
							<!-- text tick -->
							<text x="${(50 * gpsP / 2 / 2+15)/2}" y="8" style="font-size:10px;" fill="${colorValue}"
								text-anchor="middle">50 mm/yr</text>
							<!-- arrow -->
							<defs>
								<marker id="arrowhead" markerWidth="6" markerHeight="4" refX="5" refY="2" orient="auto"
									fill="${colorValue}">
									<polygon points="0 0, 0 4, 6 2" />
								</marker>
							</defs>
							<!-- line+arrow -->
							<line x1="0" y1="20" x2="${50 * gpsP / 2 / 2 - 3}" y2="20" stroke="${colorValue}" stroke-width="3"
								marker-end="url(#arrowhead)" />
							<!-- title -->
							<text x="${(50 * gpsP / 2 / 2+15)/2}" y="40" style="font-size:10px;" fill="${colorValue}"
								text-anchor="middle">Velocity
							</text>
						</svg>`;
					let GPSurl = `data:image/svg+xml;base64,${btoa(GPSString)}`;
					let GPSIcon = L.icon({iconUrl: GPSurl});
					map.createPane("GPSscale");
					map.getPane("GPSscale").style.zIndex = 600;
					GPSscale = new L.marker([23, 117.5],{
								interactive: true,
								icon: GPSIcon,
								draggable: true,
								pane: "GPSscale"
							});
					map.addLayer(GPSscale);	
				}

				// Open reference station popup
				RefStaArray.openPopup();
			}
			// Velocity Type
			const gpsModeCheckbox = document.getElementById('gps_mode');
			gpsModeCheckbox.addEventListener('change', function() {
				if (gpsModeCheckbox.checked) {
					typeV = false;
					clearMap();
					RedrawMap(data, refSta, typeV);
					document.getElementById('title').innerHTML='Interseismic Vertical Deformation';
				} else {
					typeV = true;
					clearMap();
					RedrawMap(data, refSta, typeV);
					document.getElementById('title').innerHTML='Interseismic Horizontal Deformation';
				}
			});

			// Table
			function addRowToTable(data) {
				showData.push([					
						data['station_code'],
						data['lat'],
						data['lng'],
						data['Vu'],
						data['Vn'],
						data['Ve']
				]);
			} 			
			function _setTable(e,data){
				_setTableContent(e,data);
				e.table.draw();
			}
			function _setTableContent(e,data){
				e.tableData = new Array();
				data.map((IntData)=>{
					e.tableData.push([	
						IntData.station_code,
						IntData.lat,
						IntData.lng,
						IntData.Vu,
						IntData.Vn,
						IntData.Ve
					]);
					
				})
				e.table.rows.add(e.tableData);
				//e.table.
			}
			this.detectbound = function(){
				
				var bound = this.map.getBounds();
				var west	= bound.getWest();
				var south	= bound.getSouth();
				var east	= bound.getEast();
				var north	= bound.getNorth();
				var showData=[];
				var data = this.data;
				data.map((IntData)=>{
					if (IntData.lat < north && IntData.lat > south && IntData.lon > west && IntData.lon <east){
						showData.push(IntData);
					}
				})
				_setTable(this,showData);
				
			}

			// GPS color & size
			L.Control.GPSstyle = L.Control.extend(
				{
					options:
					{
						position: 'bottomleft',
					},
					onAdd: function (map) {
						let controlDiv = L.DomUtil.create('div', 'leaflet-gpsStyle-toolbar leaflet-bar');

						// title
						let controlTitle = L.DomUtil.create('b', 'leaflet-title', controlDiv);
						controlTitle.textContent = "Styles";
						controlTitle.style.fontSize = '12px';
						L.DomUtil.create('br', 'leaflet-br', controlDiv);
						L.DomUtil.create('br', 'leaflet-br', controlDiv);

						// set color
						let controlColor = L.DomUtil.create('input', 'leaflet-edit-gpscolor', controlDiv);
						controlColor.type='color';
						controlColor.value=colorValue;
						controlColor.title = 'Color';
						controlColor.href = '#';
						controlColor.style.width = '30px';
						// 監控使用者輸入
						controlColor.addEventListener("change", (event) => {
							colorValue = event.target.value;
							clearMap();
							RedrawMap(data, refSta, typeV);
						});
						L.DomUtil.create('br', 'leaflet-br', controlDiv);

						// set size
						let controlSize = L.DomUtil.create('select', 'leaflet-edit-gpssize', controlDiv);
						controlSize.type='value';
						controlSize.title = 'Size';
						controlSize.href = '#';
						controlSize.style.width = '30px';
						// 建立選項
						const sizes = [1, 2, 3, 4]; // 定義可用尺寸
						sizes.forEach((size) => {
							const sizeOption = L.DomUtil.create('option', 'leaflet-option', controlSize);
							sizeOption.value = size; // 設定選項的值
							sizeOption.textContent = size; // 設定選項的顯示文字
						});
						// 監控使用者輸入
						controlSize.addEventListener('change', (event) => {
							sizeValue = event.target.value;
							clearMap();
							RedrawMap(data, refSta, typeV);
						});
						L.DomUtil.create('br', 'leaflet-br', controlDiv);

						// set station marker
						let staDiv = L.DomUtil.create('div', 'leaflet-gpssize', controlDiv);
						staDiv.style.display = "flex";
						staDiv.style.marginTop= '2px';

						setCmarkerSow=L.DomUtil.create('lable', 'leaflet-title', staDiv);
						setCmarkerSow.textContent = "Marker:";
						setCmarkerSow.style.fontSize = '10px';

						let controlSta = L.DomUtil.create('input', 'leaflet-edit-gpsSta', staDiv);
						controlSta.type='checkbox';	
						controlSta.title = 'Circle Marker';
						controlSta.href = '#';		
						controlSta.addEventListener('change', (event) => {
							cMarkershow = event.target.checked;
							clearMap();
							RedrawMap(data, refSta, typeV);
						});			

						return controlDiv;
					}
				});
			let GPSstyle = new L.Control.GPSstyle();
			map.addControl(GPSstyle);			
		}
	</script>
</html>
