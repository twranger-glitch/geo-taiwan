":"2020-09-16","status":1,"created_at":"2024-04-12T17:11:40.000000Z","updated_at":"2024-04-12T17:11:40.000000Z"},{"id":543,"station_code":"PHTU","name":"\u6f8e\u79d1\u5927","lng":119.5814,"lat":23.5739,"height":"64.33","agency":"IES","install":"2020-09-16","status":1,"created_at":"2024-04-12T17:12:22.000000Z","updated_at":"2024-04-12T17:12:22.000000Z"},{"id":544,"station_code":"JSU2","name":"\u745e\u7a572","lng":121.4238,"lat":23.4924,"height":"121.32","agency":"CWA","install":"2021-01-25","status":1,"created_at":"2024-04-12T17:13:12.000000Z","updated_at":"2024-04-12T17:13:12.000000Z"},{"id":545,"station_code":"RHES","name":"\u4ec1\u548c\u570b\u5c0f","lng":120.4227,"lat":23.6623,"height":"47.96","agency":"WRA","install":"2021-07-01","status":1,"created_at":"2024-04-12T17:13:52.000000Z","updated_at":"2024-04-12T17:13:52.000000Z"},{"id":546,"station_code":"KSH2","name":"\u95dc\u897f2","lng":121.1761,"lat":24.7761,"height":"168.48","agency":"CWA","install":"2021-08-21","status":1,"created_at":"2024-04-12T17:15:08.000000Z","updated_at":"2024-04-12T17:15:08.000000Z"},{"id":547,"station_code":"BAL2","name":"\u4e0a\u5df4\u96752","lng":121.4272,"lat":24.6993,"height":"1698.98","agency":"CWA","install":"2021-11-10","status":1,"created_at":"2024-04-12T17:15:53.000000Z","updated_at":"2024-04-12T17:15:53.000000Z"},{"id":548,"station_code":"CLES","name":"\u67f4\u6797\u570b\u5c0f","lng":120.3714,"lat":23.6067,"height":"44.10","agency":"WRA","install":"2022-09-01","status":1,"created_at":"2024-04-12T17:16:38.000000Z","updated_at":"2024-04-12T17:16:38.000000Z"},{"id":549,"station_code":"LGES","name":"\u91cc\u6e2f\u570b\u5c0f","lng":120.4953,"lat":22.781,"height":"69.17","agency":"WRA","install":"2023-05-03","status":1,"created_at":"2024-04-12T17:17:34.000000Z","updated_at":"2024-04-12T17:17:34.000000Z"},{"id":550,"station_code":"KPWR","name":"\u9ad8\u5c4f\u6eaa\u6c34\u8cc7\u6e90\u9928","lng":120.4362,"lat":22.6888,"height":"46.80","agency":"WRA","install":"2023-05-04","status":1,"created_at":"2024-04-12T17:18:10.000000Z","updated_at":"2024-04-12T17:18:10.000000Z"},{"id":551,"station_code":"TCCK","name":"\u53f0\u4e2d\u4e2d\u592e\u516c\u5712","lng":120.6492,"lat":24.1963,"height":"135.11","agency":"WRA","install":"2023-05-05","status":1,"created_at":"2024-04-12T17:18:52.000000Z","updated_at":"2024-04-12T17:18:52.000000Z"}];
		for(var i in data){
			
			data[i]['lat'] = data[i]['lat'].toFixed(4);
			data[i]['lng'] = data[i]['lng'].toFixed(4);
		}
		for(var i in data){
			data[i]['index'] = i;
			if(data[i]['agency'] == "IES"){
				data[i]['color'] = "#ea5506";
			}else if(data[i]['agency'] == "CWA"){
				data[i]['color'] = "#2ca9e1";
			}else if(data[i]['agency'] == "MOI"){
				data[i]['color'] = "#f8b500";
			}else if(data[i]['agency'] == "GSMMA"){
				data[i]['color'] = "#007b43";
			}else if(data[i]['agency'] == "WRA"){
				data[i]['color'] = "#522f60";
			}else if(data[i]['agency'] == "CCU"){
				data[i]['color'] = "#93ca76";
			}else{
				data[i]['color'] = "#000";
			}
		}
		
		$('#station-table tbody').on('click', 'tr', function (e) {			
			var data = STtable.row( this ).data();		
						MarkerArray[data[0]].openPopup();
			// map.setView(MarkerArray[data[0]].getLatLng());
			
			setTimeout(function(){
				$('#station-table tbody tr').each(function(idx,val){
					if ($(val).find("td:contains('"+data[0]+"')")[0]){
						
						$(this).addClass("table-active");
						let scrollBody = $('.dataTables_scrollBody');
						let offsetTop = $(this).position().top;
						scrollBody.animate({
							scrollTop: offsetTop
						}, 100);
						
					}				
				});
			},500);
			
			
		});
		map.on('popupopen', function(e) {
			var data = e.popup._source.options.data;
			setTimeout(function(){
				$('#station-table tbody tr').each(function(idx,val){
					if ($(val).find("td:contains('"+data.station_code+"')")[0]){
						
						$(this).addClass("table-active");
						let scrollBody = $('.dataTables_scrollBody');
    					let offsetTop = $(this).position().top;
						scrollBody.animate({
							scrollTop: offsetTop
						}, 100);
						
					}else{
						$(this).removeClass("table-active");
					}		
				});
			},500);
		});
		const STtable = $('#station-table').DataTable({
			//data: data,
			select: true,
			bAutoWidth: true,
			scrollY: '720px',
			scrollCollapse: true,
			paging: false,
			"columnDefs": [
					{
						"targets": [2,3,4],
						"render":function ( data, type, row ) {
							return parseFloat(data) ;
						}
					},{
						"targets": [2,3,4],
						"className":'text-end'
					},
					{
						"width":"15%",
						"target":[1,2,3,4]
					}
					
				],
			
		});
		//const StaLayer = new L.markerClusterGroup({maxClusterRadius:1, iconCreateFunction: function (cluster) {
		//	var markers = cluster.getAllChildMarkers();
		//	var html = '<div class="circle" style="border-color:#ccc">' + markers.length + '</div>';
		//	return L.divIcon({ html: html, className: 'mycluster', iconSize: L.point(20, 20) });
		//}}); 
		const StaLayer = new L.layerGroup();
		const MarkerArray = new Array(); 
		const Icon= new setMapIcon({
			map		:map,
			data	:data,
			table	:STtable,
			Layer	:StaLayer,
			opacity	:0.6,
			markerArray:MarkerArray
		}); 
		
		map.on('zoomend', function() {
			
			detectmap(this);
		});
		map.on('move', function() {
			detectmap(this);
		});
		function detectmap(map){
			var bound=map.getBounds();
			var west	= bound.getWest();
			var south	= bound.getSouth();
			var east	= bound.getEast();
			var north	= bound.getNorth();
			var showData=[];
			for (var i in data){
				if (data[i]['lat'] < north && data[i]['lat'] > south && data[i]['lng'] > west && data[i]['lng'] <east){
					showData.push([
						data[i]['station_code'],
						data[i]['name'],
						data[i]['lat'],
						data[i]['lng'],
						data[i]['height'],
						data[i]['agency'],
						data[i]['install']
					]);
				}
			}
			STtable.clear();
			STtable.rows.add(showData);
			STtable.draw();
			
		}
		function setMapIcon(options){
			this.color = '#000';
			this.opacity = 0.5;
			
			if (options.data !== undefined){
				this.data = options.data;
				
			}else{
				console.log('error: data not defined.');
				return false;
			}
			if (options.map !== undefined){
				this.map = options.map;
				
			}else{
				console.log('error: map not defined.');
				return false;
			}
			
			if (options.Layer !== undefined){
				this.Layer = options.Layer;
			}else{
				console.log('error: Layer not defined.');
				return false;
			}
			if (options.markerArray !== undefined){
				this.markerArray = options.markerArray;
			}else{
				
				console.log('error: MarkerArray not defined.');
				return false;
			}
			
			if (options.opacity !== undefined){
				this.opacity= options.opacity;
			}
			if (options.table !== undefined){
				this.table = options.table;
			}
			
			
			_putIcon(this);
			_setTable(this,this.data);
			
			function _putIcon(e){
				var data = e.data;				
				for (var i in data){
					var marker1 = L.circleMarker([data[i]['lat'], parseFloat(data[i]['lng'])],{
						radius	:5,
						color : "#111",
						weight : 1,
						fillColor : data[i]['color'],
						fillOpacity : e.opacity,
						data:data[i]
					});
					
					html = _setPupup(e,data[i]);					
					marker1.bindPopup(html);					
					e.markerArray[data[i]['station_code']] =marker1;
					e.Layer.addLayer(marker1);
				
				}
				
				e.Layer.addTo(e.map);
			}
			function _setPupup(e,data){
				var html='';
		
				html+='<span class="station_title font-weight-bold" style="font-size:1.8em;"><b class="mr-1" style="color:'+data['color']+'">'+data['agency']+'</b> '+data['station_code']+'</span>';
				html+='<hr style="margin-top:0.5rem; margin-botton:0.5rem">';
				
				html+='<text data-lang="Latitude">Latitude</text>: '+data['lat']+'</br>';
				html+='<text data-lang="Longitude">Longitude</text>: '+data['lng']+'</br>';
				html+='<text data-lang="Altitude">Altitude</text>: '+data['height']+'</br>';
				html+='<text data-lang="Start Time">Install time</text>: '+data['install']+'</br>';
				html+='<text>Detail </text>: <a href="./station/'+data['station_code']+'">Show Datail</a></br>';				

				return html;
			}
			
			
			function _setTable(e,data){
				_setTableContent(e,data);
				e.table.draw();
			}
			function _setTableContent(e,data){
				//var data = e.data;
				e.tableData = new Array();
				
				
				for (var i in data){
					e.tableData.push([
						
						data[i]['station_code'],
						data[i]['name'],
						data[i]['lat'],
						data[i]['lng'],
						data[i]['height'],
						data[i]['agency'],
						data[i]['install']
					]);
					
				}
				e.table.rows.add(e.tableData);
				//e.table.
			}
			this.detectbound = function(){
				
				var bound = this.map.getBounds();
				var west	= bound.getWest();
				var south	= bound.getSouth();
				var east	= bound.getEast();
				var north	= bound.getNorth();
				var showData=[];
				var data = this.data;
				for (var i in data){

			
					if (data[i]['lat'] < north && data[i]['lat'] > south && data[i]['lon'] > west && data[i]['lon'] <east){
					
						showData.push(data[i]);
					}
				}
				_setTable(this,showData);
				
			}
		}
		
		
	</script>
</html>
